    {
      "id": "win-cob",
      "source": "yard",
      "target": "doubt",
      "type": "smoothstep",
      "label": "Win cob",
      "data": {
        "condition": "The player pushes past Cob's hostility to get him to trust them or tell what he knows, with an appeal or an argument, where it could go either way. (Not just asking him a question. Food or coin offered as the price of it gets boasts and bargaining, not this. A promise that truly answers what he's afraid of, his name kept out of it and the men from the loft kept off him, needs no dice: that's not this either.)",
        "phase": "outcome",
        "skill": "persuasion",
        "dc": 13
      }
    },
    {
      "id": "promise-cob",
      "source": "yard",
      "target": "doubt",
      "type": "smoothstep",
      "label": "Promise cob",
      "data": {
        "condition": "The player makes Cob a promise that truly answers what he's afraid of, and means it (his name kept out of it, with nothing to the watch and nothing in anybody's book; the men from the loft kept off him; no Mending House; the boots his to keep), or asks him what he knows under a promise like that made before. No dice, whatever they ask with it: he believes it, near enough. He checks Moll can't hear, then tells it in a frightened rush: he sleeps in the loft, and last night he woke to a lantern and voices, Mister Prout arguing with two men; then a thump, a choking noise and the hoist creaking with no sacks on it. He hid in his sacks till morning. Asked for a look in his boot as well, he holds the left one out himself.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "killed-not-suicide"
        ]
      }
    },
    {
      "id": "catch-moll",
      "source": "yard",
      "target": "doubt",
      "type": "smoothstep",
      "label": "Catch moll",
      "data": {
        "condition": "The player presses on the holes in Moll's 'I saw him jump' story, or tries to read whether she's lying, where it could go either way. (Not just asking her to tell it.)",
        "phase": "outcome",
        "skill": "insight",
        "dc": 13
      }
    },
    {
      "id": "scare-kids",
      "source": "yard",
      "target": "doubt",
      "type": "smoothstep",
      "label": "Scare kids",
      "data": {
        "condition": "The player tries to frighten the kids into talking: threats, looming, the watch, the Mending House or Cob's father.",
        "phase": "outcome",
        "skill": "intimidation",
        "dc": 12
      }
    },
    {
      "id": "bribe-cob",
      "source": "yard",
      "target": "yard",
      "type": "smoothstep",
      "label": "Bribe cob",
      "data": {
        "condition": "The player offers Cob something as the price of a look in his boot, or at what's crackling in it (a coin held up, food, a trade: 'this is yours if I can see what's in there', 'a shilling for a look'), however politely it's asked and whatever they say about the boots staying his, and nothing that answers what he's afraid of. No dice: Cob haggles, boasts, ups the price and takes anything going, but the boot stays on. Bought attention isn't trust, and grown-ups who pay to look at his boots want them off him (the watch, his da, the pawnshop): what's really wrong comes out instead, his way. They're Cob's, and nobody's having them. (Food with nothing asked back is a kindness, not this.)",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "kind-to-cob",
      "source": "yard",
      "target": "yard",
      "type": "smoothstep",
      "label": "Kind to cob",
      "data": {
        "condition": "The player does Cob a kindness with nothing asked back: something to eat, or a dinner stood him freely, with no look at his boots (or anything else) as the price. He takes it with bad grace and a boast, and it counts with him: after it, a polite ask for a look in his boot, the boots staying his, gets a yes.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "cob-kindness"
        ]
      }
    },
    {
      "id": "coax-cob",
      "source": "yard",
      "target": "motive",
      "type": "smoothstep",
      "label": "Coax cob",
      "data": {
        "condition": "Before Cob has any reason to trust them (no kindness with nothing asked back done him yet, no promise that answers what he's afraid of, no yes from him already) and with nothing offered for it, the player asks Cob to let them look in his left boot, or see or feel what's crackling in it, with the boots staying his (it's what's in them they're after, not the boots), or tries to win him round to it (Mister Prout, the men from the loft, his own skin), where it could go either way. Not with anything offered for the look (a coin, food, a trade): that's a bribe, and gets haggling. Not after a kindness, with a promise that answers his fear, or once he's said they can look: then the ask needs no dice.",
        "phase": "outcome",
        "skill": "persuasion",
        "dc": 12,
        "establishes": [
          "page-read"
        ]
      }
    },
    {
      "id": "trust-cob",
      "source": "yard",
      "target": "motive",
      "type": "smoothstep",
      "label": "Trust cob",
      "data": {
        "condition": "The player asks Cob for a look in his left boot (or a peek at what's crackling in it), the boots staying his, once he has real reason to trust them: they did him a kindness with nothing asked back earlier (something to eat, a dinner stood him freely), or they make him a promise, now or before, that truly answers what he's afraid of (his name kept out of it, with nothing to the watch and nothing in anybody's book; the men from the loft kept off him; no Mending House; the boots his to keep), or he has already told them they can look. No dice, however it's put: he unlaces the left boot, holds it out at arm's length and lets them pick the lining open: Prout's page is out.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "page-read"
        ]
      }
    },
