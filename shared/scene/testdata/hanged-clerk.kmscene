    {
      "id": "case-made",
      "type": "story",
      "position": {
        "x": 800,
        "y": 60
      },
      "data": {
        "kind": "exit",
        "title": "The case is made",
        "description": "Kell writes Prout's death down as murder, made to look like a suicide, with the man calling himself Master Sallow of the Royal Purveyor's office behind it. The player has a case, and whatever proof they found here, to take to the King.",
        "closing": "Kell underlines something twice, closes her notebook and says something dry that is very nearly thanks. Prout goes to the watch house as a murder; she wants the player to carry the case to the King, since the Captain files what the Purveyor's office asks him to file. Let the kids react to how the player treated them.",
        "result": "good",
        "exitKind": "progress",
        "next": "caerwyn-afternoon",
        "effects": [
          {
            "op": "quest",
            "quest": "hanged-clerk",
            "do": "complete",
            "text": "Proved Wendell Prout was murdered, and named Sallow of the Royal Purveyor's office as behind it."
          },
          {
            "op": "quest",
            "quest": "purveyors-man",
            "do": "start",
            "title": "The Purveyor's Man",
            "text": "A man calling himself Master Sallow, of the Royal Purveyor's office, had the palace clerk Wendell Prout killed and hung up as a suicide. The case needs taking to the King, not the Watch Captain."
          },
          {
            "op": "attitude",
            "who": "kell",
            "to": "friendly",
            "text": "The King's investigator made Prout's case properly."
          },
          {
            "op": "remember",
            "who": "kell",
            "text": "The King's investigator proved Prout was murdered and named Sallow of the Purveyor's office."
          },
          {
            "op": "give",
            "what": "ledger-page",
            "to": "$player",
            "if": {
              "established": "page-read"
            }
          },
          {
            "op": "flag",
