{
  "format": "kingmaker",
  "version": 2,
  "kind": "scene",
  "id": "toll",
  "title": "The Crakes' toll",
  "description": "The zoo's fight in the conversation (docs/combat-gm.md): the Crake brothers have the ring's gate and want a shilling each to let you out. Pay, talk them down, or fight: if it comes to blows the GM rolls for initiative and narrates every turn, the dice deciding what lands.",
  "lore": [],
  "place": "toll",
  "time": "afternoon",
  "hook": "The ring's gate, and the two very large men standing in it.",
  "setting": "The combat ring after hours: raked sand inside a low stone wall, two squat pillars, and an iron brazier ticking as it cools. The only way out is the timber gate in the south wall, and the Crake brothers are leaning on it with their cudgels, the talking one jingling a tin cup. Sergeant Kell is beside you, her coat off and her truncheon still in her belt.",
  "premise": "Will the player and Kell get out through the gate, and what will it cost them: a shilling, some words, or a fight?",
  "truth": "Nobody hired the Crakes for this: they're freelancing, having noticed that people who come into the ring have to leave by the gate. They want coin, not a fight, and will take a shilling each, haggle down to a shilling for the pair, back off from a real threat, and fight only if someone swings first or makes a fool of the talking one in front of his brother. In a fight they come in together on whoever hit them; once one of them is down, the other gives up.",
  "limits": [
    "Another way out: the wall is too high and there's only the gate.",
    "Anyone else coming: it's after hours, and the ring is empty but for the four of them.",
    "Anyone dying: nobody dies in the zoo; down is down, out cold."
  ],
  "known": [
    "The Crake brothers are hired muscle off the river: big, slow to start and very hard to stop."
  ],
  "cast": [
    {
      "id": "kell",
      "name": "Sergeant Agnes Kell",
      "look": "Forties, in her watch uniform with the coat off, her truncheon in her belt and her notebook buttoned into her pocket.",
      "voice": "Dry, calm and sparing: 'That's not a toll. That's a robbery with a cup.'",
      "wants": "To get out through the gate with the investigator, by the book: no paying off thugs if she can help it, and an arrest if they swing.",
      "whyHere": "She came into the ring with the investigator and is leaving with them.",
      "knows": [
        "Demanding money at a gate is extortion, and she'd arrest them for it if there were a cell nearer than the river."
      ],
      "attitude": "Unimpressed and patient. She leaves the talking to the investigator, says one dry thing, and if it comes to blows she fights beside them: she takes whoever's nearest them, keeps between them and the worst of it, and arrests whoever gives up, out loud and by the book. She never hits anyone who's down or yielding.",
      "limits": "She won't pay them herself and won't start the fight; she never runs while the investigator is still in it.",
      "statblock": "guard",
      "weapon": "club"
    },
    {
      "id": "crake-1",
      "name": "the talking Crake",
      "called": "the big man with the tin cup",
      "look": "An enormous river-bruiser in a reefer jacket, with a cudgel under one arm and a tin cup in the other hand, which he jingles.",
      "voice": "Cheerful, reasonable and relentless, all about rates: 'Shilling a head to use the gate. Uniforms is extra, but we'll waive it, seeing as it's you.'",
      "wants": "A shilling each, or a shilling for the pair if he's haggled, and no trouble; and not to look a fool in front of his brother.",
      "whyHere": "He and his brother noticed that people who come into the ring have to leave by the gate.",
      "knows": [
        "Nobody's paying them for this; it's their own idea, and he's proud of it.",
        "His brother will follow him in, whatever he does."
      ],
      "attitude": "Friendly extortion. He'll haggle, take a shilling and step aside, and back down from a real threat (a blade out, a spell ready, a sergeant's warrant) if he can do it without losing face. Mocked in front of his brother, or hit, he fights: he closes in and hits whoever hit him, talking the whole time. Once his brother's down he gives up.",
      "limits": "He won't hurt a child or kick a dog. He never fights on alone once his brother is down.",
      "statblock": "bandit",
      "weapon": "club"
    },
    {
      "id": "crake-2",
      "name": "the silent Crake",
      "called": "the other big man",
      "look": "His identical brother, with an identical cudgel, leaning on the gate post and saying nothing at all.",
      "voice": "Says nothing. Nods at his brother, occasionally; cracks his knuckles, once.",
      "wants": "Whatever his brother wants.",
      "whyHere": "His brother brought him.",
      "knows": [
        "Nothing he's prepared to share."
      ],
      "attitude": "He does what his brother does: steps aside when his brother does, and in a fight comes in beside him on the same target. Once his brother's down he gives up.",
      "limits": "He never says a word and never fights on alone.",
      "statblock": "bandit",
      "weapon": "club"
    }
  ],
