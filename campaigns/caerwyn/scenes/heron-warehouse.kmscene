    {
      "id": "caught",
      "type": "story",
      "position": {
        "x": 1400,
        "y": 360
      },
      "data": {
        "kind": "exit",
        "title": "The wharves are dangerous at night",
        "description": "The player was caught at the Heron and has been thrown in the river or locked up in the warehouse by the Master's people, and the night's work goes on without them. They're alive, and they keep what they saw, and anything the Crakes didn't find on them. Sallow believes he's rid of them.",
        "closing": "Close on the cold: the black river closing over their head and the wharf lights sliding away, or a bolted door, grain dust settling and the sound of hatches going on. Leave them one thread to pull another night: something seen, something held, something overheard.",
        "result": "mixed",
        "exitKind": "other",
        "next": "kings-morning",
        "effects": [
          {
            "op": "attitude",
            "who": "sallow",
            "to": "hostile",
            "text": "The King's investigator got into the Heron and saw too much."
          },
