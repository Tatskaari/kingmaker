          {
            "op": "remember",
            "who": "kell",
            "text": "The Heron went up in smoke (or its barge went down) on the eve of the Assembly, with the investigator in the middle of it. She'll have to write it up."
          },
          {
            "op": "remember",
            "who": "kell",
            "text": "At the Heron she saw Master Sallow take the King's grain with her own eyes: initial the night's page in the true book and count his share. It's in her notebook, sworn.",
            "if": {
              "established": "kell-saw"
            }
          },
          {
            "op": "quest",
            "quest": "heron-ledger",
            "do": "advance",
            "stage": "up_in_smoke",
            "text": "The Heron's grain is gone, but the true book came out with us.",
            "if": {
              "established": "book-in-hand"
            },
            "unless": {
