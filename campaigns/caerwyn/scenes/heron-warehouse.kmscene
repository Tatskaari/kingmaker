    {
      "id": "up-in-smoke",
      "type": "story",
      "position": {
        "x": 1400,
        "y": 900
      },
      "data": {
        "kind": "exit",
        "title": "Up in smoke",
        "description": "The Heron is burning (grain dust goes up like gunpowder) or the barge has gone down with the King's grain in her. Whatever the player didn't carry out is gone, the whole waterfront is awake, and on the eve of the Assembly somebody is going to have to explain it.",
        "closing": "Close on the spectacle, played absolutely straight: the light on the water, the bells, bargees swearing in Saltmere, Saul hauling Duchess clear, the Master's lavender lost in the smoke. Kell, soot on her notebook, says what she'll have to write.",
        "result": "bad",
        "exitKind": "other",
        "next": "kings-morning",
        "effects": [
          {
            "op": "create",
            "name": "Plume of smoke",
            "kind": "feature",
            "to": "floor",
            "if": {
              "established": "heron-ablaze"
            }
          },
          {
            "op": "note",
            "what": "floor",
            "text": "The Heron warehouse burned down on the eve of the Assembly, with the King's grain in it.",
            "if": {
              "established": "heron-ablaze"
            }
          },
          {
            "op": "note",
            "what": "barge",
            "text": "The Saltmere barge Patience sank at the Heron's wharf with the King's grain in her.",
            "if": {
              "established": "barge-sunk"
            }
          },
          {
            "op": "give",
            "what": "true-book",
            "to": "$player",
            "if": {
              "established": "book-in-hand"
            },
            "unless": {
              "established": "book-gone"
            }
          },
          {
