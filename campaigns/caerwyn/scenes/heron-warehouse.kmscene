  "edges": [
    {
      "id": "find-kings-grain",
      "source": "wharf",
      "target": "kings-grain",
      "type": "smoothstep",
      "label": "The King's grain",
      "data": {
        "condition": "",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "find-master-due",
      "source": "wharf",
      "target": "master-due",
      "type": "smoothstep",
      "label": "The Master's due",
      "data": {
        "condition": "",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "took-the-book",
      "source": "wharf",
      "target": "true-book",
      "type": "smoothstep",
      "label": "The book in hand",
      "data": {
        "condition": "The player has the true book in their own hands: lifted from under Scrope's hand, given up by him, handed over by the Master to admire, snatched, or any other way.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "book-in-hand"
        ]
      }
    },
    {
      "id": "found-the-proof",
      "source": "wharf",
      "target": "true-book",
      "type": "smoothstep",
      "label": "The proof",
      "data": {
        "condition": "The proof has landed some other way, without the book in the player's hands: they've read it or had it explained to them page by page; Scrope, Hep and her gang, or Hobb will swear for the Crown (Hobb by owning the loft to the Master's face); or the Master has given himself away in Kell's hearing.",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "kell-saw-him",
      "source": "midnight",
      "target": "true-book",
      "type": "smoothstep",
      "label": "Seen by a sergeant",
      "data": {
        "condition": "Kell has seen with her own eyes the Master take the King's grain (initial tonight's page, count his share into his purse, give his orders over the wheat-ear sacks) and can swear to it.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "kell-saw"
        ]
      }
    },
    {
      "id": "taken-on",
      "source": "wharf",
      "target": "floor",
      "type": "smoothstep",
      "label": "In as a hand",
      "data": {
        "condition": "The player has gone in to work at the river door: shown a brass heron token at the grille, shouldered a sack and walked in with the gang, answered Hep's shout for hands, asked to be taken on for the night, or knocked for Hobb if he agreed at the Rat to let them in. No dice: Hep is short-handed on the Assembly eve and anyone with a sack on their shoulder is crew, so she puts them to work and asks who they are afterwards, if ever. A story told with it isn't a bluff to roll for.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "in-as-a-hand"
        ]
      }
    },
    {
      "id": "sneak-in",
      "source": "wharf",
      "target": "floor",
      "type": "smoothstep",
      "label": "Slip in unseen",
      "data": {
        "condition": "The player tries to slip into the Heron unseen: past Saul's deaf side and the sleeping dog, or in at the river door while the gang's backs are turned. (Walking in with a sack on their shoulder is going in to work, with no dice.) Failing, something gives them away (a creaking plank, a dog that wasn't asleep, a porter looking round at the wrong moment) and the alarm goes up: not caught yet, but the wharf is looking for them.",
        "phase": "outcome",
        "skill": "stealth",
        "dc": 13
      }
    },
    {
      "id": "talk-past",
      "source": "wharf",
      "target": "floor",
      "type": "smoothstep",
      "label": "Talk their way in",
      "data": {
        "condition": "With no token to show, the player tries to bluff their way in past Saul or whoever answers the river door, with a story that isn't true: the Saltmere factor's man, someone sent by the Master, a hand somebody sent for. (The token at the grille, or going in to work with a sack, are ways in of their own with no dice, whatever story goes with them.) Failing, the door stays shut and whoever was at it watches the wharf for them: the next way in will have to be a different one.",
        "phase": "outcome",
        "skill": "deception",
        "dc": 13
      }
    },
    {
      "id": "river-way",
      "source": "wharf",
      "target": "floor",
      "type": "smoothstep",
      "label": "The river side",
      "data": {
        "condition": "The player tries to get in from the river side the hard way: along the piles under the floor, up the hoist rope, or across the barge and in through the loading door. Failing, a slimed pile or a swinging hoist puts them in the river to the chest, clinging to a pile under the floor, unseen for now, with Duchess barking overhead.",
        "phase": "outcome",
        "skill": "athletics",
        "dc": 14
      }
    },
    {
      "id": "inside",
      "source": "wharf",
      "target": "floor",
      "type": "smoothstep",
      "label": "Inside",
      "data": {
        "condition": "The player is inside the Heron, unnoticed or taken for someone who belongs there, some other way established in play (let in at the land door's wicket by Saul, say).",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "master-comes",
      "source": "wharf",
      "target": "midnight",
      "type": "smoothstep",
      "label": "The midnight bell",
      "data": {
        "condition": "The midnight bell: lavender on the air a minute before him, then the Master in at the land door. Bring it on once the player has had their chances before it (got in or tried to, looked about, had a word with Saul, Hep, Scrope or Hobb, a go at the book), or is waiting on the wharf or in hiding to see who comes, or has been caught and is being held for the Master. A player working the floor with their head down while they wait for a word, a look at the book or a chance at it isn't waiting for the Master: the floor gets its exchanges first. The bell is the outer limit: after a good while on the wharf without getting in (six exchanges or so), or a good while inside (five or so), he comes, whatever has happened.",
        "phase": "cue",
        "skill": "",
        "dc": 12,
        "limit": [
          {
            "exchanges": 6,
            "until": [
              "floor"
            ]
          },
          {
            "exchanges": 5,
            "after": "floor"
          }
        ]
      }
    },
    {
      "id": "book-destroyed",
      "source": "midnight",
      "target": "book-burns",
      "type": "smoothstep",
      "label": "Into the fire",
      "data": {
        "condition": "The true book has been destroyed: put into the brazier and burned, or gone over the side into the river, and nobody saved it.",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "away-with-book",
      "source": "wharf",
      "target": "proof-taken",
      "type": "smoothstep",
      "label": "Out with the book",
      "data": {
        "condition": "The player leaves the Heron with the true book in their hands (out of a door, off the wharf, or over the side into the dark) and nobody is holding them.",
        "phase": "outcome",
        "requires": [
          "true-book"
        ],
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "in-the-act",
      "source": "midnight",
      "target": "caught-in-the-act",
      "type": "smoothstep",
      "label": "Arrested",
      "data": {
        "condition": "Sallow has been caught at the loading of the King's grain before witnesses who will swear to it (Kell, Hep's gang, Scrope, Hobb or the player), Kell has arrested him, and he is actually held: he has given himself up (the cane handed over, his hands up), been beaten or overpowered, or surrendered after a fight, and his Crakes have stood down or been dealt with. The words of arrest alone, with Sallow defiant and his Crakes still beside him, aren't this: that is the moment he draws.",
        "phase": "outcome",
        "requires": [
          "kings-grain",
          "true-book"
        ],
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "overpowered",
      "source": "midnight",
      "target": "caught",
      "type": "smoothstep",
      "label": "Caught",
      "data": {
        "condition": "The player has been overpowered and thrown in the river, or shut up somewhere in the Heron, by the Crakes or the gang on the Master's word, and nobody has got them out.",
        "phase": "outcome",
        "requires": [
          "kings-grain"
        ],
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "cornered",
      "source": "midnight",
      "target": "fight",
      "type": "smoothstep",
      "label": "Blades out",
      "data": {
        "condition": "Sallow, exposed with proof in front of witnesses he can't buy, has drawn the sword from his cane and set the Crakes on the player: blades are out and the fight has started.",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "attack",
      "source": "midnight",
      "target": "fight",
      "type": "smoothstep",
      "label": "Attack",
      "data": {
        "condition": "With the Master here, the player attacks him, the Crakes or anyone on the floor, meaning to hurt them now: a real fight, not a shove to get past someone.",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "cast-off",
      "source": "midnight",
      "target": "barge-sails",
      "type": "smoothstep",
      "label": "The second bell",
      "data": {
        "condition": "The second bell: the last sacks go down, the hatches go on, and the Patience casts off on the ebb with the King's grain aboard. Bring it on once the Master has been here a good while (six exchanges or so), or the player is hiding or dithering with nothing in hand and nothing they're waiting for. A player waiting for a moment they've named (the Master at the book to initial the page, a chance at the book, the moment to signal Kell) isn't dithering: that moment comes first. A player with the true book in hand and nobody holding them is leaving with it: that's 'Out with the true book', not this. The outer limit: eight exchanges after the Master comes in, the second bell rings, whatever is happening.",
        "phase": "cue",
        "skill": "",
        "dc": 12,
        "limit": [
          {
            "exchanges": 8,
            "after": "midnight"
          }
        ]
      }
    },
    {
      "id": "give-up",
      "source": "wharf",
      "target": "barge-sails",
      "type": "smoothstep",
      "label": "Gave up",
      "data": {
        "condition": "The player gives up and leaves the wharf without the proof, leaving the Heron to its night's work.",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "ablaze",
      "source": "wharf",
      "target": "up-in-smoke",
      "type": "smoothstep",
      "label": "Fire",
      "data": {
        "condition": "Fire has taken hold of the Heron: a naked light in the grain dust, a brazier knocked over, a diversion got out of hand.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "heron-ablaze"
        ]
      }
    },
    {
      "id": "sunk",
      "source": "wharf",
      "target": "up-in-smoke",
      "type": "smoothstep",
      "label": "Sunk",
      "data": {
        "condition": "The barge is going down with the King's grain in her: holed, swamped, or cut loose and swept onto the piers.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "barge-sunk"
        ]
      }
    }
  ]
}
