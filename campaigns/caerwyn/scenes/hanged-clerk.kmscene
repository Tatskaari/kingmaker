    {
      "id": "failed",
      "type": "story",
      "position": {
        "x": 1200,
        "y": 480
      },
      "data": {
        "kind": "exit",
        "title": "Failed",
        "description": "The player failed to establish anything suspicious about the death, or abandoned the case, or went so far off the rails (crimes, an innocent child arrested) that it's over. Prout goes in the pit as a suicide, there are no leads, and the investigation is doomed. This is the end of the story.",
        "closing": "Kell watches the dead-cart go and closes her notebook on one word. Land on the player, alone with what they did or didn't do; don't narrate beyond it.",
        "result": "bad",
        "exitKind": "other",
        "effects": [
          {
            "op": "quest",
            "quest": "hanged-clerk",
            "do": "fail",
            "text": "Prout went in the pit as a suicide, and nobody will look for whoever killed him."
          },
          {
            "op": "attitude",
            "who": "kell",
            "to": "wary",
            "text": "The King's investigator let Prout go down as a suicide."
          },
          {
            "op": "flag",
