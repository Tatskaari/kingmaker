      "label": "Who he calls Master",
      "data": {
        "condition": "The name has landed some other way than Hobb giving it himself: his face at the name, Nan's quart, Kell's noon sighting and the name on the delivery notices, Cob's Silvertop, or Prout's page. (Hobb whispering it himself is [he-names-him].)",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "he-names-him",
      "source": "hobb-talking",
