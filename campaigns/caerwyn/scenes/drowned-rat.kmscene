      "label": "He names him",
      "data": {
        "condition": "Asked straight for his master's name, Hobb has given it himself, in a whisper with a look at the door: Master Sallow of the Royal Purveyor's office.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "master-named"
        ]
      }
    },
