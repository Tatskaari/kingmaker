      "source": "start",
      "target": "taken-in",
      "type": "smoothstep",
      "label": "Taken in",
      "data": {
        "condition": "Kell has arrested Big Hobb, because the investigator wants it, on evidence she accepts (his own admission, or a witness and the wound that matches): she tests it once ('On what evidence?'), and takes him up the river stairs to the watch-house cells by the book, outside Nan's door.",
        "phase": "outcome",
