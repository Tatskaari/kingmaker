      "source": "way-out",
      "target": "hobb-talks",
      "type": "smoothstep",
      "label": "Their man inside",
      "data": {
        "condition": "Hobb, who has told it, has agreed to be their man inside the Heron tonight (to open the river door to their knock, keep the gang off them, point out the clerk with the book) and goes to his night's work for them, and the player is done at the Rat. It needs no dice once his mum is to be kept safe tonight, or for a promise that truly answers his fear; while his fear could still win, talking him into it is a roll (Persuasion DC 14), and failing it he'll go to work and keep his head down.",
        "phase": "outcome",
        "requires": [
          "hobb-talking",
          "the-master",
          "the-heron"
        ],
        "skill": "",
        "dc": 12,
        "establishes": [
          "hobb-inside"
        ]
      }
    },
    {
