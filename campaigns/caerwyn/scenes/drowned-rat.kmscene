    {
      "id": "last-word",
      "source": "eleventh-bell",
      "target": "hobb-talking",
      "type": "smoothstep",
      "label": "One last appeal",
      "data": {
        "condition": "Hobb is going to his night's work (not bolting), and the player makes one last real appeal at the door to stop him and get him to tell, where it could go either way. (Something that truly answers his fear needs no dice: that's [hobb-breaks].) Success: he stops with his hand on the door, his shoulders go down, and he comes back to the corner and says, 'I only held the rope.' Failure: he says he's sorry, and why, and goes.",
        "phase": "outcome",
        "skill": "persuasion",
        "dc": 14
      }
    },
