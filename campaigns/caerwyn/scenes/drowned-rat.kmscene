    {
      "id": "hobb-fled",
      "type": "story",
      "position": {
        "x": 1300,
        "y": 660
      },
      "data": {
        "kind": "exit",
        "title": "Hobb runs",
        "description": "Big Hobb has run from the Rat and got away into the dark. Frightened out of his wits, he's gone where his feet always take him: to his master, to warn him that the King's investigator and a watch sergeant are asking about the loft. The player still has the way to the Heron, where the grain goes. Whatever Hobb told them before he ran, they have, and whatever he owned to is in Kell's notebook as he said it.",
        "closing": "Close on the empty doorway, the wet stairs and the dark; the Rat's silence, and Nan's look, which says whose fault that was.",
        "result": "mixed",
        "exitKind": "other",
        "next": "wharf-night",
        "effects": [
          {
            "op": "remove",
            "what": "hobb",
            "text": "ran off up the river stairs into the city, to warn his master"
          },
          {
            "op": "attitude",
            "who": "hobb",
            "to": "unfriendly",
            "text": "The King's investigator frightened him out of the Drowned Rat."
          },
          {
            "op": "remember",
            "who": "hobb",
            "text": "He ran from the Drowned Rat to warn Master Sallow that the King's investigator and a watch sergeant are asking about the loft."
          },
          {
            "op": "flag",
            "name": "hobb_identified",
            "value": "true"
          },
          {
            "op": "flag",
            "name": "sallow_warned",
            "value": "true"
          },
          {
            "op": "flag",
            "name": "heron_known",
            "value": "true"
          },
          {
            "op": "quest",
            "quest": "heron-ledger",
            "do": "start",
            "title": "The Heron Ledger",
            "text": "Big Hobb Mallory works nights for a gentleman at the Heron warehouse, at the downriver end of the wharves. If the King's 'lost' grain goes anywhere, it goes through there."
          },
          {
            "op": "quest",
            "quest": "purveyors-man",
            "do": "advance",
            "stage": "hobb_fled",
            "text": "Big Hobb Mallory, the big man from the loft, works for Master Sallow of the Royal Purveyor's office, and he's run to him.",
            "if": {
              "established": "master-known"
            }
          },
          {
            "op": "journal",
            "text": "Big Hobb ran from the Drowned Rat, and he'll have gone straight to his master."
          }
        ],
        "lore": []
      }
    },
    {
      "id": "thrown-out",
      "type": "story",
      "position": {
        "x": 1300,
        "y": 880
      },
      "data": {
        "kind": "exit",
        "title": "Manners",
        "description": "Nan Quill has thrown the player (and anyone who sided with them) out of the Drowned Rat with Manners, and barred them. What they learned inside is all they have, and it includes the way to the Heron. Hobb is still inside, and will go to his night's work at the Heron at the bell.",
        "closing": "Close on the wet river stairs outside the barred door, the din starting up again inside, and whatever the player is nursing (an ear, a shin, their pride). If Kell is out there with them, she says something dry about doors.",
        "result": "mixed",
        "exitKind": "other",
        "next": "wharf-night",
        "effects": [
          {
            "op": "attitude",
            "who": "nan-quill",
            "to": "unfriendly",
            "text": "Broke the house rules in the Drowned Rat."
          },
