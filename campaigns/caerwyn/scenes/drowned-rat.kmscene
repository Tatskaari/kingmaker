      }
    },
    {
      "id": "arlo-calls-him-out",
      "source": "start",
      "target": "arlos-challenge",
      "type": "smoothstep",
      "label": "Arlo's third challenge",
      "data": {
        "condition": "Arlo's third challenge of the night: once the newcomers have been in the room three or four exchanges, or as soon as the player sits down with Hobb or asks about him out loud, or the room has stalled with nothing the player is pursuing. Not once Hobb is talking or gone. Outer limit: by the sixth exchange in the room, Arlo makes his move.",
        "phase": "cue",
        "skill": "",
        "dc": 12,
        "limit": [
          {
            "exchanges": 6,
            "until": [
              "hobb-talking",
              "hobb-bolts"
            ]
          }
        ]
      }
    },
    {
      "id": "hobb-breaks",
      "source": "start",
      "target": "hobb-talking",
      "type": "smoothstep",
      "label": "He breaks",
      "data": {
        "condition": "Hobb has broken and begun to tell what he did, the loft first, however it came out: something that truly answered his fear (his mum kept safe, a way out of the noose he believes, a kindness he couldn't stand up to), or an appeal, a fright or a lie that worked on a roll (the loft's paths say which roll suits which), or something put in front of him he can't deny.",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "mum-made-safe",
      "source": "way-out",
      "target": "hobb-talking",
      "type": "smoothstep",
      "label": "His mum made safe",
      "data": {
        "condition": "Someone here has agreed to take Hobb's mum in tonight, out of the Master's reach (Kell, one night in her own room; Dilly, the cabin aft on the Dabchick; Nan, the widow on the landing), someone will fetch her from the Shambles before the Master thinks to look, and Hobb has heard it: his shoulders come down, and it starts, very quietly: 'I only held the rope.' Asking one of them where it could go either way is a roll (Persuasion DC 12); a no is heard too, and puts him nearer the door, but the others haven't been asked. Offered of their own accord, or for a reason plainly good for him, it needs no dice.",
        "phase": "outcome",
        "skill": "",
        "dc": 12,
        "establishes": [
          "mum-safe"
        ]
      }
    },
    {
      "id": "hobb-runs",
      "source": "start",
      "target": "hobb-bolts",
      "type": "smoothstep",
      "label": "He bolts",
      "data": {
        "condition": "Hobb is up and bolting for the door in a panic: someone pushed him too hard or too clumsily (a fright or a lie that failed, 'arrest' or the noose spoken before anything answered his fear, his hand or the loft shouted across the room), or his nerve has gone mid-confession at the thought of his master.",
        "phase": "outcome",
        "skill": "",
        "dc": 12
      }
    },
    {
      "id": "catch-him",
      "source": "hobb-bolts",
      "target": "hobb-talking",
      "type": "smoothstep",
      "label": "Caught on the stairs",
      "data": {
        "condition": "Hobb is bolting, and the player goes after him to stop him: a tackle on the wet steps, a grab at his coat, a sprint to cut him off. Success: they bring him down or pin him to the river wall; he doesn't fight, and it starts coming out of him, the loft first. Failure: he's faster than he looks and more frightened than they are, up the stairs and into the dark.",
        "phase": "outcome",
        "skill": "athletics",
        "dc": 13
      }
    },
    {
      "id": "bell-rings",
      "source": "start",
      "target": "eleventh-bell",
      "type": "smoothstep",
      "label": "The eleventh bell",
      "data": {
        "condition": "The eleventh bell rings across the water and the night shift goes down the stairs: once the player has had their chances at Hobb and the room and has what they're going to get, or the scene has stalled with nothing the player is pursuing, or Hobb has been talking four or five exchanges with nothing decided about what becomes of him. Before it rings, it's felt coming (the night men drinking up, the tenth bell across the water, Hobb counting his last pennies). Outer limit: about eight exchanges after Arlo's challenge, or fifteen into the scene: it rings then, whatever is happening. Not needed once Hobb has fled.",
        "phase": "cue",
        "skill": "",
        "dc": 12,
        "limit": [
          {
            "exchanges": 15
          },
          {
            "exchanges": 8,
            "after": "arlos-challenge"
          }
        ]
      }
