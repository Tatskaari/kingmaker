  "nodes": [
    {
      "id": "start",
      "type": "story",
      "position": {
        "x": 0,
        "y": 260
      },
      "data": {
        "kind": "start",
        "title": "Smoke at the toll bridge",
        "description": "This is the prologue's big fight, in two halves with a breath between, and then the road to the King. Open on the player coming up the road out of the dusk into the noise: the toll pole burning like a torch, the hay wain dragged across the road at the bridge foot, two palace guards behind it (one with an arrow in her shoulder), goblins round the toll-house corner with their backs to the road, a drum, a bow, and Garrow shouting through his shutters about the King's penny. The goblins haven't seen the player yet. End the opening on the moment before it starts: the player's first act starts the fight.",
        "cast": {
          "haskett": "Characterise: behind the hay wain with her halberd and a snapped-off arrow in her shoulder, swearing steadily. She sees the player and bellows at them to get down or get stuck in.",
          "tob": "Characterise: behind the wain beside her, white as milk, spear up, shouting 'In the King's name!' at goblins who don't care.",
          "garrow": "Characterise: through a crack in his shutters: 'Toll's a penny a head! Nobody crosses without paying the King's penny!'",
          "rearguard": "Characterise: three goblins with their backs to the road, shooting at the wain, beating a drum and shrieking 'Be seen!'. They haven't seen the player."
        },
        "lore": []
      }
    },
    {
      "id": "rearguard-fight",
      "type": "story",
      "position": {
        "x": 400,
        "y": 260
      },
      "data": {
        "kind": "beat",
        "title": "The rearguard",
        "description": "The fight for the near bank: Wartle's rearguard against the player, with Corporal Haskett and Guardsman Wren coming out from behind the hay wain to fight beside them. Garrow stays behind his shutters. The goblins fight while they're winning and run for the bridge and their boss once two of them are down or they're hurt. It's played on the board. When it's over the scene picks up from how it went, behind the hay wain: Haskett's arm, Wren's nerves, Garrow through his shutters, the horn across the river.",
        "cast": {
          "rearguard": "They turn on the newcomer behind them, the archer shooting at whoever's in the open; two down or hurt, they run for the bridge.",
          "haskett": "Out from behind the wain with her halberd, keeping it low; she puts herself between the goblins and Wren.",
          "tob": "Beside her with his spear, shouting 'In the King's name!' and very nearly brave.",
          "garrow": "Behind his shutters, reading the regulations aloud to the goblins."
        },
        "pressure": "A horn across the river, and a howl: something is coming. Haskett gets the patrol behind the wain and her halberd up.",
        "fight": {
          "foes": [
            "rearguard",
            "rearguard-blade",
            "rearguard-bow"
          ],
          "allies": [
            "haskett",
            "tob"
          ]
        },
        "lore": []
      }
    },
    {
      "id": "the-patrol",
      "type": "story",
      "position": {
        "x": 800,
        "y": 40
      },
      "data": {
        "kind": "beat",
        "title": "The King's patrol",
        "description": "The player learns who the guards are and why they're here: the only patrol on the road, sent for the cushions at the King's own wish, and pinned an hour. It's a breather's talk, and Wren's first chance to say the King must be told.",
        "revelation": "Corporal Haskett and Guardsman Wren are the only patrol on the King's Road this week, sent out at the King's own wish to bring the Assembly's cushions in safe. The goblins shot their horses at the bridge foot an hour ago, and their war-boss is waiting across the river to finish them.",
        "paths": [
          {
            "via": "haskett",
            "clue": "'Marshal's orders, the King's wish: one patrol, the two of us, to see the cushions in. The cushions. Then their archers had our horses and we've been behind this cart an hour. The boss is over there with his dog.'",
            "earn": "No dice: once the rearguard is beaten or gone, asked anything at all.",
            "strength": "strong"
          },
          {
            "via": "tob",
            "clue": "'The King asked for us himself! Well. For the cushions. He wanted to be told of anything on the road, at once. You'll have to come and tell him, sir. Madam.'",
            "earn": "No dice: once the rearguard is gone; he can't stop talking.",
            "strength": "strong"
          },
          {
            "via": "garrow",
            "clue": "Through the shutter: two palace guards and two horses this afternoon, the horses shot at the bridge foot, all written down.",
            "earn": "No dice: asked what happened; he reads it out of his ledger.",
            "strength": "suggestive"
          }
        ],
        "establishes": [
          "patrol-known"
        ],
        "lore": []
      }
    },
    {
      "id": "garrows-ledger",
      "type": "story",
      "position": {
        "x": 800,
        "y": 200
      },
      "data": {
        "kind": "beat",
        "title": "Garrow's book",
        "description": "The player learns what Garrow's ledger says about the palace's grain wagons, and probably can't make sense of it yet: a puzzle to carry into the city with the heron pennies. Garrow doesn't know what it means either; he only knows the city says something his book says didn't happen.",
        "revelation": "Garrow writes down everything that crosses his bridge, and his book has twelve palace grain wagons crossing inward to the city, laden, this month: whatever 'lost to goblins' means, it didn't happen on his bridge.",
        "paths": [
          {
            "via": "garrow",
            "clue": "'Twelve palace wagons this month, wheat-ear canvas, laden, inwards, every one of them paid its penny. Lost to goblins! Not on my bridge they weren't. It's in the book.'",
            "earn": "No dice: asked about the goblins, the road or the wagons, or about his book (he's proud of it, and furious that the city says wagons were lost on his road); through the shutter while there's a goblin in sight, or at his door after.",
            "strength": "hook"
          },
          {
            "via": "Garrow's ledger",
            "clue": "Column after column in a crabbed hand: 'P.W., wheat-ear canvas, laden, inwards, 1d', twelve times this month, and in the margin of today, 'Goblins. 14. GRISK (they shout it).'",
            "earn": "No dice: read with his leave, which thanks or the King's green gets; he never lets go of it. Read over his shoulder against his will, it's a quick look (Sleight of Hand).",
            "strength": "hook",
            "check": {
              "skill": "sleight_of_hand",
              "dc": 12
            }
          }
        ],
        "establishes": [
          "wagons-crossed"
        ],
        "lore": []
      }
    },
    {
      "id": "war-boss",
      "type": "story",
      "position": {
        "x": 1200,
        "y": 260
      },
      "data": {
        "kind": "beat",
        "title": "Grisk comes over the bridge",
        "description": "The horn blows, the worg howls, and the war-boss Grisk comes over the bridge on his worg with a spearman at its heels, roaring that the longlegs will be seen, all right. Against the player and whoever's still on their feet beside them (Haskett, Wren). It's played on the board: the worg is as dangerous as Grisk, and the bridge has no parapet, so a shove sends someone into the river in spate, and gone. Grisk fights from the worg's back while it's winning; once the worg is down or he's badly hurt he quits ('Seen enough!') and runs for the far bank, or, cornered, throws down his scimitar and bargains (the longlegs, the pennies, the lady rider at the ford). A pair of Kläggenheim axemen may come up the road at the noise once it's been going a while. When it's over the scene picks up from how it went.",
        "cast": {
          "grisk": "Over the bridge on the worg, roaring, going for whoever stands in the road; the worg bites whatever's nearest. Badly hurt or unhorsed, he runs or bargains.",
          "haskett": "Halberd low, beside the player; if the fight goes long, her arm gives and she goes down.",
          "tob": "Beside his aunt; if she goes down he stands over her with his spear and won't be moved.",
          "garrow": "Behind his shutters, writing it down."
        },
        "pressure": "The light is almost gone: Wren wants the player away to the King before the gates shut, a step more urgently each exchange.",
        "fight": {
          "foes": [
            "grisk",
            "grisk-worg",
            "grisk-spear"
          ],
          "allies": [
            "haskett",
            "tob"
          ]
        },
        "lore": []
      }
    },
    {
      "id": "the-cart",
      "type": "story",
      "position": {
        "x": 1600,
        "y": 260
      },
      "data": {
        "kind": "beat",
        "title": "The cart comes up",
        "description": "After the war-boss's fight, Fitch's cart comes creaking up the road out of the dusk with Tansy on top, and stops at the hay wain. Tansy is off it before it stops: to the player, to the hurt corporal, or to look at the worg. Fitch takes his hat off to the King's green. Garrow unbars his door now that it's safe, and demands the King's penny from everyone, the dead goblins included. And Wren, shaking, says the King asked to be told of anything on the road, and the player must come and tell him themselves.",
        "cast": {
          "fitch": "Hat off to the soldiers; a look at the player that says he's glad they're alive, and a grumble that says the same.",
          "tansy": "Off the cart at a run, all questions; she wants to come to the King too (she can't: Fitch is taking her to their lodgings in the city).",
          "garrow": "Door unbarred at last: the King's penny, from everyone, and the regulations; thanked, he goes pink.",
          "tob": "The King must be told, by the player, tonight: he'll take them himself, on the axemen's pony if he has to.",
          "haskett": "Bandaged or bleeding, as the fight left her: orders Wren to take the player to the King and not to stammer."
        },
        "pressure": "The light's gone and the city gates shut at the ninth bell: Wren has the player on a borrowed horse and the road to the city is waiting, more urgently each exchange.",
        "lore": []
      }
    },
    {
      "id": "to-the-king",
      "type": "story",
      "position": {
        "x": 2000,
        "y": 140
      },
      "data": {
        "kind": "exit",
        "title": "Taken to the King",
        "description": "The bridge is clear (Grisk dead, fled or bargaining), the patrol is saved, the cushions are through, and Guardsman Wren is taking the player to the King: the King asked to hear of anything on the road, and Wren won't hear of them not coming.",
        "closing": "Wren leads the player over the bridge and along the dark road to the city on a borrowed horse (or riding double behind him), Haskett bandaged on the cart with Tansy fussing over her, Fitch following with the cushions. The gate opens for the King's green; up through streets hung with bunting, the lamps being lit, to the palace. End at a side door of the palace, with Wren straightening his cap.",
        "result": "good",
        "exitKind": "progress",
        "next": "kings-thanks",
        "effects": [
          {
            "op": "quest",
            "quest": "assembly-cushions",
            "do": "advance",
            "stage": "bridge",
            "text": "The goblins are off Garrow's bridge and the cushions are through. Guardsman Wren is taking you to the King, who asked to hear of anything on his road."
          },
          {
            "op": "attitude",
            "who": "tob",
            "to": "friendly",
            "text": "Saved him and his aunt from the goblins and the war-boss at the toll bridge."
          },
          {
            "op": "attitude",
            "who": "haskett",
            "to": "friendly",
            "text": "Fought beside her at the toll bridge when it counted."
          },
          {
            "op": "remember",
            "who": "tob",
            "text": "At Garrow's bridge the traveller came up behind the goblins, saved Aunt Maud and me from the rearguard and the war-boss Grisk, and I took them to the King."
          },
          {
            "op": "remember",
            "who": "haskett",
            "text": "At Garrow's bridge the traveller broke the goblins pinning us behind the hay wain and stood with us against the war-boss. My lad took them to the King."
          },
          {
            "op": "flag",
            "name": "toll_bridge",
            "value": "held"
          },
          {
            "op": "journal",
            "text": "Broke the goblins at Garrow's toll bridge with Corporal Haskett and Guardsman Wren. Wren's taking me to the King, who wants to hear of anything on his road."
          },
          {
            "op": "journal",
            "text": "Garrow's ledger: twelve palace grain wagons crossed his bridge into the city this month, laden. The city says they were lost to goblins.",
            "if": {
              "established": "wagons-crossed"
            }
          }
        ],
        "lore": []
      }
    },
    {
      "id": "carried-in",
      "type": "story",
      "position": {
        "x": 2000,
        "y": 400
      },
      "data": {
        "kind": "exit",
        "title": "Carried in",
        "description": "The fight went against the player (they went down, or the goblins had the better of it), but the war-band was driven off over the river by the axemen, the patrol or its own nerve, and Wren has the player taken to the palace anyway, slung over a horse if need be: the King must hear it.",
        "closing": "The player comes round on a horse's back, Wren walking at its head with the reins, Fitch's cart creaking behind. The city's lamps; the bunting; the palace. End at a side door of the palace, the player aching, Wren saying 'You can sit down in front of the King, he won't mind.'",
        "result": "mixed",
        "exitKind": "progress",
        "next": "kings-thanks",
        "effects": [
          {
            "op": "quest",
            "quest": "assembly-cushions",
            "do": "advance",
            "stage": "carried",
            "text": "The goblins had the better of you at Garrow's bridge, but the war-band was driven off and the cushions got through. Guardsman Wren has brought you to the King anyway."
          },
          {
            "op": "remember",
            "who": "tob",
            "text": "At Garrow's bridge the traveller came to help us against the goblins and went down fighting; I brought them to the King anyway."
          },
          {
            "op": "flag",
            "name": "toll_bridge",
            "value": "carried"
          },
          {
            "op": "journal",
            "text": "The goblins got the better of me at Garrow's toll bridge, but they were driven off. Guardsman Wren brought me to the King."
          }
        ],
        "lore": []
      }
    }
  ],
