    {
      "id": "fitch",
      "name": "Barnaby Fitch",
      "called": "the old carter",
      "aka": [
        "Fitch",
        "old Fitch"
      ],
      "lore": "Cast/Barnaby Fitch/public.md",
      "look": "A carter of seventy in a caped greatcoat and a hat like a collapsed chimney, with a white moustache that does his frowning for him and a blackthorn cudgel, driving a farm cart piled with three hundred green Assembly cushions behind an old bay mare.",
      "voice": "Gruff, slow and Nine Furrows broad, every other sentence ending on a grumble ('...and that's the truth of it'). 'Forty year I've drove this road.'",
      "wants": "The cushions over the bridge and into the palace, and Tansy safe.",
      "whyHere": "Bringing the Assembly's cushions in from the Nine Furrows; he comes up the road behind the player once the bridge is clear, as he said he would.",
      "knows": [
        "What happened at the crossroads, as it happened.",
        "The King ordered the cushions himself: the letter is in his hat."
      ],
      "attitude": "As the crossroads left him with the player (what happened there wins).",
      "limits": "Never leaves Tansy. Takes his hat off to the King's green.",
