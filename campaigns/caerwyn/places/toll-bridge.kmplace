  "id": "toll-bridge",
  "title": "Garrow's toll bridge",
  "description": "A humpbacked stone bridge over the river in spate, the only crossing for miles: Garrow's whitewashed toll house at the near end, the toll pole across the road, and the road running on beyond to Caerwyn.",
  "size": {
    "w": 105,
    "h": 60
  },
  "areas": [
    {
      "id": "toll-house",
      "name": "Garrow's toll house",
      "rect": {
        "x": 20,
        "y": 10,
        "w": 15,
        "h": 10
      },
      "description": "One whitewashed room: a stove, a high desk, the King's penny box chained to it, and Garrow behind his shutters."
    },
    {
      "id": "near-bank",
      "name": "the near bank",
      "rect": {
        "x": 0,
        "y": 0,
        "w": 45,
        "h": 60
      },
      "description": "The road up to the bridge, the toll house beside it, a ditch along the south side, and the hay wain the patrol pulled across the road for cover."
    },
    {
      "id": "bridge",
      "name": "the bridge",
      "rect": {
        "x": 45,
        "y": 25,
        "w": 25,
        "h": 10
      },
      "description": "A humpbacked stone bridge, its parapet long since gone into the river, one cart wide and slick with spray."
    },
    {
      "id": "far-bank",
      "name": "the far bank",
      "rect": {
        "x": 70,
        "y": 0,
        "w": 35,
        "h": 60
      },
      "description": "Willows, reeds and the road running on east to Caerwyn: the goblins' side of the river."
    }
  ],
