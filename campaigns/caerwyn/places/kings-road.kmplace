      ],
      "size": "huge",
      "material": "wood",
      "tags": [
        "cart",
        "container"
      ],
      "description": "A high-sided farm cart under patched sacking, piled to twice a man's height with bundles of green cushions, with Bramble the old bay mare in the shafts."
    },
    {
      "id": "cushions",
      "name": "the Assembly's cushions",
