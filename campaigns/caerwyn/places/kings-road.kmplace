{
  "format": "kingmaker",
  "version": 2,
  "kind": "place",
  "id": "kings-road",
  "title": "The crossroads on the King's Road",
  "description": "Where the drovers' track from the Nine Furrows comes down to the King's Road nine miles out of Caerwyn: frozen ruts between blackthorn hedges taller than a man, a milestone, an empty gibbet, and Fitch's cart piled with the Assembly's cushions.",
  "size": {
    "w": 115,
    "h": 50
  },
  "areas": [
    {
      "id": "road",
      "name": "the King's Road",
      "rect": {
        "x": 0,
        "y": 20,
        "w": 115,
        "h": 10
      },
      "description": "Two cart-widths of frozen ruts between the hedges, running east to Caerwyn and the toll bridge, and west to the Nine Furrows."
    },
    {
      "id": "north-field",
      "name": "the field north of the road",
      "rect": {
        "x": 0,
        "y": 0,
        "w": 115,
        "h": 20
      },
      "description": "Frosted stubble behind the north hedge, where the drovers' track comes down to the crossroads past the milestone and the gibbet."
    },
    {
      "id": "south-field",
      "name": "the field south of the road",
      "rect": {
        "x": 0,
        "y": 30,
        "w": 115,
        "h": 20
      },
      "description": "Rough pasture behind the south hedge, a ditch along it, a few bare thorn trees."
    }
  ],
  "things": [
    {
      "id": "cart",
      "name": "Fitch's cart",
      "kind": "object",
