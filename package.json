{
  "name": "kingmaker",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Kingmaker, the production build: the client, the simulation (a SpacetimeDB module) and the AI API, a vertical at a time",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p simulation",
    "test": "node --no-warnings --import tsx --test 'shared/**/*.test.ts' 'simulation/**/*.test.ts' 'ai/**/*.test.ts' 'client/**/*.test.ts' 'hosts/**/*.test.ts' 'web/**/*.test.ts' 'qa/**/*.test.ts'",
    "screens": "node --experimental-ffi --no-warnings --import tsx client/check/screens.tsx",
    "check": "npm run typecheck && npm test && npm run screens",
    "simulation:build": "spacetime --config-path runs/cli.toml build -p simulation",
    "simulation:generate": "spacetime --config-path runs/cli.toml generate --lang typescript --out-dir client/module_bindings --module-path simulation --no-config --yes",
    "ai": "node --no-warnings hosts/ai.ts",
    "dev": "node --no-warnings --import tsx hosts/dev.ts",
    "doctor": "node --no-warnings --import tsx hosts/doctor.ts",
    "campaign": "node --no-warnings --import tsx hosts/campaign.ts",
    "install-campaign": "node --no-warnings --import tsx hosts/install.ts",
    "play": "node --no-warnings --import tsx hosts/play.ts",
    "status": "node --no-warnings --import tsx hosts/status.ts",
    "e2e": "node --no-warnings --import tsx hosts/e2e.ts",
    "arc": "node --no-warnings --import tsx hosts/arc.ts",
    "live": "node --no-warnings --import tsx hosts/live-run.ts",
    "loop": "node --no-warnings --import tsx hosts/loop.ts",
    "report": "node --no-warnings --import tsx hosts/report.ts",
    "client": "node --experimental-ffi --no-warnings --import tsx hosts/client.tsx",
    "zoo": "node --experimental-ffi --no-warnings --import tsx hosts/client.tsx zoo",
    "build:web": "node --no-warnings --import tsx hosts/web/build.ts",
    "build:site": "node --no-warnings --import tsx hosts/web/build-site.ts",
    "web:serve": "node --no-warnings --import tsx hosts/web/serve.ts",
    "web:check": "node --no-warnings --import tsx hosts/web/check.ts",
    "web:screens": "node --no-warnings --import tsx hosts/web/screens.ts",
    "glyphs": "python3 tools/glyphs/build.py --install",
    "glyphs:build": "python3 tools/glyphs/build.py",
    "glyphs:uninstall": "python3 tools/glyphs/build.py --uninstall",
    "glyphs:sheet": "python3 tools/glyphs/sheet.py",
    "glyphs:vte": "python3 tools/glyphs/vte.py",
    "prepare:music-vault": "node tools/kmtune/prepare-vault.mjs",
    "export:tunes": "node --no-warnings --import tsx tools/kmtune/export.ts",
    "build:kmtune": "npm run build --prefix tools/kmtune",
    "check:kmtune": "npm run typecheck --prefix tools/kmtune && npm run test --prefix tools/kmtune"
  },
  "dependencies": {
    "@opentui/core": "0.6.5",
    "@opentui/react": "0.6.5",
    "react": "19.3.0",
    "spacetimedb": "2.12.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-reconciler": "0.33.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.62.1",
    "react-reconciler": "0.33.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yoga-layout": "3.2.1"
  },
  "allowScripts": {
    "esbuild": false
  },
  "packageManager": "npm@11.16.0"
}
