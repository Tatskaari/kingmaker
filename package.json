{
  "name": "kingmaker-v2-poc",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Kingmaker V2 PoC: GM-adjudicated scenes with improvisation, repair and world-update scripts",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "game": "node --experimental-ffi --no-warnings --import tsx src/app/main.tsx",
    "play": "node --no-warnings src/cli/scene.ts play hanged-clerk",
    "scene": "node --no-warnings src/cli/scene.ts",
    "eval": "node --no-warnings src/eval/run.ts",
    "typecheck": "tsc --noEmit -p .",
    "compare": "node --no-warnings src/eval/compare.ts",
    "qa": "node --no-warnings src/cli/qa.ts",
    "glyphs": "python3 tools/glyphs/build.py --install",
    "glyphs:build": "python3 tools/glyphs/build.py",
    "glyphs:uninstall": "python3 tools/glyphs/build.py --uninstall",
    "glyphs:sheet": "python3 tools/glyphs/sheet.py",
    "glyphs:check": "node --experimental-ffi --no-warnings --import tsx src/game/look/kingmaker-check.tsx",
    "glyphs:vte": "python3 tools/glyphs/vte.py"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@opentui/core": "^0.6.5",
    "@opentui/react": "^0.6.5",
    "boardgame.io": "^0.50.2",
    "react": "^19.3.0"
  }
}
