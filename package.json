{
  "name": "kingmaker-v2-poc",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Kingmaker V2 PoC: GM-adjudicated scenes with improvisation, repair and world-update scripts",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "game": "node --experimental-ffi --no-warnings --import tsx src/app/main.tsx",
    "web": "node --no-warnings src/web/server.ts",
    "web:check": "node --no-warnings src/web/check.ts",
    "build:web": "node --no-warnings src/web/static/build.ts",
    "web:static-check": "node --no-warnings src/web/static/check.ts",
    "web:tui-check": "node --no-warnings src/web/tui/compare/run.ts",
    "play": "node --no-warnings src/cli/scene.ts play hanged-clerk",
    "scene": "node --no-warnings src/cli/scene.ts",
    "eval": "node --no-warnings src/eval/run.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --no-warnings --test 'src/**/*.test.ts'",
    "check": "proto run moon -- run workspace:check",
    "compare": "node --no-warnings src/eval/compare.ts",
    "qa": "node --no-warnings src/cli/qa.ts",
    "glyphs": "python3 tools/glyphs/build.py --install",
    "glyphs:build": "python3 tools/glyphs/build.py",
    "glyphs:uninstall": "python3 tools/glyphs/build.py --uninstall",
    "glyphs:sheet": "python3 tools/glyphs/sheet.py",
    "glyphs:check": "node --experimental-ffi --no-warnings --import tsx src/game/look/kingmaker-check.tsx",
    "glyphs:vte": "python3 tools/glyphs/vte.py"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "^0.33.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "1.62.1",
    "react-reconciler": "^0.33.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "yoga-layout": "^3.2.1"
  },
  "dependencies": {
    "@opentui/core": "^0.6.5",
    "@opentui/react": "^0.6.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "boardgame.io": "^0.50.2",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild": false
  },
  "packageManager": "npm@11.16.0"
}
