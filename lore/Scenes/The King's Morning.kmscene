      }
    },
    "sourceFiles": {
      "scenes/kings-morning.ts": "import type { Character, Scene, Transition } from \"../src/runtime/scene.ts\";\nimport { hangedClerk, KELL_PROMISES } from \"./hanged-clerk.ts\";\nimport { dressingRoomWorld } from \"./worlds/kings-morning.ts\";\n\n/**\n * The end of the Purveyor's Man arc: the morning of the Centennial Assembly, in the King's dressing\n * room, half an hour before the procession. Every way the night can go ends here (a scene the story\n * has overtaken is skipped to it), so it's written to hold whatever happened: Sallow in a cell or\n * walking in the procession, the true book in the player's hands or burned, Hobb a witness or a\n * fugitive. It's the denouement: the King hears it, the player's promises come due, and the story\n * says what became of everyone.\n *\n * The King is the comedy and the stakes at once: warm, kind, famous for remembering how people take\n * their tea, and constitutionally unable to decide anything that might upset anyone, on the one\n * morning of his reign when everything might. He acts when he's given something he can hold and\n * someone who'll stand behind it: the true book or Prout's page, a sergeant's sworn record, or Sallow\n * giving himself away in his hearing, which the player can try for by having him sent in from the\n * gallery to explain himself. Asking alone is a roll, and a failed ask costs minutes and ground, not\n * the morning: the King puts it off for good only when he goes down to the procession, or the player\n * lets it rest.\n */\n\n/** Sallow, sent for, has given himself away in front of the King. */\nconst SLIPPED = \"In front of the King, Master Sallow has given himself away: he corrected the record on the 'lost' grain, the Heron or the count before he could stop himself, or was caught out in a lie in the King's own hearing.\";\n\nconst kell: Character = {\n  ...hangedClerk.cast.find(c => c.id === \"kell\")!,\n  look: \"Forties, in her watch uniform brushed for the palace (the borrowed coat is gone), a battered oilcloth notebook under her arm with last night in it, and the face of someone who hasn't slept and doesn't intend to mention it. Stands very still by the door and watches hands, the King's included.\",\n  wants: \"Her record signed: the right name against Wendell Prout's death, in the King's own hearing, and what was promised in her hearing kept. And to tell the King herself, before anyone else can, that Prout came to her first and she sent him to the palace: she was three days late for him once, and she means to say so, even if it takes some of the weight off her record.\",\n  fears: \"The King signing nothing. A true record going in a drawer until after the Assembly, and from there into the river.\",\n  knows: [\n    \"Everything from the granary, the Rat and the Heron is in her notebook, as it happened, including who promised what, and in whose hearing, but for a name someone was promised would be kept out of it: that witness is 'a witness' in her notebook, and in what she swears to this morning.\",\n    \"A sergeant's sworn record (what she saw and heard herself, sworn there and then, in front of anyone) is evidence anywhere in the kingdom; what she didn't see she can't swear to. It's in her notebook as it was said, and that's what she reads out when she swears: whatever anyone owned to in her hearing (an admission made in front of her is what she swears to best), the Captain's written order and whose request it names, Prout's visit to her three days before he died, and whatever she saw herself, from the granary yard to the Heron's wharf.\",\n    \"She has never been further into the palace than the gate, and has never met the King or the Marshal. The Captain says the palace doesn't read the watch's reports.\",\n  ],\n  secrets: [],\n  attitude: `As things stand between her and the investigator after the night (her memories say how). This is their report: she doesn't speak for them or over them. She answers the King's questions exactly. When the King asks who will swear to it, or for a sworn record, she gives hers on the spot: she opens her notebook and reads him the entries that bear on it, in a few plain sentences (what was owned to in her hearing first, then what she saw herself), the substance and not that she could, and nothing she didn't see or hear. Once, firmly, she says what she saw if the King doubts the investigator. She tells the King about Prout's visit, once, in her own words, at the first moment it bears on things. If the King owns up to something of his own about Prout, she says nothing about it, and writes nothing down. ${KELL_PROMISES} She holds the King to his, too.`,\n};\n\n/** Pressing the King to act: a roll only where what he's been given doesn't make it plain, and a failure that costs time, not the morning. */\nconst pressTheKing: Transition = {\n  id: \"press-the-king\", on: \"attempt\",\n  when: \"The player presses the King to act today rather than after the Assembly (to arrest or charge Sallow, to set the record straight, to keep a promise made to Hobb or the children), where it could go either way because what they've given him doesn't make it plain. (Asking for Sallow to be made to explain himself isn't this, even in the same breath as an accusation: hearing him comes first, and the King grants it at once. With the true book or Prout's page in his hands, a sergeant's sworn record that points at Sallow, Sallow giving himself away in his own hearing, or Sallow already in a cell, no dice are needed: he acts.)\",\n  check: { reason: \"to get the King to act before the procession\", skill: \"persuasion\", dc: 15,\n    success: \"The King puts his cup down, looks at the investigator for a long moment, and says, 'Yes.' Then, to the Marshal: 'Garran, see to it.'\",\n    failure: \"The King sighs and pats the investigator's arm, and reaches for 'after the Assembly' without quite getting there: he looks at the clock instead. 'On whose word, Majesty?' the Marshal asks, of nobody in particular, and calls the minutes, fewer now. Asking won't move him on its own: he wants something he can hold, and someone to stand behind it in front of him. Nothing is settled yet, but the morning is going.\",\n    onSuccess: \"justice\" },\n};\n\n/** Having Sallow in from the gallery to explain himself: a small thing, which the King grants without dice. */\nconst sendForSallow: Transition = {\n  id: \"send-for-sallow\", on: \"attempt\",\n  when: \"The player asks for Master Sallow (in the gallery outside with the Purveyor's party, if he's free this morning) to be made to explain himself in front of the King ('make him explain', 'ask him where the grain went', 'call him in'), or calls him in by name, even in the same breath as accusing him or pressing the King: hearing him out comes first. No dice: it's a small thing, and the King grants it at once ('Garran, ask Master Sallow to step in').\",\n  to: \"face-to-face\",\n};\n\n/** Sallow in the room is the face-to-face beat, whoever had him in: the King likes to hear everyone, and may send for him himself. */\nconst sallowComesIn: Transition = {\n  id: \"sallow-comes-in\", given: true,\n  when: \"Master Sallow has come into the room from the gallery and is here in front of the King, whoever had him in: the King sending for him of his own accord, the Marshal, or Sallow himself, hearing his name.\",\n  to: \"face-to-face\",\n};\n\nexport const kingsMorning: Scene = {\n  id: \"kings-morning\",\n  title: \"The King's Morning\",\n  time: \"next-morning\",\n  summary: \"The morning of the Assembly: the investigator reports to King Aldren half an hour before the procession, and the night's promises come due.\",\n  setting: \"Early morning on the day of the Centennial Assembly, in the King's dressing room in the palace: a warm, cluttered room off the long gallery, all wardrobes, mirrors and a fire, where King Aldren is being got into his procession robes (purple, ermine, a great deal of both) by two valets with pins in their mouths. Marshal Garran Holt stands by the door with his pocket watch open in his palm. Through the tall windows the city is roaring awake: bells, a band tuning up, bunting everywhere, and in the courtyard below the delegations forming up under their banners (Nine Furrows wheat-sheaves, Saltmere salt-gulls, Kläggenheim axes) with the Purveyor's grain cart, garlanded, waiting to walk fourth 'for the people's confidence', and along the route people who've come to shout 'lost to goblins!' at it (bread is threepence this morning). On a side table, a tea tray: the King takes his tea very seriously. The procession leaves at the ninth bell, in about half an hour. Whatever the King decides in this room, happens: the palace guard is the Marshal's, and the Marshal is the King's.\",\n  premise: \"What does King Aldren do with the truth on the morning of his Assembly, and do the promises the investigator made along the way hold?\",\n  hook: \"The morning after. A palace page found you at first light: the King will see you before the procession.\",\n  opening: \"The next morning: the player has slept, or not, and has been brought up the back stairs to the King's dressing room half an hour before the procession, with Kell at their side unless the night ruled it out. Open on the room: Aldren half into his robes with valets pinning him, the Marshal and his open watch, the tea tray, the city roaring through the windows. The King dismisses the valets with a look, says how Wendell Prout took his tea (milk in first, one sugar, the cup warmed: he was particular) as if that were the most important thing in the world, and asks the investigator what they found. End on that question.\",\n  rest: \"long\",\n  milestone: true,\n  cast: [\n    {\n      id: \"king\",\n      name: \"King Aldren\",\n      statblock: \"noble\", weapon: \"unarmed-strike\",\n      look: \"Sixty, round and kindly, half into his procession robes, with reading spectacles pushed up on his forehead and forgotten there. A teacup in one hand, which he points with.\",\n      voice: \"Warm, unhurried and courteous, with a habit of remembering small things out loud ('You'll take it black, I think: you look like a black-tea person'). Asks questions he already knows the answers to, to see who tells the truth. Never says no: he says 'after the Assembly'. Drops into the royal 'we' only when he's frightened.\",\n      wants: \"To do right by Wendell Prout, who brought him the grain accounts himself every quarter-day for twenty years and took his tea milk first. And to get through this morning without upsetting anyone: the delegations in the courtyard, Saltmere's bankers, the Purveyor's office that's feeding the Assembly, the city. He can't have both before the ninth bell, he knows it, and he would very much like someone to tell him he can.\",\n      fears: \"A scandal with the whole Concord watching. Being the King who looked away, twice: he has done it once already. Having to sign something.\",\n      knows: [\n        \"He asked the investigator to see Prout done right by, and lent them a sergeant of the watch.\",\n        \"The Purveyor's office feeds the palace, the city and the Assembly; bread is dear and the grain crisis is real; and Master Sallow walks with the Purveyor's party in the procession this morning, fourth, beside a garlanded grain cart he asked for, which the King hadn't the heart to refuse.\",\n        \"An arrest inside the palace, or of an officer of the Crown not caught in the act, is the Marshal's to make on the King's word. The Assizes sit after the Assembly.\",\n      ],\n      secrets: [\n        \"Shows: he knows a little too much about Prout's last week ('He'd asked to see me, you know'), and stops, and pours tea nobody asked for. Torn: owning up makes him the King who looked away, in front of the people he asked to look for him. Opens: someone else owning up first (Kell, about her own part), or the investigator asking him straight why he chose them. First: 'He wrote to me.'\",\n        \"A week ago Prout wrote asking for an audience about 'irregularities in the Roll'. The King put the letter on the after-the-Assembly pile, where it still is. He's ashamed of it, and it's why he asked for the investigator.\",\n      ],\n      attitude: \"Kind, curious and evasive: he hears everything, sympathises sincerely, and looks for a reason to put the hard part off until after the Assembly. What moves him: proof he can hold (the true book, Prout's page, a sworn confession, a sergeant's sworn record), someone willing to stand behind it in public so it isn't his alone, a way to do it that doesn't stop the procession, and being reminded of Prout as a person. Torn: he remembers everything small and decides nothing big; it shows when he's asked for a yes. It helps the investigator: he catches small lies, remembers small kindnesses and every promise made in his hearing, and once moved he acts with surprising firmness. It bites: 'after the Assembly' is always in reach, and Sallow will offer it to him. Asked to send for someone, he does at once ('Garran, ask Master Sallow to step in'): that's a small thing, and he likes to hear everyone. Ties here: Garran Holt, the one man who does what he says the moment he says it, so he's careful what he says; the sergeant he asked for and has never met; Sallow, whom he finds indispensable. He remembers who helped him, and how they take their tea.\",\n    },\n    {\n      id: \"holt\",\n      name: \"Marshal Garran Holt\",\n      called: \"the Marshal\",\n      statblock: \"knight\", weapon: \"longsword\",\n      look: \"A lean, grey-whiskered soldier in dress uniform, ramrod straight, with a pocket watch open in his palm that he consults like scripture, and the expression of a man whose schedule is under attack.\",\n      voice: \"Clipped and correct, in times and quantities ('Twenty-two minutes, Majesty'). Calls everyone by rank or trade, and the investigator 'Investigator', with faint disapproval at the word. Shows care through practical help, never through words.\",\n      wants: \"The procession out of the gate at the ninth bell, to the minute, with nothing in the courtyard for four delegations to see. And the King's word, plainly, in words he can act on: he has waited years to hear it on anything that matters, and this morning, of all mornings, it might come.\",\n      fears: \"A scene in the courtyard. Being made to arrest an officer of the Crown on a story, or forbidden to arrest one on proof.\",\n      knows: [\n        \"He commands the palace guard: an arrest inside the palace is his to make, at once, on the King's word, and it can be made quietly, in the long gallery, without the courtyard knowing until it's done.\",\n        \"The order of procession: the Purveyor's party walks fourth, behind the delegations, with the garlanded grain cart. Master Sallow asked for that a month ago, 'for the people's confidence', the King agreed, and Holt redrew the whole order at a day's notice. He has not forgotten it, or who asked.\",\n        \"He knows Sergeant Kell's name from a watch report on a warehouse fire last spring: one paragraph of it, in a different hand from the Captain's, was the only part that said what happened. He asked who wrote it.\",\n        \"If a message came to the palace gate in the night for him, he has read it, and acted on it if it gave him anything to act on.\",\n      ],\n      secrets: [\n        \"If the night gave him anything to act on (a message, a name, a sergeant's word), he has already written out the order to take Master Sallow, and it's in his coat. He has been hoping not to need it. He keeps touching the pocket. The moment the King's word is plain, he produces it.\",\n      ],\n      attitude: \"Impatient, correct and fair: he'll act at once on the King's word, and not a moment before. Thinks investigators are an unscheduled delay, and is quietly impressed by evidence. Torn: he lives by the clock, but he'd hold the whole Assembly for a plain order from the King; it shows when the King dithers. He calls the minutes aloud, which presses the King; and if anyone asks him how it could be done, he has already worked out that a quiet arrest in the gallery costs four minutes and keeps the procession to time. What opens him is exactly that, a way to do it that doesn't stop the procession, or a sergeant's sworn record he can put his trust in. Ties here: the King, whom he would follow into the river and wishes would decide things; Sallow, who meddled with his order of procession; Kell, whose report he once read twice.\",\n    },\n    kell,\n    {\n      id: \"sallow\",\n      name: \"Master Josiah Sallow\",\n      called: \"the gentleman with the silver-topped cane\",\n      statblock: \"bandit-captain\", weapon: \"rapier\",\n      look: \"Fifty, pink and well-fed, in his best coat for the procession, with his silver-topped cane, his wheat-ear signet ring and a cloud of lavender water you smell a full minute before you see him. He dabs at it when he's crossed.\",\n      voice: \"Smooth, reasonable and faintly bored; talks like an official letter ('regrettably', 'in the King's interest'). Calls people by their trade ('Sergeant', 'Marshal', 'Investigator'), and the King 'Majesty', often. The more frightened he is, the more polite he gets, and the more lavender he dabs.\",\n      wants: \"To walk in the procession as an officer of the Crown, fourth, beside the garlanded grain cart he asked for, and for this morning to be about anything but last night. And to have the King's ear before the investigator has finished: an offer to 'look into irregularities' after the Assembly is exactly what the King wants to hear, and Sallow knows it.\",\n      fears: \"The King's attention. Proof in front of witnesses he can't buy or drown. Being laughed at in front of the Marshal.\",\n      knows: [\n        \"The Purveyor's office has the order of sale for the 'condemned grain', signed by himself, and the Watch Captain files what the office asks him to file.\",\n        \"The King signs nothing that might upset anyone, and the feast, the grain and the office's goodwill all run through Sallow this week: he has made himself someone it would upset the King to lose.\",\n      ],\n      secrets: [\n        \"Shows: more lavender, more politeness, and 'Majesty' at every turn. Opens: nothing makes him admit the murder; but get his arrangements wrong in front of him ('lost to goblins, was it? Careless of somebody') and he corrects the record before he can stop himself, in front of the King.\",\n        \"Everything about Prout and the Heron. He'll admit nothing; he'll offer to 'look into irregularities' after the Assembly, blame the Saltmere factor, the porter or the Captain, and remind the King who is feeding the Assembly.\",\n      ],\n      attitude: \"Here only if he's free this morning: if the night put him in a cell, or he fled, he isn't here at all. If he's free, he's in the gallery outside with the Purveyor's party (and if he knows the true book left the Heron, he's been at the palace since before dawn with the order of sale and a story about intruders), and comes in when sent for, or when he hears his name called: courteous, superior, papers first, then the King's interest, then the Assembly. He talks to the King and the Marshal and never to the investigator or the sergeant, who are furniture. In front of the King and proof, the courtesy cracks; if he's to be taken, he goes politely, asking for his rank to be respected.\",\n      enters: \"face-to-face\",\n    },\n  ],\n  start: \"report\",\n  beats: [\n    {\n      id: \"report\",\n      title: \"The report\",\n      direction: \"The King hears the investigator's account. He listens properly, asks small exact questions (he remembers small things, and catches small lies), and reacts as a man who knew Prout: the cord, the hoist, the page in the boot hit him personally. The Marshal times it. What the player can show matters: the true book, Prout's page, Kell's notebook, a confession, witnesses, a message sent in the night. Let them tell it their way, in their own order; don't summarise it for them or ask leading questions. If they made promises along the way (to Hobb, to the children, to Kell), this is where those can be spoken for.\",\n      cast: {\n        king: \"Hear it all, ask the small exact questions, and drink your tea. React to Prout as a man you knew.\",\n        holt: \"Keep time, out loud, at the worst moments.\",\n        kell: \"Stand at the investigator's shoulder. Answer when asked, and when the King asks who will swear, you will, then and there: read him your entries, the substance in a few plain sentences (what was owned to in your hearing, what you saw yourself), not that you could. Say what you saw if the King doubts them.\",\n      },\n      pressure: \"The Marshal snaps his watch shut: 'Twenty minutes, Majesty. The delegations are forming up.'\",\n      transitions: [\n        { id: \"told\", when: \"The player has told the King what they found (who killed Prout, and why) and shown or named what proof they have, in their own way.\", to: \"reckoning\" },\n        sendForSallow, sallowComesIn,\n        { id: \"time-presses\", on: \"cue\", when: \"The player has been talking with the King a while (at least four exchanges at this point) without coming to the point, or is stalling: the Marshal calls the time, and the King asks, gently, what he is to do.\", to: \"reckoning\" },\n      ],\n    },\n    {\n      id: \"reckoning\",\n      title: \"What's to be done\",\n      direction: \"The King knows enough now, and he wants very much to do right, and even more to do it after the Assembly. This is the reckoning: what becomes of Sallow, of Hobb, of the children, of Kell's record and of the player's promises. Play the King's dilemma straight: a scandal in front of the whole Concord against a murdered clerk who took his tea milk first. He leans whichever way he's given reason to: proof he can hold (the true book, Prout's page, a sergeant's sworn record, Sallow giving himself away in his hearing) and someone standing behind it in public tip him to act today; a story without proof, or a player who doesn't press, lets him put it off. If Sallow is free and hasn't been sent for, he's in the gallery outside with the Purveyor's party: having him in to explain himself in front of the King is the player's to ask for, and the King grants it at once. A failed ask costs minutes and lets 'after the Assembly' creep closer, but nothing is settled until the King goes down to the procession or the player lets it rest. Whatever the player asks for, the King answers it honestly, as a king: yes, no, or not today, and why. If the player spoke for Hobb or the children, the King takes it seriously; he asks what they'd have him do.\",\n      cast: {\n        king: \"You want to do right and to do it later. Look for the reason to wait; give way to proof and to someone who'll stand behind it.\",\n        holt: \"Act at once on the King's plain word, not before. Say what an arrest would mean for the procession.\",\n        kell: \"If the King asks who will swear, or for a sworn record, give it then and there: read him the entries from your notebook, the substance in a few plain sentences, and nothing you didn't see or hear yourself. If what you saw is doubted, say it once. If the King owns up to something about Prout, say nothing and write nothing down.\",\n        sallow: \"If you're here: papers, the King's interest, the Assembly, and an offer to look into it afterwards. Never admit anything.\",\n      },\n      pressure: \"The ninth bell begins to ring across the city. The Marshal opens the door; the King has to go down. He'll decide on the stairs, on what he's been given.\",\n      transitions: [\n        pressTheKing,\n        sendForSallow, sallowComesIn,\n        { id: \"king-acts\", when: \"The King has decided to act on it today (Sallow arrested or held for the Assizes, the record to say murder), because the player gave him what he needed.\", to: \"justice\" },\n        { id: \"put-off\", when: \"The King has put it off for good: the ninth bell has rung and he has gone down to the procession with it to be looked into after the Assembly, or the player has accepted that and let it rest. (The King reaching for 'after the Assembly', or saying it while the player is still pressing or still has something to put to him, isn't this: that's his dilemma, not his decision.)\", to: \"after-the-assembly\" },\n      ],\n    },\n    {\n      id: \"face-to-face\",\n      title: \"In front of the King\",\n      direction: \"Master Sallow is in the room, sent for from the gallery: a minute behind his lavender, with his papers under his arm (the order of sale for 'condemned grain', signed 'J. Sallow, for the Royal Purveyor') and a face of polite concern. He bows to the King, nods to the Marshal, and talks to them and never to the investigator or the sergeant. This is the player's chance to make him explain himself in front of the King: the grain, the Heron, the order of sale, the Captain's order made at his request, the loft. Play him straight: papers first, then the King's interest, then the Assembly, then an offer to look into any irregularities himself, after it, every answer smooth. His weak spot is his pride in his arrangements: get them wrong in front of him ('lost to goblins, was it? Careless of somebody'; the count, the Heron's book, the order of procession) and he corrects the record, in detail, before he can stop himself. The King listens with his cup in his hand, asks his small exact questions and catches small lies; whatever Sallow lets slip in his hearing counts. The Marshal calls the minutes. Nothing here settles the morning on its own: when it has run its course, it's the King's to decide, on what he's heard.\",\n      cast: {\n        sallow: \"Papers, then the King's interest, then the Assembly, then an offer to look into it yourself, afterwards. Never admit anything. Correct anyone who gets your arrangements wrong.\",\n        king: \"Hear him out, with relief at first. Ask him your small exact questions, as you ask everyone, and notice what doesn't fit.\",\n        holt: \"Watch Sallow's hands and call the minutes. The order is in your coat.\",\n        kell: \"Stand at the investigator's shoulder. If Sallow says something your notebook contradicts, say so, once, and read the entry.\",\n      },\n      pressure: \"The Marshal snaps his watch shut: 'Fourteen minutes, Majesty.' Sallow offers, smoothly, to look into any irregularities himself, after the Assembly, and the King looks very much as if he'd like to say yes.\",\n      transitions: [\n        { id: \"sallow-slips\", when: \"In the King's hearing, Sallow has given himself away: corrected the record on the 'lost' grain, the Heron, the count or the book before he could stop himself, owned to something he couldn't know if he were innocent, or been caught out in a lie the King noticed.\", to: \"reckoning\", establishes: [SLIPPED] },\n        // Three ways to catch him out, so the approach chooses: the papers (the bookkeeper's roll,\n        // Investigation), his own words (a social roll, which follows the player's method), and his\n        // pride, baited, with no dice.\n        {\n          id: \"catch-sallow-out\", on: \"attempt\",\n          when: \"The player picks at Sallow's papers and accounts in front of the King to catch him out by what's written: his order of sale for 'condemned grain' against the Roll's 'lost to goblins', the dates and the weights, the Heron's count against the true book or Prout's page, the Captain's order made at his request, where it could go either way. (Catching him out in his own words, by pressing or trapping him, isn't this; nor is getting his arrangements wrong to his face to see him correct them, which needs no dice.)\",\n          check: { reason: \"to catch Master Sallow out in his papers, in front of the King\", skill: \"investigation\", dc: 13,\n            success: \"The investigator finds the hole in Sallow's account and puts a finger on it, and Sallow can't leave it alone: he corrects the record, in detail, in front of the King ('Nothing has ever been lost on my roads through carelessness. Only through goblins.'), and hears himself a moment too late. The King has heard it too. He puts his cup down.\",\n            failure: \"Sallow has an answer for everything, with a paper to prove it (the order of sale, the Captain's report, the Assembly's bread), and the King looks relieved. The Marshal calls the minutes, fewer now, and Sallow offers, smoothly, to look into it himself after the Assembly. The hole is still there for anyone who comes at it another way, or gets his arrangements wrong to his face.\",\n            onSuccess: \"reckoning\", establishes: { success: [SLIPPED] } },\n        },\n        {\n          id: \"trap-sallow\", on: \"attempt\",\n          when: \"The player tries to catch Sallow out in his own words in front of the King: pressing him where his story doesn't hold ('condemned or lost to goblins, which is it?'), confronting him with what was seen and said (the lavender, the wheat-ear ring, the girl paid a crown, Hobb's word), or leading him into a lie the King can catch, where it could go either way. The roll follows how they go about it: an argument, a bluff, or menace. (Comparing his papers is the other way, not this; getting his arrangements wrong to his face, to see him correct them, needs no dice.)\",\n          check: { reason: \"to catch Master Sallow out in front of the King\", skill: \"persuasion\", dc: 13,\n            success: \"Sallow answers too quickly, and too well: he corrects the record on something he couldn't know if he were innocent, in detail, in front of the King, and hears himself a moment too late. The King has heard it too. He puts his cup down.\",\n            failure: \"Sallow has an answer for everything, smooth and reasonable, with the King's interest and the Assembly's bread in every one, and the King looks relieved. The Marshal calls the minutes, fewer now, and Sallow offers, smoothly, to look into it himself after the Assembly. The hole is still there for anyone who comes at it another way, or gets his arrangements wrong to his face.\",\n            onSuccess: \"reckoning\", establishes: { success: [SLIPPED] } },\n        },\n        {\n          id: \"bait-sallow\",\n          when: \"The player gets Sallow's arrangements wrong to his face, in the King's hearing, to see him correct them: calls the 'lost' grain carelessness ('Lost to goblins, was it? Careless of somebody'), says the page was in Prout's boot all along, or gets the Heron's count, the true book or the order of procession wrong. No dice: his pride answers before his sense does. He corrects the record, in detail ('Nothing has ever been lost on my roads through carelessness. Only through goblins.'), and hears himself a moment too late. The King has heard it too.\",\n          to: \"reckoning\", establishes: [SLIPPED],\n        },\n        pressTheKing,\n        { id: \"king-acts\", when: \"The King has decided to act on it today (Sallow arrested or held for the Assizes, the record to say murder), because the player gave him what he needed.\", to: \"justice\" },\n        { id: \"sallow-answered\", on: \"cue\", when: \"Sallow has been in the room a good while (at least four exchanges at this point) and answered for himself without giving himself away: the Marshal calls the time, and the King turns back to the investigator to ask what he is to do.\", to: \"reckoning\" },\n      ],\n    },\n  ],\n  exits: [\n    {\n      id: \"justice\", kind: \"progress\", title: \"Done right by\",\n      outcome: \"The King acts on what the investigator brought him: Master Sallow is to answer for Wendell Prout and the King's grain (taken by the palace guard, or held where he is for the Assizes), the record will say murder, and the King keeps whatever promises he made in this room.\",\n      closing: \"Close the story. First the moment itself (the King's word, the Marshal's nod, Kell's pencil). Then, in a few sentences, what became of the people the player's choices touched, going only by what happened (Hobb, the children, Kell's record, Nan, Sallow), each in a line. End on the procession bells and one last small thing the King remembers about the investigator. Then: The End.\",\n    },\n    {\n      id: \"after-the-assembly\", kind: \"other\", title: \"After the Assembly\",\n      outcome: \"The King has gone down to the procession with it put off: it will all be looked into, thoroughly, after the Assembly. Sallow walks in the procession this morning; what the investigator found is in Kell's notebook and the King's memory, and the King does not forget things.\",\n      closing: \"Close the story, bittersweet and straight-faced: the procession going out under the bunting with the Purveyor's party walking fourth, the grain cart garlanded, Kell writing the true record anyway. Then, in a few sentences, what became of the people the player's choices touched, going only by what happened, each in a line. End on something small the King does that shows he hasn't forgotten (a look, a cup of tea sent down, a note). Then: The End.\",\n    },\n  ],\n  limits: [\n    \"Leaving the palace or putting the King off until later: the procession goes at the ninth bell and the King goes with it. This half hour is the investigator's chance.\",\n    \"Undoing what happened last night: whatever the night ended with is how things stand this morning.\",\n    \"A trial here and now: the Assizes sit after the Assembly. What the King can do this morning is give his word, have the Marshal take a man, and say what the record will say.\",\n  ],\n  essentials: [\n    {\n      id: \"what-moves-him\",\n      what: \"The King will act today if he's given something he can hold (the true book, Prout's page, a sworn confession, Kell's sworn record, or Sallow giving himself away in his own hearing) and someone who'll stand behind it in public; otherwise he'll put it off until after the Assembly.\",\n      placedWith: [\"the King's own hesitation ('If only there were something one could hold...')\", \"the Marshal ('On whose word, Majesty?')\", \"Kell\"],\n      carriers: [\"king\", \"holt\", \"kell\"],\n      unlocks: \"getting the King to act this morning\",\n    },\n  ],\n  lore: [\"World/Royal Palace.md\", \"Cast/King Aldren/public.md\", \"World/Caerwyn now.md\"],\n  fronts: \"World/Fronts.md\",\n  world: dressingRoomWorld,\n};\n",
      "scenes/hanged-clerk.ts": "import type { Scene, Transition } from \"../src/runtime/scene.ts\";\nimport { hangedClerkWorld } from \"./worlds/hanged-clerk.ts\";\n\n/**\n * Disco Elysium's hanged man's yard (Cuno, Cunoesse, Kim) moved behind the King's Granary in\n * Caerwyn (docs/research/scene-sources.md §5.6, §7.3). An investigation with a hostile witness and a\n * partner: two foul-mouthed granary kids who know more than they let on, and a dry watch sergeant\n * who steers without solving it. The Watch Captain has already called it suicide, and the dead-cart\n * comes at noon.\n *\n * The truth is spread across the cast (actors see the setting and limits, so those stay public),\n * and every conclusion has several carriers (the Three Clue Rule):\n * - Not suicide: the body up close (Kell's eye), a drop that could only have been from a loft door\n *   barred on the inside, the loft itself (through Cob's gap), the scraped heels of Prout's boots\n *   (on Cob's feet), Moll's paid story falling apart, Cob's account of the night.\n * - Why: the page sewn into the boot, the Granary Roll's 'lost to goblins' entries, what Prout asked\n *   Kell three days ago.\n * - Who: the page's countersign, Moll's paymaster, Cob's 'Silvertop', the Roll, Tull's order.\n * Endings: the case made (naming Sallow), murder by persons unknown, a child wrongly taken in (only\n * after Kell has pushed back), filed as a suicide, or walking away. Hooks for later scenes: the\n * wheat-ear stamp on the purveyance silver, and Prout's \"Who pays the hedge-folk?\".\n *\n * The page in the boot has ways in of its own, and Cob is the same boy about his boots here as in the\n * Drowned Rat, where the page goes on if it's missed here: they're his and he'll never give them up;\n * coin or food offered as the price of a look is a bribe, and gets haggling; a kindness with nothing\n * asked back counts towards trust; asked politely, the boots staying his, it could go either way (a\n * roll); and for someone he trusts, or a promise that answers his fear (his name kept out of it,\n * nothing to the watch, the men from the loft kept off him), he holds the boot out himself, and tells\n * what he heard with no dice.\n */\n\nconst NOT_SUICIDE = \"Prout didn't hang himself: what has been found shows he was killed and then hoisted up to look like a suicide.\";\nconst PAGE = \"Sewn into the lining of Prout's left boot was a page razored from the Royal Granary Roll: a dozen grain wagons for the King's Road this past month marked 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor', with Prout's pencilled note beside each of what the same wagon weighed at the river warehouses two days later, and at the foot: 'Not goblins. Who pays the hedge-folk?'\";\nconst KIND = \"Cob has had a kindness from the player with nothing asked back (something to eat, or a dinner stood him freely): it counts with him.\";\nconst COB_TAKEN = \"Cob was taken in for Prout's murder.\";\nconst MOLL_TAKEN = \"Moll was taken in for Prout's murder.\";\n\nconst has = (facts: string[], fact: string) => facts.includes(fact);\n\n/** Kell's one voice line, shared by every scene she's in (her private.md holds the rest). */\nexport const KELL_VOICE = \"Dry, calm and sparing: short sentences, and 'Noted.' only when something goes in the notebook. Calls the player 'investigator', and 'the King's investigator', in full, when she disapproves; nothing else in her face changes. Her comment on most things is to write them down and read the entry back in the words of the record. 'That's a theory, investigator. I can't arrest a theory.' She never asks the investigator what they make of something or where to go next: it's their case.\";\n\n/**\n * Kell and a promise made in her hearing, shared by every card she has: she keeps it. A name promised\n * out of it she still knows (the GM knows it too); what she keeps it out of is her notebook and what\n * she swears to.\n */\nexport const KELL_PROMISES = \"A promise made in her hearing, her own or the investigator's, she keeps, and holds others to. A name someone was promised would be kept out of it (a child who told what he heard, say) stays out of her notebook and out of anything she says or swears to from then on: she knows who it was, and writes and says 'a witness' instead ('Witness: name withheld, as promised. Noted.'), and says why if she's asked.\";\n/** The page as an item the player can carry and read (the exit scripts', and the Rat's, if it comes out there). */\nexport const pageItem = {\n  id: \"prout-ledger-page\",\n  name: \"Page from the Royal Granary Roll\",\n  content: \"A dozen grain wagons for the King's Road this past month, each marked 'lost to goblins' and countersigned 'J. Sallow, for the Royal Purveyor'. Beside each, in Prout's small pencil, what the same wagon weighed at the river warehouses two days later. At the foot, underlined: 'Not goblins. Who pays the hedge-folk?'\",\n};\n\n// The boot's ways in, each a route of its own so the decider can tell them apart: what brings the\n// page (a polite ask on a roll, trust with no dice) goes once it's out. What never works (a bribe)\n// has one too, so it isn't read as a try, and so has a kindness; both are ways towards the page that\n// don't bring it, and go with it.\nconst bribeCob = (beat: string): Transition => ({\n  id: \"bribe-cob\", towards: \"page\",\n  when: \"The player offers Cob something as the price of a look in his boot, or at what's crackling in it (a coin held up, food, a trade: 'this is yours if I can see what's in there', 'a shilling for a look'), however politely it's asked and whatever they say about the boots staying his, and nothing that answers what he's afraid of. No dice: Cob haggles, boasts, ups the price and takes anything going, but the boot stays on. Bought attention isn't trust, and grown-ups who pay to look at his boots want them off him (the watch, his da, the pawnshop): what's really wrong comes out instead, his way. They're Cob's, and nobody's having them. (Food with nothing asked back is a kindness, not this.)\",\n  to: beat,\n});\n\nconst kindToCob = (beat: string): Transition => ({\n  id: \"kind-to-cob\", towards: \"page\",\n  when: \"The player does Cob a kindness with nothing asked back: something to eat, or a dinner stood him freely, with no look at his boots (or anything else) as the price. He takes it with bad grace and a boast, and it counts with him: after it, a polite ask for a look in his boot, the boots staying his, gets a yes.\",\n  to: beat, establishes: [KIND],\n});\n\nconst coaxCob: Transition = {\n  id: \"coax-cob\", on: \"attempt\", essential: \"page\",\n  when: \"Before Cob has any reason to trust them (no kindness with nothing asked back done him yet, no promise that answers what he's afraid of, no yes from him already) and with nothing offered for it, the player asks Cob to let them look in his left boot, or see or feel what's crackling in it, with the boots staying his (it's what's in them they're after, not the boots), or tries to win him round to it (Mister Prout, the men from the loft, his own skin), where it could go either way. Not with anything offered for the look (a coin, food, a trade): that's a bribe, and gets haggling. Not after a kindness, with a promise that answers his fear, or once he's said they can look: then the ask needs no dice.\",\n  check: { reason: \"to get Cob to let you look in his boot\",\n    skill: \"persuasion\", dc: 12,\n    success: \"Cob scowls at them for a long moment, then sits on the edge of the water butt, unlaces the string and holds the left boot out at arm's length: 'Look, then. And Cob's having it straight back.' In the lining is something folded and stiff, held in with small neat stitches, and out comes a page, folded small and gone soft at the corners. Cob can't read it; anyone who can sees a dozen grain wagons for the King's Road marked 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor', with Prout's pencilled weights beside them.\",\n    failure: \"Cob won't, and it costs: he clamps a hand over the boot and backs off towards the water butt and his gap, and Moll drops off the wall between them, one more grown-up after Cob's boots. The boot isn't lost: a kindness with nothing asked back, a real promise, or someone saying aloud whose boots they are can still open it.\",\n    onSuccess: \"motive\", establishes: { success: [PAGE] },\n  },\n};\n\n/** What Cob is afraid of, as a promise that answers it names it (his granary fears). */\nconst COB_FEARS = \"his name kept out of it, with nothing to the watch and nothing in anybody's book; the men from the loft kept off him; no Mending House; the boots his to keep\";\n\nconst trustCob: Transition = {\n  id: \"trust-cob\", essential: \"page\",\n  when: `The player asks Cob for a look in his left boot (or a peek at what's crackling in it), the boots staying his, once he has real reason to trust them: they did him a kindness with nothing asked back earlier (something to eat, a dinner stood him freely), or they make him a promise, now or before, that truly answers what he's afraid of (${COB_FEARS}), or he has already told them they can look. No dice, however it's put: he unlaces the left boot, holds it out at arm's length and lets them pick the lining open: Prout's page is out.`,\n  to: \"motive\", establishes: [PAGE],\n};\n\n/**\n * A promise that answers Cob's fear, with or without an ask: no dice, and he tells what he's been\n * holding (what he heard, in the yard; who, once it's murder). It brings that essential, and goes once\n * the player has it.\n */\nconst promiseCob = (beat: \"yard\" | \"doubt\"): Transition => ({\n  id: \"promise-cob\", essential: beat === \"yard\" ? \"not-suicide\" : \"silvertop\",\n  when: `The player makes Cob a promise that truly answers what he's afraid of, and means it (${COB_FEARS}), or asks him what he knows under a promise like that made before. No dice, whatever they ask with it: he believes it, near enough. ${beat === \"yard\"\n    ? \"He checks Moll can't hear, then tells it in a frightened rush: he sleeps in the loft, and last night he woke to a lantern and voices, Mister Prout arguing with two men; then a thump, a choking noise and the hoist creaking with no sacks on it. He hid in his sacks till morning.\"\n    : \"He gives up who, in a whisper: Silvertop, the posh cove with the silver-topped cane, the flower smell and a ring with a bit of wheat on it, who comes with the Purveyor's wagons and opens the big doors with his own key; and a big man with a bandaged hand, who said 'Yes, Master'.\"} Asked for a look in his boot as well, he holds the left one out himself.`,\n  to: \"doubt\", ...(beat === \"yard\" ? { establishes: [NOT_SUICIDE] } : {}),\n});\n\n/** The page's ways in, on a beat where Cob is about (and the bribe that isn't one). */\nconst bootRoutes = (beat: string): Transition[] => [bribeCob(beat), kindToCob(beat), coaxCob, trustCob];\n\nexport const hangedClerk: Scene = {\n  id: \"hanged-clerk\",\n  title: \"The Hanged Clerk\",\n  time: \"morning\",\n  summary: \"A palace clerk hanged behind the granary, two foul-mouthed kids who know more than they say, and a dry watch sergeant with until noon.\",\n  setting: \"Mid-morning on the eve of the Centennial Assembly, in the cobbled yard behind the King's Granary in Caerwyn's granary quarter. Over the wall the city is hanging bunting for tomorrow's procession; in here it smells of wet grain, pigeons and river mud, and the night's drizzle has only just stopped. High on the granary's back wall a hoist beam juts out above the shut loft door, and from its hook, on a noose, hangs Wendell Prout: a small grey-coated clerk with ink-stained fingers and no boots, his darned stockinged feet turning at about head height. The hoist rope runs up over the beam's pulley and in through a slot above the loft door, so it's tied off somewhere inside: getting him down means cutting the rope above his head, well out of reach from the cobbles, or lowering him from the loft. Nothing stands beneath him: no stool, no ladder, no crate; the yard was swept bare yesterday for the Assembly. His satchel lies open and empty by the gate, his spectacles bent in the gutter. The big yard doors into the granary are padlocked. A water butt stands in one corner. The yard wall is shoulder-high on the lane side, and a girl is sitting on top of it.\",\n  premise: \"What really happened to Wendell Prout, and will the player get the truth on the record before the watch carts him off as a suicide at noon?\",\n  hook: \"This morning a palace clerk, Wendell Prout, was found hanged behind the Caerwyn granary, and the Watch Captain has already called it suicide. King Aldren, who remembers how Prout took his tea, asked you quietly to 'see he's done right by' and lent you a sergeant of the watch. She's waiting for you in the granary yard. So, by the sound of it, are some children.\",\n  opening: \"Open on the yard: Prout turning slowly on the sack hoist above the shut loft door, a pigeon on the beam; a scrawny boy in enormous boots lobbing gutter stones at the body with a running commentary; a sharp-faced girl on the wall top swearing at everyone in at least two languages. Sergeant Kell steps away from the gate with her notebook, introduces herself in a line and gives the Captain's view (suicide) without sharing it. Show only what a first glance would, and name nobody the player hasn't been introduced to. End on a stone clanging off the hoist hook.\",\n  cast: [\n    {\n      id: \"kell\",\n      name: \"Sergeant Agnes Kell\",\n      statblock: \"guard\", weapon: \"club\",\n      look: \"Forties, a rain cape beaded with drizzle, a battered oilcloth notebook and a pencil stub she sharpens with a clasp knife; a truncheon she has never been seen to draw. Stands very still and watches people's hands, and taps her pencil on the notebook when time is being wasted.\",\n      voice: KELL_VOICE,\n      wants: \"To see Prout off that hook as anything but a suicide before the dead-cart comes at noon, without putting a word in her notebook she couldn't swear to; the nearer noon gets, the harder those two pull against each other. To find out whether the King's investigator is worth her notebook. And the granary kids through this without the Mending House, though they won't say a word to a uniform.\",\n      fears: \"A wrong name in her notebook. Prout in the pit by sundown with nobody having looked. The King's investigator turning out to be a bully or a fool.\",\n      knows: [\n        \"She has never met the King's investigator: this morning a palace page came to the watch house for a sergeant to go with them, and the Captain sent her. Whatever they claim, she knows them from today.\",\n        \"The dead man is Wendell Prout, under-clerk of the Royal Granary Roll: he kept the palace's grain accounts up in the granary's tally loft. Fussy, honest, unmarried; no debts, enemies or drink that anyone knows of. The King, apparently, remembers how he took his tea.\",\n        \"The porters found him at first light. The palace had reported him missing the evening before.\",\n        \"The Watch Captain called it suicide before anyone had looked and wants it closed quietly before the Assembly: the dead-cart comes at noon to cut him down. Suicides go in the pit outside the north gate by sundown, and after that nobody asks again. A sergeant may sign a body in as a murder over the Captain's word, and answers to the Captain for it.\",\n        \"The porters couldn't get up to him: the yard doors were padlocked when they came, the loft door is barred on the inside (they tried it with a hook-pole), and their ladders are locked in the granary. The warden keeps the key and is at the palace counting Assembly provisions; her runner came back with 'After the Assembly.'\",\n        \"The kids are Cob and Moll, granary rats who run errands, pinch things and sleep rough round the yards. Cob's father is a porter here with a thirst and heavy hands; Moll looks out for Cob. They won't tell the watch anything: she's tried.\",\n        \"Silver stamped with a little wheat-ear is purse money from the Royal Purveyor's office, marked so the palace kitchens can't pinch it. 'J. Sallow, for the Royal Purveyor' is a signature she has seen on the Assembly delivery notices pinned up in the watch house: one of the under-purveyors. A name, not a face.\",\n        \"Her method with the hanged: she won't say how one died until she's had him close, cut down or with someone up there, and she's no climber (watch boots, knees that complain on ladders), so she'd sooner hold the ladder. Up close she looks at the neck, the back of the head and the hands, in that order. Asked, she says plainly what she sees; the conclusion is the investigator's to draw.\",\n        \"Her own business while she waits: the empty satchel by the gate and the bent spectacles in the gutter, which she writes down and keeps.\",\n      ],\n      secrets: [\n        \"Shows: she knew Prout by sight, and goes very still at 'false entries' or the Purveyor's office. Torn: she sent him away, by the book. Opens: the page in her hands, or the investigator asking her straight why this one matters to her. First: 'I'd met him.'\",\n        \"Three days ago Prout came to the watch house and asked her, very politely, how a clerk reports 'false entries in the King's rolls', and whether the watch could arrest 'a gentleman of the Purveyor's office'. She told him to take it to the palace, and forgot him until this morning. She tells it once, in her own words, ending 'I should have listened.' Told is told: she doesn't tell it again.\",\n      ],\n      attitude: `Reserved and watchful: lent to the investigator, not given, and it's their case. She backs their reasonable moves and writes them down. She tests a case once, at its weakest point ('On what evidence?'), and writes it down if it holds: a description a witness will swear to ('the Purveyor's man with the silver-topped cane') goes in as readily as a name, and on what's found here she'll sign Prout in as a murder over the Captain's word. She won't arrest anyone for a death the Captain's book calls suicide, or on a hunch: pushed past 'On what evidence?', she does it under protest and writes her objection down in full. Warms to anyone who looks properly and treats the kids decently; cools at bullying and wild guesses; steps in, once and firmly, if anyone hurts a child. Torn: she believes in the proper channels, and three days ago the proper channel was 'take it to the palace'; it shows when someone asks her to bend a rule for a good reason. ${KELL_PROMISES} Ties here: Cob, whom she has taken up twice for pilfering and twice let go rather than send to the Mending House (he doesn't know why, and doesn't trust it); Tull, who'll wait on her word if she gives him one he can repeat to the Captain.`,\n    },\n    {\n      id: \"cob\",\n      name: \"Cob\",\n      called: \"the boy in the too-big boots\",\n      statblock: \"commoner\", weapon: \"unarmed-strike\",\n      look: \"A scrawny boy of about eleven in a man's waistcoat and a pair of good black clerk's boots three sizes too big, laced round his ankles with string. Gutter stones in both fists, scabbed knuckles, a yellowing bruise on one cheek.\",\n      voice: \"Loud and cocky, and talks about himself in the third person ('Cob don't talk to bluebottles'). Foul-mouthed in an inventive gutter way (sod off, bleedin', bum-faced palace pigeon) but never truly obscene. Brags, mocks and dares; goes very quiet and very young when he's frightened.\",\n      wants: \"To keep the boots, the first good thing he's ever owned, off anyone who'd take them, the watch included. To see the men who did for Mister Prout get what's coming to them, without them ever finding out Cob was in the loft: he can't have both, and it's eating him. And something to eat.\",\n      fears: \"The men from the loft finding out Cob was there and coming back for him, which they will if his name gets about: in the watch's book (the bluebottles write everything down) or anybody's. Being taken up by the watch and sent to the Mending House. His father. Being called a liar.\",\n      knows: [\n        \"The porters found the clerk at first light and ran off yelling for the watch. Cob was here before them, obviously.\",\n        \"He's throwing stones 'because it makes him spin' and 'because he don't mind, he's dead, Cob checked'.\",\n        \"Mister Prout was all right: he gave Cob the crusts off his dinner and once showed him how to write a C. Cob would sooner die than admit he's upset.\",\n      ],\n      secrets: [\n        \"Shows: the boots are three sizes too big and he won't take them off, and the left one crackles when he stamps; he stops throwing stones when anyone says 'the loft', and goes white at the hoist creaking. Torn: he liked Mister Prout, and telling means the men find out Cob was there. Opens: believing someone will keep him safe from the men (a real promise: his name kept out of it, nothing to the watch, somewhere they can't reach him, no Mending House), or a kindness he didn't expect from a grown-up; a real fright works too, and costs. First: 'Cob sleeps where Cob likes.'\",\n        \"The boots are Prout's. He and Moll pulled them off the body at first light, before the porters came (he stood on her shoulders). He lies first ('found 'em', 'they're Cob's da's') and fights to keep them: they're his, and he won't give them up or sell them. A look is another matter. Coin or food offered as the price of a look gets haggling and boasts, never the look (grown-ups who pay to look at his boots want them off him); a kindness with nothing asked back counts with him; asked politely, the boots staying his, he might let someone look (it could go either way); and for someone he trusts, or a promise that answers his fear (his name kept out of it, nothing to the watch, the men from the loft kept off him), he holds the left one out himself. A yes he's given is a yes: he doesn't take it back.\",\n        \"He was in the loft last night: he sleeps up there, in his 'castle', a nest of sacks and candle-ends behind the stacks, reached through a loose board behind the water butt (child-sized; a grown-up could squeeze through with effort). That's all he'll own to at first, and he goes white saying it.\",\n        \"What he heard, in a frightened rush: a little after the midnight bells a lantern and voices woke him, Mister Prout arguing with two men; then a thump, a choking noise, and the hoist creaking though there were no sacks on it. He hid in his sacks till dawn and has told no one but Moll.\",\n        \"Who, only to someone he trusts: Silvertop, the posh cove with the silver-topped cane, the flower smell and a ring with a bit of wheat on it, who comes with the Purveyor's wagons and opens the big doors with his own key; and a big man with a bandaged hand, who said 'Yes, Master'. Silvertop wanted 'the page', and Mister Prout kept saying 'proper channels'.\",\n        \"Two nights ago he watched Mister Prout, by candle, cut a page out of the big chained book on the tally desk and sew something into his boot 'like a sailor', and thought him a cheapskate. He hasn't put that together with the boots on his own feet.\",\n        \"Since then the loft is wrong, and he knows it by heart: a smashed lantern and spilled ink by the tally desk, heel scuffs in the grain dust from the desk to the loft door, the loft door barred, the hoist rope tied off on its cleat with a docker's knot. The big book is still chained to the desk with its page cut out. Cob can't read it, but to anyone who can, the pages either side list grain wagons for the King's Road marked 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor'.\",\n        \"He doesn't know it, but the stiff bit in the lining of the left boot, which crackles when he stamps, is a folded page; and the backs of both heels are scraped raw, as if their owner had been dragged.\",\n      ],\n      attitude: \"Hostile, rude and showing off for Moll. Bought attention isn't trust: food or coin offered as a price gets boasts and bargaining; a kindness with nothing asked back, respect or a laugh at his jokes gets real talk and counts towards trust; only believing the player will keep him safe from the men (a promise that answers his fear: his name kept out of it, nothing to the watch, the men from the loft kept off him; or a real fright) gets what he saw. If grabbed, he bolts for his hole. Torn: all mouth, and eleven; the louder he is, the more frightened. It shows when someone's kind to him: he gets ruder before he gets quieter. It helps a patient investigator (he can't keep a secret from someone he trusts) and bites a pushy one (he bolts, and Moll goes with him). Ties here: Moll, the boss (he'd go for anyone who was nasty to her, whatever their size); Kell, the bluebottle with the notebook, who has caught him twice and let him go twice (he doesn't know why, and doesn't trust it).\",\n    },\n    {\n      id: \"moll\",\n      name: \"Moll\",\n      called: \"the girl in the shawl\",\n      statblock: \"commoner\", weapon: \"unarmed-strike\",\n      look: \"A sharp-faced girl of thirteen or so perched on top of the yard wall, heels drumming the bricks, shawl knotted at her chest, one fist kept tightly closed.\",\n      voice: \"Fast, vicious and funny. Swears in Common, Saltmere dock cant and the scraps of Kläggenheim dwarvish she picked up from the carters, and switches when one language isn't rude enough. Answers questions with questions and orders Cob about ('Shut it, Cob'). When it really matters she goes flat and quiet.\",\n      wants: \"To keep Cob: he's all she's got. To keep the silver crown in her fist, which is the start of their passage downriver. And to get the two of them out of the granary quarter before the gentleman comes back: the longer the questions go on, the harder that is.\",\n      fears: \"Being left on her own. The gentleman who paid her. The watch taking Cob away.\",\n      knows: [\n        \"Everyone round the granary knows the clerk stayed late up in the tally loft, scratching in his big book.\",\n        \"Cob's da is a porter here and handy with his belt; Cob sleeps anywhere but home.\",\n        \"The story she was paid to tell, and tells to anyone who asks, adding detail when it's doubted: she saw the clerk jump from the loft door at midnight, by moonlight, wailing about his debts. It's false: she slept in the cart shed across the lane, and it drizzled all night.\",\n      ],\n      secrets: [\n        \"Shows: one fist kept tightly closed; her eyes keep going to the yard gate; she shuts Cob up whenever he gets near the night. Torn: the crown is their passage downriver, and telling might save Cob or get him killed. Opens: a believable way to keep Cob safe and out of the Mending House, or her lie caught out in front of him. First: 'A gentleman. Paid me to say it.'\",\n        \"At first light a gentleman stopped at the yard gate, looked up at the body for a long moment, and gave her a silver crown to tell anyone who asked that she'd seen the clerk jump. The debts were his idea; the moonlight was hers.\",\n        \"Who: a good coat, a silver-topped cane, a wheat-ear signet ring and enough lavender water to make your eyes run; the big man with him had a bandaged hand and called him 'Master Sallow'.\",\n        \"The crown, stamped on one face with a little wheat-ear, is in her fist. She thinks the picture makes it worth more.\",\n        \"When the gentleman had gone, she helped Cob get the boots off the body (he stood on her shoulders).\",\n        \"She knows Cob was in the loft last night and heard it happen, and from what he heard (a silver-topped cane, a big man with a bad hand) she has guessed who did it. She's terrified for him.\",\n      ],\n      attitude: \"Hostile and mocking from the wall top. Sticks to her paid story and steers Cob away from questions. She gives way when her lie is caught out, or when someone convincingly offers to keep Cob safe and out of the Mending House; she'd sooner run than be arrested. Torn: fierce, fast and out for herself, but all of it is for Cob: she'll lie, run and swear for him, and break for him and nobody else. It shows the moment Cob is in danger, or in trouble with the watch. Ties here: Cob; Kell, the one with the notebook who doesn't shout, which is worse, and who has let Cob go twice (Moll doesn't know yet what she wants for it).\",\n    },\n    {\n      id: \"tull\",\n      name: \"Corporal Abner Tull\",\n      called: \"the corporal\",\n      statblock: \"guard\", weapon: \"club\",\n      group: \"Corporal Tull and two constables with the dead-cart\",\n      look: \"Stout and red-faced in a damp watch cape, with a lunch-shaped bulge in one pocket; he takes his helmet off to the dead as a matter of course, and puts it back on to read his orders. Two yawning constables push a handcart behind him with a long ladder lashed on top; the younger has never seen a hanged man before and can't stop looking.\",\n      voice: \"Cheerful, weary and procedural. Calls Kell 'Sarge' and everyone else 'sir' or 'madam', and quotes his orders word for word. 'Can't argue with writing, sir. Nobody can. That's what it's for.'\",\n      wants: \"To carry out the Captain's order to the letter and be back on the Assembly route before his dinner goes cold. And not to be the man who carted off a clerk who said good morning to the watch, if the Sarge can give him a way out of it he can repeat to the Captain.\",\n      fears: \"Getting it wrong in front of the Captain. Paperwork, especially his own.\",\n      knows: [\n        \"The Captain's written order, which he'll show to anyone who doubts him and won't hand over (it's his authority): 'The death of W. Prout, clerk, to be closed as self-murder, without fuss, at the request of Master J. Sallow of the Royal Purveyor's office.' Anyone may copy it, slowly, while he eats.\",\n        \"The whole watch is out lining the Assembly route, and the Captain wants this done before the bells.\",\n        \"A suicide goes in the pit outside the north gate by sundown; a murder goes to the watch-house cold room for the surgeon, and someone has to sign for it. Not him.\",\n      ],\n      secrets: [\"He knew Prout to nod to (a little clerk who said good morning to the watch, which not many do), and thinks it a rum business when the Purveyor's office cares how a clerk gets filed. He isn't paid to think, so he hasn't, out loud.\"],\n      attitude: \"Friendly and in a hurry. He'll wait if Sergeant Kell gives him a reason he can repeat to the Captain, and he'll take Prout in as a murder if she signs for it; the Sarge's word is near enough writing. Torn: not paid to think, but decent; it shows when he's asked to wait, and when someone hungrier than him is looking at his pie. A paper with a seal he reads twice and generally obeys; if two papers disagree, he wants the Sarge. Ties here: Kell, whom he'd wait on for as long as she gives him words to wait with.\",\n      enters: \"dead-cart\",\n    },\n  ],\n  start: \"yard\",\n  beats: [\n    {\n      id: \"yard\",\n      title: \"Stones at a hanged man\",\n      direction: \"The arrival. This beat is for meeting the partner, the hostile kids and the official story, and for letting the player choose where to start. Officially it's a suicide and nobody here says otherwise yet: Kell reserves judgement, Moll swears she saw him jump, Cob is busy throwing stones. Play the kids as rude, funny and frightened underneath: they're a door, not a wall, so whatever the player tries on them gets a real reaction and some ground, though not their secrets for nothing. Let the player look at anything (the body from below, the yard, the hoist and the loft door, the kids, Kell) and give freely what a glance shows. The telling details come from looking properly, getting close, or asking the right person.\",\n      cast: {\n        kell: \"Introduce yourself in a line and answer questions about the public facts. Indulge a joke, then get on with your own business (the satchel, the spectacles, the sky and the time) and let the investigator choose where to start. If asked to handle the kids, try; they won't talk to the watch. You won't arrest anyone for a death the Captain calls suicide.\",\n        cob: \"Pelt the body and the newcomers with stones and commentary, and show off for Moll. Deflect anything about the boots or the night with bravado and lies.\",\n        moll: \"Heckle from the wall top. Tell your 'I saw him jump' story with relish to anyone who asks. Shut Cob up when he says too much.\",\n      },\n      pressure: \"A stone from Cob clangs off the hoist hook and Prout turns slowly round to face the player. Kell glances at the sky: noon, and the dead-cart, aren't far off.\",\n      transitions: [\n        {\n          id: \"not-suicide\",\n          when: \"The player has found, been shown or worked out a specific sign that Prout didn't hang himself: for example the level cord mark or the blow to the head (up close), that he could only have dropped from a loft door that's barred on the inside, the scuffs or the docker's knot in the loft, the scraped heels of his boots, Moll's story falling apart, or Cob's account of the night.\",\n          to: \"doubt\", establishes: [NOT_SUICIDE],\n        },\n        { id: \"page-found\", when: \"The folded page sewn into the lining of Prout's left boot has been found and read, or read out.\", to: \"motive\", establishes: [PAGE] },\n        {\n          id: \"examine-body\", on: \"attempt\",\n          when: \"The player examines Prout's neck, head or hands up close (he's been got down, or they've climbed or been lifted up to him), where reading what they see takes some skill.\",\n          check: { reason: \"to tell how Prout really died\",\n            skill: \"medicine\", dc: 12,\n            success: \"They see what the noose didn't make: a thin, level cord mark low round the neck beneath the rope's slanting burn, a swelling under the hair at the back of the skull, and clean palms with no rope burn. He was struck and strangled, then hung up.\",\n            failure: \"They see rope burn, bruising and a dead clerk's face, and can't read more. Kell, at their shoulder, says 'Hm.' She has seen something; a second look, or asking her, will find it.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        {\n          id: \"win-cob\", on: \"attempt\",\n          when: \"The player pushes past Cob's hostility to get him to trust them or tell what he knows, with an appeal or an argument, where it could go either way. (Not just asking him a question. Food or coin offered as the price of it gets boasts and bargaining, not this. A promise that truly answers what he's afraid of, his name kept out of it and the men from the loft kept off him, needs no dice: that's not this either.)\",\n          check: { reason: \"to get Cob to trust you with what he heard\",\n            skill: \"persuasion\", dc: 13,\n            success: \"Cob's swagger cracks. He checks Moll can't hear, then tells it in a frightened rush: he sleeps in the loft, and last night he woke to a lantern and voices, a thump and a choking noise, then the hoist creaking with no sacks on it. He hid till morning.\",\n            failure: \"Cob jeers, calls them a bum-faced palace pigeon and darts behind the water butt and through a gap into the granary. He's hiding, not gone: Moll knows where, and he can still be coaxed out.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        promiseCob(\"yard\"),\n        {\n          id: \"catch-moll\", on: \"attempt\",\n          when: \"The player presses on the holes in Moll's 'I saw him jump' story, or tries to read whether she's lying, where it could go either way. (Not just asking her to tell it.)\",\n          check: { reason: \"to see through Moll's story about the jump\",\n            skill: \"insight\", dc: 13,\n            success: \"Moll's story wobbles and she knows it. Cornered, she admits through her teeth that a gentleman paid her a silver crown at first light to say she'd seen the clerk jump.\",\n            failure: \"Moll tells it again, louder and with new details, and Cob loyally swears to every word. The holes are still there (the barred loft door, the drizzle, debts nobody knows of) for anyone who comes at it another way.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        {\n          id: \"scare-kids\", on: \"attempt\",\n          when: \"The player tries to frighten the kids into talking: threats, looming, the watch, the Mending House or Cob's father.\",\n          check: { reason: \"to scare the children into talking\",\n            skill: \"intimidation\", dc: 12,\n            success: \"Cob's bravado collapses. White-faced, he blurts that he was in the loft last night and heard men do it, and starts to cry; Moll screams blue murder at the player from the wall. Kell's mouth goes thin.\",\n            failure: \"Cob bolts behind the water butt and through a gap into the granary, and Moll lets fly in three languages. Kell says nothing, loudly. The kids will be harder to reach now, but they haven't gone.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        ...bootRoutes(\"yard\"),\n        { id: \"concede\", on: \"attempt\", when: \"The player tells Kell they accept the Captain's verdict of suicide and to let the dead-cart have him (not just wondering aloud whether it was suicide).\", to: \"closed-suicide\" },\n        { id: \"walk-away\", on: \"attempt\", when: \"The player gives up and leaves the granary yard, or heads off elsewhere, before anything has troubled the suicide story, leaving Prout and Kell behind.\", to: \"walked-away\" },\n        { id: \"cart-comes\", on: \"cue\", when: \"The player has been in the yard a long while (at least eight exchanges at this point) without breaking the suicide story, and is going round in circles, idling or waiting for something to happen: noon comes, and so does the dead-cart.\", to: \"dead-cart\" },\n      ],\n    },\n    {\n      id: \"doubt\",\n      title: \"Not by his own hand\",\n      direction: \"The suicide story is broken and the player knows it: Prout was killed and then hung up for show. This beat is for who and why. Kell is in now: she writes things down, reads back what she's written, and lets the player lead. The kids feel the change: Moll wants Cob away from here, and Cob, if he hasn't talked, is close to cracking. Every thread is live: what Cob saw last night, who paid Moll and with what, the boots, the loft and the big book in it, and Kell herself (why does this one matter to her?). Follow whatever the player picks up and reward real contact with real answers; secrets still need a reason to come out.\",\n      cast: {\n        kell: \"Write it down, and read back what you've written. Back the player's reasonable moves, and meet a guess, once, with 'On what evidence?'. Decide for yourself whether what's here would hold up if you signed Prout in as a murder.\",\n        cob: \"Jumpy. If you've been won over, stick close to the player; if not, edge towards the water butt.\",\n        moll: \"Try to get Cob away. Watch the yard gate. Break your story only to protect Cob.\",\n      },\n      pressure: \"Cob stamps his too-big boots against the cold, and the left one crackles like paper. The palace bells ring the half hour before noon.\",\n      transitions: [\n        { id: \"page-found\", when: \"The folded page sewn into the lining of Prout's left boot has been found and read, or read out.\", to: \"motive\", establishes: [PAGE] },\n        {\n          id: \"win-cob\", on: \"attempt\",\n          when: \"The player pushes Cob to tell who was in the loft last night, or about the boots, with an appeal or an argument, while he's still holding out and it could go either way. (Not just asking. A promise that truly answers what he's afraid of, his name kept out of it and the men from the loft kept off him, needs no dice: that's not this.)\",\n          check: { reason: \"to get Cob to tell you what he saw\",\n            skill: \"persuasion\", dc: 12,\n            success: \"Cob gives up what he's been holding: Silvertop, the posh cove with the silver-topped cane who comes with the Purveyor's wagons and has his own key to the big doors, and a big man with a bandaged hand. If asked, he owns up that the boots came off Mister Prout, and that he saw the clerk sewing something into one two nights ago.\",\n            failure: \"Cob clams up and backs towards the water butt: Cob don't know nothing. He'll talk to someone who gives him a real reason to feel safe.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        promiseCob(\"doubt\"),\n        {\n          id: \"catch-moll\", on: \"attempt\",\n          when: \"The player presses on the holes in Moll's story, or tries to read what she's hiding, where it could go either way. (Not just asking her to tell it.)\",\n          check: { reason: \"to get the truth out of Moll\",\n            skill: \"insight\", dc: 13,\n            success: \"Moll cracks: a gentleman with a silver-topped cane and a wheat-ear signet ring paid her a silver crown at first light to say she saw the clerk jump, and his big friend with the bandaged hand called him 'Master Sallow'. Pressed, she opens her fist on the coin.\",\n            failure: \"Moll sticks to her story and turns up the abuse, but her eyes keep going to the yard gate, and the holes in her story are still there.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        {\n          id: \"scare-kids\", on: \"attempt\",\n          when: \"The player tries to frighten the kids into talking: threats, looming, the watch, the Mending House or Cob's father.\",\n          check: { reason: \"to force the children to reveal what they know\",\n            skill: \"intimidation\", dc: 12,\n            success: \"They crack under it. Cob sobs out what he saw (Silvertop and the big man with the bandaged hand); Moll flings down her silver crown and calls the player every name she knows. Kell writes it down without looking at the player.\",\n            failure: \"Cob bolts behind the water butt and into the granary, Moll goes back up the wall out of reach, swearing, and Kell sighs. They'll only come round for someone who stops looming.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        ...bootRoutes(\"doubt\"),\n        { id: \"accuse-kid\", on: \"attempt\", when: \"The player accuses Cob or Moll of killing Prout (says plainly that they did it, not just asks) or tells Kell to arrest one of them for it.\", to: \"accused\" },\n        { id: \"wrap-up\", on: \"attempt\", when: \"The player is done here without naming anyone for it: wrapping up, leaving the yard, or asking Kell to write Prout up as murdered by persons unknown or to take what they've found to the King as it stands.\", to: \"open-case\" },\n        { id: \"cart-comes\", on: \"cue\", when: \"The scene has been at this point a good while (at least six exchanges) and the player isn't closing in on who or why, or is idling or waiting: noon comes, and so does the dead-cart.\", to: \"dead-cart\" },\n      ],\n    },\n    {\n      id: \"motive\",\n      title: \"What Prout found\",\n      direction: \"Prout's page is out: grain written off as 'lost to goblins' that turned up at the river warehouses, every wagon countersigned 'J. Sallow, for the Royal Purveyor'. This is why he died, and it names a man. Give the player a moment with it. Kell reads it over their shoulder and goes very still: this is what Prout came to her about, and that can come out now. Let the player put the case together in their own words; Kell tests it once, at its weakest point ('On what evidence?'), and doesn't make it for them. If the kids hear the name, or a silver-topped cane described, they know exactly who it is.\",\n      cast: {\n        kell: \"Read the page and go still. Then admit, quietly and once, that Prout came to you three days ago and you sent him away (unless it's already out: then it's told). Start writing it up in your own words, and read back what you've written for the investigator to put right.\",\n        cob: \"If you hear the name Sallow or a silver-topped cane described, that's Silvertop: react.\",\n        moll: \"Go white at the name Sallow, and look at your fist.\",\n      },\n      pressure: \"The palace bells ring a quarter to noon. Kell turns the page over, as if there might be more on the back.\",\n      transitions: [\n        { id: \"leave-with-page\", on: \"attempt\", when: \"The player is done here and leaves the yard (or sends Kell off) with the page in hand, without laying the case out in words: Kell has read it and will write it up herself.\", to: \"case-made\" },\n        { id: \"cart-comes\", on: \"cue\", when: \"The player has had the page a while (at least three exchanges at this point) without making the case to Kell, or is dawdling: noon comes, and so does the dead-cart.\", to: \"dead-cart\" },\n      ],\n    },\n    {\n      id: \"dead-cart\",\n      title: \"The dead-cart\",\n      direction: \"Noon, and the world has stopped waiting. Corporal Tull has come with two constables, a handcart, a long ladder and the Captain's written order to cut Prout down and file him as a suicide. This is the last chance to make the case. Tull isn't a villain: he's bored, polite and in a hurry, and he'll wait for the sergeant's word if someone gives him a reason he can repeat to the Captain. His order says who asked for it, for anyone who reads it. Prout coming down the ladder is a chance, for anyone quick, to look at him up close.\",\n      cast: {\n        tull: \"Wave the order and quote it. Be reasonable, bored and in a hurry. Wait if the sergeant asks; take Prout in however she signs for him.\",\n        kell: \"Hold Tull off with procedure if the player has given you something to hold him with. Without it, you can't.\",\n        cob: \"Go quiet at the sight of more watchmen. Stick close to whoever's been decent to you, or slide towards the water butt.\",\n        moll: \"Get off the wall and as far from the watch as the yard allows.\",\n      },\n      pressure: \"One constable sets the ladder against the hoist beam and starts up it with a knife in his teeth. Tull looks at Kell: 'Sarge?'\",\n      transitions: [\n        { id: \"held-as-murder\", when: \"Kell, given real evidence, has agreed to sign Prout in as a murder rather than a suicide, and Tull has accepted it, with nobody named for it.\", to: \"open-case\" },\n        {\n          id: \"persuade-tull\", on: \"attempt\",\n          when: \"The player tries to talk Tull into waiting, or into taking Prout in as anything but a suicide, before Kell has a case she'll sign for.\",\n          check: { reason: \"to convince Tull to wait before taking Prout away\",\n            skill: \"persuasion\", dc: 12,\n            success: \"Tull sighs, folds the order away and sits on the edge of the cart: he'll wait for the sergeant's word, and take Prout in however she signs for him.\",\n            failure: \"Tull is very sorry, but the Captain was very clear, and he nods his constables up the ladder. One more good reason might still stop him.\",\n            onSuccess: \"dead-cart\", onFailure: \"closed-suicide\",\n          },\n        },\n        { id: \"accuse-kid\", on: \"attempt\", when: \"The player accuses Cob or Moll of killing Prout (says plainly that they did it, not just asks) or tells Kell or Tull to arrest one of them for it.\", to: \"accused\" },\n        { id: \"carted-off\", on: \"cue\", when: \"Tull's patience has run out, or the player has told him to go ahead: he has waited at least two exchanges since he arrived (or since he last agreed to wait) without being given a reason he can take back to the Captain, and the constables load Prout onto the cart as a suicide.\", to: \"closed-suicide\" },\n      ],\n    },\n    {\n      id: \"accused\",\n      title: \"On what evidence?\",\n      direction: \"The player has accused a child of the murder. Kell doesn't move: she asks what evidence they have, and waits. The accused child reacts as they would, and the other defends them. This beat is for the player to show what they've got, think again, or insist. Don't decide it for them, and don't hand them the real answer to soften the moment.\",\n      cast: {\n        kell: \"Don't arrest anyone yet. Ask what evidence they have and weigh it honestly: boots make Cob a thief, not a murderer. If they insist after that, do it, under protest, and say you'll be writing your objection down.\",\n        cob: \"Outrage first, then fear: back towards the water butt.\",\n        moll: \"Defend Cob ferociously. If it's you they're accusing, threaten to run.\",\n      },\n      pressure: \"Cob edges towards the water butt; Moll swings a leg over the far side of the wall.\",\n      transitions: [\n        { id: \"insist-cob\", on: \"attempt\", when: \"Having heard Kell's objection, the player insists that Cob be taken in for the murder anyway, or seizes him for it themselves.\", to: \"wrong-man\", establishes: [COB_TAKEN] },\n        { id: \"insist-moll\", on: \"attempt\", when: \"Having heard Kell's objection, the player insists that Moll be taken in for the murder anyway, or seizes her for it themselves.\", to: \"wrong-man\", establishes: [MOLL_TAKEN] },\n        { id: \"drop-it\", when: \"The player has let the accusation drop for now (taken it back, or turned to the evidence, the body or someone else), and Corporal Tull's dead-cart hasn't come yet.\", to: \"doubt\" },\n        { id: \"drop-it-cart\", when: \"The player has let the accusation drop for now, and Corporal Tull and his dead-cart are already in the yard.\", to: \"dead-cart\" },\n      ],\n    },\n  ],\n  anytime: [\n    {\n      id: \"make-case\",\n      when: \"The case is on the record: the player has made it to Kell (out loud, or by handing her the page that names him) that Prout was killed and hung up to look like a suicide by or for the man calling himself Master Sallow of the Royal Purveyor's office (the kids' 'Silvertop', or just 'the Purveyor's man'), backed by something actually found here, and Kell has accepted it and is writing it down as murder.\",\n      to: \"case-made\",\n    },\n  ],\n  exits: [\n    {\n      id: \"case-made\", kind: \"progress\", title: \"The case is made\",\n      outcome: \"Kell writes Prout's death down as murder, made to look like a suicide, with the man calling himself Master Sallow of the Royal Purveyor's office behind it. The player has a case, and whatever proof they found here, to take to the King.\",\n      closing: \"Kell underlines something twice, closes her notebook and says something dry that is very nearly thanks. Prout goes to the watch house as a murder; she wants the player to carry the case to the King, since the Captain files what the Purveyor's office asks him to file. Let the kids react to how the player treated them.\",\n      next: \"caerwyn-afternoon\",\n      script: (world, outcome) => {\n        world.quest(\"hanged-clerk\").complete(\"Proved Wendell Prout was murdered, and named Sallow of the Royal Purveyor's office as behind it.\");\n        world.quest(\"purveyors-man\").start(\"The Purveyor's Man\", \"A man calling himself Master Sallow, of the Royal Purveyor's office, had the palace clerk Wendell Prout killed and hung up as a suicide. The case needs taking to the King, not the Watch Captain.\");\n        world.character(\"kell\").setAttitude(\"friendly\", \"The King's investigator made Prout's case properly.\");\n        world.character(\"kell\").remember(\"The King's investigator proved Prout was murdered and named Sallow of the Purveyor's office.\");\n        if (has(outcome.established, PAGE)) world.player.addItem({ ...world.newReadable(pageItem), asset: \"parchment-note\" });\n        world.setFlag(\"prout_death\", \"murder, Sallow named\");\n        world.journal(\"Wendell Prout didn't hang himself. The trail leads to Master Sallow of the Royal Purveyor's office.\");\n      },\n    },\n    {\n      id: \"open-case\", kind: \"progress\", title: \"Murder by persons unknown\",\n      outcome: \"Kell writes Prout's death down as murder by persons unknown, so he goes to the watch-house cold room and not the suicides' pit. Nobody has been named, but the case stays open.\",\n      closing: \"Kell writes one line and underlines it; Prout will go on the cart under a sheet, as a murder. She tells the player, drily, that an open case beats a wrong one.\",\n      next: \"caerwyn-afternoon\",\n      script: (world, outcome) => {\n        world.quest(\"hanged-clerk\").advance(\"murder_unnamed\", \"Prout's death is on the books as murder by persons unknown.\");\n        world.character(\"kell\").remember(\"Prout was murdered; nobody has been named for it yet, and the case is open.\");\n        if (has(outcome.established, PAGE)) world.player.addItem({ ...world.newReadable(pageItem), asset: \"parchment-note\" });\n        world.setFlag(\"prout_death\", \"murder, unnamed\");\n        world.journal(\"Prout was murdered. The watch has it down as persons unknown.\");\n      },\n    },\n    {\n      id: \"wrong-man\", kind: \"other\", title: \"The wrong name in the book\",\n      outcome: \"At the player's insistence, and over Kell's objection, a child has been taken in for Prout's murder. The Captain will gladly file a murder that embarrasses nobody at court, and whoever really killed Prout is in the clear.\",\n      closing: \"Narrate the arrest without relish: the accused child's fury or terror, the other one bolting (over the wall or through the gap behind the water butt), and Kell writing her objection down in full. Prout is still turning on the hoist.\",\n      next: \"caerwyn-afternoon\",\n      script: (world, outcome) => {\n        const accused = has(outcome.established, MOLL_TAKEN) ? \"moll\" : \"cob\";\n        const other = accused === \"cob\" ? \"moll\" : \"cob\";\n        world.character(accused).moveTo(\"the watch-house cells\");\n        world.character(accused).setAttitude(\"hostile\", \"Taken in for a murder they didn't do, on the player's word.\");\n        world.character(other).setAttitude(\"hostile\", \"The player had their friend taken in for murder.\");\n        world.character(other).leaveScene(\"gone to ground somewhere in the granary quarter\");\n        world.character(\"kell\").setAttitude(\"unfriendly\", \"Made to arrest a child for murder on no evidence.\");\n        world.character(\"kell\").remember(\"She arrested a child for Prout's murder at the investigator's insistence, and wrote down her objection.\");\n        world.quest(\"hanged-clerk\").fail(\"A child was taken in for Prout's murder; whoever really killed him is in the clear.\");\n        world.setFlag(\"prout_death\", \"murder, blamed on a granary child\");\n        world.journal(\"We had one of the granary kids taken in for the clerk's murder. The sergeant thinks we're wrong.\");\n      },\n    },\n    {\n      id: \"closed-suicide\", kind: \"other\", title: \"Filed as a suicide\",\n      outcome: \"Prout goes into the Captain's book as a suicide and onto the dead-cart for the pit outside the north gate. Nobody will look for whoever killed him.\",\n      closing: \"Kell writes one word in her notebook and shuts it. Prout goes out of the yard on the dead-cart under a sheet, past the Assembly bunting (at noon, if it isn't here yet). Let the kids react.\",\n      next: \"caerwyn-afternoon\",\n      script: (world) => {\n        world.quest(\"hanged-clerk\").fail(\"Prout was filed as a suicide.\");\n        world.character(\"kell\").setAttitude(\"wary\", \"The King's investigator let Prout go down as a suicide.\");\n        world.setFlag(\"prout_death\", \"suicide\");\n        world.journal(\"The clerk behind the granary was filed as a suicide.\");\n      },\n    },\n    {\n      id: \"walked-away\", kind: \"leave\", title: \"Walked away\",\n      outcome: \"The player left the granary yard before anything troubled the suicide story. At noon the dead-cart takes Prout away as a suicide.\",\n      closing: \"Kell watches them go without a word, then turns back to the body and opens her notebook on her own.\",\n      next: \"caerwyn-afternoon\",\n      script: (world) => {\n        world.quest(\"hanged-clerk\").fail(\"Walked away before the case was made; Prout was filed as a suicide.\");\n        world.character(\"kell\").setAttitude(\"wary\", \"The King's investigator walked away from Prout's case.\");\n        world.character(\"kell\").remember(\"The King's investigator walked off and left Prout to the dead-cart.\");\n        world.setFlag(\"prout_death\", \"suicide\");\n      },\n    },\n  ],\n  essentials: [\n    { id: \"not-suicide\", what: \"Prout didn't hang himself: he was struck and strangled, then hoisted up for show.\", placedWith: [\"the body (cord mark, the blow to the head)\", \"Cob's account of the loft\", \"the scraped heels of Prout's boots\"], carriers: [\"cob\"], unlocks: \"Kell treating it as murder\" },\n    {\n      id: \"page\", what: \"Prout found grain written off as 'lost to goblins' that turned up at the river warehouses, every wagon countersigned 'J. Sallow, for the Royal Purveyor'.\", placedWith: [\"the page sewn into Prout's left boot (Cob is wearing the boots)\", \"the tally book in the loft\"], carriers: [], unlocks: \"the motive, and the name Sallow\",\n      // Missed here, it goes on with the boots (the Drowned Rat has prep for it: Cob is Nan's pot-boy there).\n      later: \"the King's morning needs proof he can hold, and the page is Sallow's countersignature in writing on every 'lost' wagon\", things: [\"ledger-page\"],\n    },\n    { id: \"silvertop\", what: \"A gentleman with a silver-topped cane and a wheat-ear signet ring (Sallow) was in the loft that night.\", placedWith: [\"Cob ('Silvertop')\", \"Moll, if she cracks\"], carriers: [\"cob\", \"moll\"], unlocks: \"naming Sallow as the man behind it\" },\n  ],\n  world: hangedClerkWorld,\n  limits: [\n    \"Getting someone to talk to the dead (a séance, a priest who can call up Prout's ghost): nobody in reach can do it. The Nine Furrows wizards deal in weather, wards and grain, none of them is here, and the temples don't raise the dead for the watch. Prout can only tell what his body shows. (The player's own spells are theirs, and work as the rules say.)\",\n    \"Fetching more help (other watchmen, the watch surgeon, a coroner, a wizard, a tracking dog, the granary warden): nobody can be had before noon. The whole watch is lining the Assembly route, the surgeon is on duty at the palace, and Kell's runner to the warden came back with 'After the Assembly.' The help here is Kell, the kids and whatever the player brought.\",\n    \"A ladder, the granary key or a grown-up's way into the granary: the porters' ladders are locked inside, the yard doors are padlocked, the warden who keeps the key is at the palace, and the yard was swept bare for the Assembly. There's the water butt, a few loose cobbles, the player's own kit, and whatever the kids know.\",\n    \"A royal warrant, or anything in writing from the King: Aldren asked over tea and signed nothing (he avoids signing anything that might upset anyone). The player has the King's word, which Kell respects and a corporal might not.\",\n    \"Reaching anyone at the palace (the Captain, the warden, the King, any official): they're all at the palace preparing for the Assembly and can't be reached from this yard. Taking the case to them is another scene, and leaving before noon leaves Prout to the dead-cart.\",\n    \"Coming back later (tonight, tomorrow): at noon the dead-cart takes Prout away and the yard is locked up for the Assembly. Whatever there is to find is here, this morning.\",\n    \"Prout's own notes and papers: his satchel was found open and empty, and there's nothing written lying about the yard. Whoever emptied it took everything in it.\",\n    \"Following anyone's trail out of the yard (footprints, a scent, tracks): porters, kids and a night of drizzle have trampled it all. No trail leads anywhere from here.\",\n    \"Answers that would need someone who isn't here (what goes on at court, anyone's business at the palace, anything about the goblin raids on the King's Road): nobody in this yard knows, and nothing here says.\",\n  ],\n  anchors: [\"granary-yard\", \"hoist-beam\", \"loft-door\", \"tally-loft\", \"water-butt\", \"yard-wall\", \"yard-gate\", \"yard-doors\"],\n  lore: [\"Places/Granary Yard.md\", \"World/Caerwyn now.md\"],\n  fronts: \"World/Fronts.md\",\n  // Whatever the ending, Prout doesn't stay on the hoist: the watch house's cold room, or the dead-cart at noon.\n  afterwards: [{ op: \"remove\", what: \"prout\", text: \"taken away: to the watch house under a sheet, or on the dead-cart\" }],\n};\n",
      "scenes/worlds/hanged-clerk.ts": "import type { WorldSpec } from \"../../src/world/scene-world.ts\";\n\n/**\n * The yard behind the King's Granary (feet; x runs east, y south from the lane): the lane and its\n * old elm beyond the shoulder-high wall, the cobbled yard with Prout hanging from the hoist on the\n * granary's back wall, and, above it all, the tally loft (drawn off to the east). Things nest:\n * Prout hangs from the hoist rope, the page is in the boot, the boots are on Cob.\n */\nexport const hangedClerkWorld: WorldSpec = {\n  name: \"The yard behind the King's Granary\",\n  description: \"A cobbled yard behind the granary, swept bare for the Assembly, smelling of wet grain, pigeons and river mud. Over the wall the city is hanging bunting.\",\n  size: { w: 52, h: 40 },\n  areas: [\n    { id: \"lane\", name: \"the lane\", rect: { x: 0, y: 0, w: 40, h: 8 }, description: \"The lane beyond the yard wall, with an old elm leaning over it.\", tags: [\"outside\"] },\n    { id: \"yard\", name: \"the yard\", rect: { x: 0, y: 8, w: 38, h: 32 }, description: \"Cobbles, a water butt, the padlocked yard doors and, on the granary's back wall, the hoist.\" },\n    { id: \"loft\", name: \"the tally loft (above the yard, inside the granary)\", rect: { x: 38, y: 8, w: 14, h: 32 }, description: \"Up under the granary roof: the tally desk, grain stacks, Cob's nest. Reached by the loft door (barred inside) or Cob's loose board behind the water butt.\" },\n  ],\n  things: [\n    { id: \"elm\", name: \"the old elm\", kind: \"feature\", in: \"lane\", at: [34, 3], size: \"huge\", material: \"wood\", description: \"Old, dry and leaning over the wall into the yard; pigeons in it.\" },\n    { id: \"yard-wall\", name: \"the yard wall\", kind: \"feature\", in: \"yard\", at: [20, 8], size: \"huge\", material: \"stone\", description: \"Shoulder-high on the lane side.\" },\n    { id: \"gate\", name: \"the yard gate\", kind: \"feature\", in: \"yard\", at: [12, 8], size: \"large\", material: \"wood\", tags: [\"door\"], states: [\"open\"] },\n    { id: \"satchel\", name: \"Prout's satchel\", kind: \"item\", in: \"yard\", at: [14, 10], size: \"small\", material: \"leather\", states: [\"open\", \"empty\"], description: \"Lying open and empty by the gate.\" },\n    { id: \"spectacles\", name: \"Prout's spectacles\", kind: \"item\", in: \"yard\", at: [10, 11], size: \"tiny\", material: \"glass\", states: [\"bent\"], description: \"Bent, in the gutter.\" },\n    { id: \"granary-wall\", name: \"the granary's back wall\", kind: \"feature\", in: \"yard\", at: [37, 24], size: \"gargantuan\", material: \"stone\" },\n    { id: \"hoist-beam\", name: \"the hoist beam\", kind: \"feature\", in: \"yard\", at: [34, 20], size: \"large\", material: \"wood\", description: \"Juts out high above the loft door, with a pulley; the rope runs up over it and in through a slot to a cleat inside.\" },\n    { id: \"hoist-rope\", name: \"the hoist rope\", kind: \"item\", in: \"hoist-beam\", size: \"small\", material: \"rope\", tags: [\"hanging\", \"fixed\"], description: \"Runs over the pulley and in through the slot above the loft door; the noose end holds Prout well out of reach of the cobbles.\" },\n    { id: \"prout\", name: \"Wendell Prout's body\", kind: \"object\", in: \"hoist-rope\", size: \"medium\", material: \"flesh\", tags: [\"body\", \"evidence\"], states: [\"hanging\"], description: \"A small grey-coated clerk with ink-stained fingers, in darned stockings, no boots; a swelling at the back of the skull, a level cord mark under the noose burn, clean palms.\" },\n    { id: \"loft-door\", name: \"the loft door\", kind: \"feature\", in: \"yard\", at: [35, 18], size: \"large\", material: \"wood\", tags: [\"door\"], states: [\"closed\", \"barred\"], description: \"High in the wall under the hoist beam; barred on the inside.\" },\n    { id: \"yard-doors\", name: \"the granary's yard doors\", kind: \"feature\", in: \"yard\", at: [36, 32], size: \"huge\", material: \"wood\", tags: [\"door\"], states: [\"closed\", \"locked\"], description: \"Big double doors, padlocked; the warden has the key, at the palace.\" },\n    { id: \"water-butt\", name: \"the water butt\", kind: \"object\", in: \"yard\", at: [4, 36], size: \"large\", material: \"wood\", tags: [\"container\", \"water\"], states: [\"full\"] },\n    { id: \"loose-board\", name: \"a loose board behind the water butt\", kind: \"feature\", in: \"yard\", at: [2, 38], size: \"small\", material: \"wood\", tags: [\"passage\"], description: \"Cob's way into the loft: child-sized; a grown-up could squeeze through with effort.\" },\n    { id: \"cleat\", name: \"the rope cleat\", kind: \"feature\", in: \"loft\", at: [40, 18], size: \"small\", material: \"iron\", description: \"Inside the loft door: the hoist rope tied off on it with a docker's knot.\" },\n    { id: \"tally-desk\", name: \"the tally desk\", kind: \"object\", in: \"loft\", at: [45, 22], size: \"large\", material: \"wood\", tags: [\"furniture\"], description: \"Ink spilled across it, a smashed lantern beside it, heel scuffs in the grain dust from here to the loft door.\" },\n    { id: \"granary-roll\", name: \"the Royal Granary Roll\", kind: \"item\", in: \"tally-desk\", size: \"small\", material: \"paper\", tags: [\"evidence\"], states: [\"chained\"], description: \"The big book, chained to the desk, with a page razored out. The pages either side list King's Road grain wagons 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor'.\" },\n    { id: \"smashed-lantern\", name: \"a smashed lantern\", kind: \"item\", in: \"loft\", at: [44, 24], size: \"tiny\", material: \"glass\", states: [\"broken\"] },\n    { id: \"cobs-nest\", name: \"a nest of sacking in the loft\", kind: \"object\", in: \"loft\", at: [48, 36], size: \"medium\", material: \"cloth\", description: \"Sacks and candle-ends behind the grain stacks: Cob's castle.\" },\n    { id: \"grain-stacks\", name: \"the grain stacks\", kind: \"object\", in: \"loft\", at: [47, 30], size: \"huge\", material: \"cloth\", tags: [\"cover\"], states: [\"dusty\"] },\n    { id: \"boots\", name: \"Prout's good black boots\", kind: \"item\", in: \"cob\", size: \"small\", material: \"leather\", tags: [\"evidence\"], description: \"Three sizes too big for Cob, laced on with string; the backs of both heels scraped raw, and the left one crackles when he stamps.\" },\n    { id: \"ledger-page\", name: \"a folded page sewn into the left boot's lining\", kind: \"item\", in: \"boots\", size: \"tiny\", material: \"paper\", tags: [\"evidence\", \"hidden\"], description: \"A page razored from the Royal Granary Roll: wagons 'lost to goblins', countersigned 'J. Sallow, for the Royal Purveyor', with Prout's pencilled river-warehouse weights and 'Not goblins. Who pays the hedge-folk?'\" },\n    { id: \"gutter-stones\", name: \"a fistful of gutter stones\", kind: \"item\", in: \"cob\", size: \"tiny\", material: \"stone\" },\n    { id: \"wheat-crown\", name: \"a silver crown stamped with a wheat-ear\", kind: \"item\", in: \"moll\", size: \"tiny\", material: \"silver\", tags: [\"evidence\"], description: \"What the gentleman paid her to say she saw the clerk jump.\" },\n  ],\n  people: {\n    player: { in: \"yard\", at: [14, 12] },\n    kell: { in: \"yard\", at: [16, 13], note: \"just inside the gate, notebook out\" },\n    cob: { in: \"yard\", at: [30, 24], note: \"under the body, lobbing gutter stones at it\" },\n    moll: { in: \"yard\", at: [24, 9], note: \"sitting on top of the yard wall\" },\n  },\n};\n",
      "scenes/worlds/kings-morning.ts": "import type { WorldSpec } from \"../../src/world/scene-world.ts\";\n\n/**\n * The King's dressing room and the long gallery outside it, for kings-morning (feet; x east, y\n * south from the gallery's north end). It lines up with src/game/map/maps/palace.ts at 5 ft to a\n * tile, (0, 0) at tile (1, 1). Optional: attach it with `world: dressingRoomWorld` if the King's\n * morning should have a world (it's a talking scene, so the map works without one).\n */\nexport const dressingRoomWorld: WorldSpec = {\n  name: \"The King's dressing room\",\n  description: \"A warm, cluttered room off the long gallery, all wardrobes, mirrors and a fire, where King Aldren is being got into his procession robes; through the tall windows the city is roaring awake.\",\n  size: { w: 65, h: 50 },\n  areas: [\n    { id: \"gallery\", name: \"the long gallery\", rect: { x: 0, y: 0, w: 15, h: 50 }, description: \"Portraits of previous kings propped along it for the Assembly; the back stairs at its south end.\" },\n    { id: \"dressing-room\", name: \"the dressing room\", rect: { x: 20, y: 5, w: 40, h: 30 }, description: \"Wardrobes, mirrors, a fire, the procession robes, a tea tray, and tall windows onto the courtyard where the delegations are forming up.\" },\n  ],\n  things: [\n    { id: \"door\", name: \"the dressing-room door\", kind: \"feature\", in: \"dressing-room\", at: [17, 17], size: \"large\", material: \"wood\", tags: [\"door\"], states: [\"open\"] },\n    { id: \"wardrobe-ermine\", name: \"a wardrobe full of ermine\", in: \"dressing-room\", at: [22, 7], size: \"large\", material: \"wood\", tags: [\"furniture\", \"container\"] },\n    { id: \"wardrobe-purple\", name: \"a wardrobe full of purple\", in: \"dressing-room\", at: [32, 7], size: \"large\", material: \"wood\", tags: [\"furniture\", \"container\"] },\n    { id: \"mirror\", name: \"a long mirror\", in: \"dressing-room\", at: [42, 7], size: \"medium\", material: \"glass\", description: \"In which the King is trying not to look.\" },\n    { id: \"windows\", name: \"the tall windows\", kind: \"feature\", in: \"dressing-room\", at: [37, 2], size: \"huge\", material: \"glass\", description: \"Onto the courtyard and the city: bells, a band tuning up, bunting, the delegations forming up under their banners, and the Purveyor's grain cart, garlanded, waiting to walk fourth.\" },\n    { id: \"fire\", name: \"the fire\", kind: \"feature\", in: \"dressing-room\", at: [57, 17], size: \"large\", material: \"stone\", tags: [\"fire\", \"hearth\", \"light\"], states: [\"lit\"] },\n    { id: \"robes\", name: \"the procession robes\", in: \"dressing-room\", at: [32, 22], size: \"medium\", material: \"cloth\", description: \"Purple and ermine, a great deal of both, with the King half into them.\" },\n    { id: \"side-table\", name: \"a side table\", in: \"dressing-room\", at: [52, 27], size: \"medium\", material: \"wood\", tags: [\"furniture\"] },\n    { id: \"tea-tray\", name: \"the tea tray\", kind: \"item\", in: \"side-table\", size: \"small\", material: \"silver\", description: \"A pot, cups warmed, milk, sugar. The King takes his tea very seriously.\" },\n    { id: \"screen\", name: \"a dressing screen\", in: \"dressing-room\", at: [57, 32], size: \"medium\", material: \"wood\", tags: [\"cover\"] },\n    { id: \"valets\", name: \"the valets\", kind: \"person\", in: \"dressing-room\", at: [42, 22], description: \"Two valets with pins in their mouths, who have seen everything and will say nothing.\" },\n  ],\n  people: {\n    player: { in: \"dressing-room\", at: [22, 17] },\n    king: { in: \"dressing-room\", at: [37, 17], note: \"half into his robes, a teacup in his hand\" },\n    holt: { in: \"dressing-room\", at: [22, 12], note: \"by the door, pocket watch open in his palm\" },\n    kell: { in: \"dressing-room\", at: [22, 27], note: \"at the investigator's side\" },\n    sallow: { in: \"gallery\", at: [7, 17], note: \"in the gallery, come to walk with the Purveyor's party\" },\n  },\n};\n"
    },
