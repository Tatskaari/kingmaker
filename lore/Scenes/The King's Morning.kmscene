            "description": "Purple and ermine, a great deal of both, with the King half into them."
          },
          {
            "id": "side-table",
            "name": "a side table",
            "in": "dressing-room",
            "at": [
              52,
              27
            ],
            "size": "medium",
            "material": "wood",
            "tags": [
              "furniture"
            ]
          },
          {
            "id": "tea-tray",
            "name": "the tea tray",
            "kind": "item",
            "in": "side-table",
            "size": "small",
            "material": "silver",
            "description": "A pot, cups warmed, milk, sugar. The King takes his tea very seriously."
          },
          {
            "id": "screen",
            "name": "a dressing screen",
            "in": "dressing-room",
            "at": [
              57,
              32
            ],
            "size": "medium",
            "material": "wood",
            "tags": [
              "cover"
            ]
          },
          {
            "id": "valets",
            "name": "the valets",
            "kind": "person",
            "in": "dressing-room",
            "at": [
              42,
              22
            ],
            "description": "Two valets with pins in their mouths, who have seen everything and will say nothing."
          }
        ],
        "people": {
          "player": {
            "in": "dressing-room",
            "at": [
              22,
              17
            ]
          },
          "king": {
            "in": "dressing-room",
            "at": [
              37,
              17
            ],
            "note": "half into his robes, a teacup in his hand"
          },
          "holt": {
            "in": "dressing-room",
            "at": [
              22,
              12
            ],
            "note": "by the door, pocket watch open in his palm"
          },
          "kell": {
            "in": "dressing-room",
            "at": [
              22,
              27
