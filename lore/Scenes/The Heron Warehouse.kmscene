            ],
            "description": "Big double doors with a wicket in one leaf, barred inside on loading nights: only the Master comes in this way, at the midnight bell."
          },
          {
            "id": "sentry-box",
            "name": "the watchman's sentry box",
            "in": "wharf",
            "at": [
              17,
              12
            ],
            "size": "large",
