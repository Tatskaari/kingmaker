            ],
            "description": "Glowing by the land door, a kettle on it and Duchess's dinner warming beside it."
          },
          {
            "id": "duchess",
            "name": "Duchess",
            "kind": "creature",
            "in": "wharf",
            "at": [
              27,
              22
