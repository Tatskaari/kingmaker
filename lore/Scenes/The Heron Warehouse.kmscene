    {
      "id": "route:[\"beat\",\"floor\",\"win-scrope\",3,\"success\"]",
      "source": "floor",
      "target": "floor",
      "type": "smoothstep",
      "label": "Win scrope · success",
      "data": {
        "condition": "The player tries to persuade Scrope to give them the true book or to swear to it (for Prout's sake, for his own neck, for the King), where his terror of the Master could still win. (Proof that puts it beyond doubt for him needs no dice.)",
        "phase": "attempt",
        "skill": "persuasion",
        "dc": 14,
        "scope": "beat",
        "branch": "success",
        "outcomeText": "Scrope looks at the book for a long time, then closes it, does up the clasp and holds it out in both hands. 'It balances,' he says. 'Every page. Wendell would want it to balance.'",
        "sourceRoute": {
          "id": "win-scrope",
          "on": "attempt",
          "when": "The player tries to persuade Scrope to give them the true book or to swear to it (for Prout's sake, for his own neck, for the King), where his terror of the Master could still win. (Proof that puts it beyond doubt for him needs no dice.)",
          "check": {
            "reason": "to persuade the clerk to give up his ledger",
            "skill": "persuasion",
            "dc": 14,
            "success": "Scrope looks at the book for a long time, then closes it, does up the clasp and holds it out in both hands. 'It balances,' he says. 'Every page. Wendell would want it to balance.'",
            "failure": "Scrope hugs the book to his chest and shakes his head, white as paper: not with the Master coming. He hasn't called for anyone. Yet.",
            "onSuccess": "floor"
          }
        },
        "establishes": [],
        "checkReason": "to persuade the clerk to give up his ledger"
      }
    },
