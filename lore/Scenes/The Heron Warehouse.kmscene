      "scenes/heron-warehouse.ts": "7619a77068736e3e846d1f9cd68d35bc769851ac31204a7daed950c1c7e2af6d",
      "scenes/hanged-clerk.ts": "1ae4d1c997be24ba11bd50eff8aa501da1f4ce2e93ec555f1f7f6084bd12a886",
      "scenes/worlds/hanged-clerk.ts": "a334859025cf7734ed60fc818c4e15629bba9dfd2101dd3accb3372c4488c34c",
      "scenes/worlds/heron-warehouse.ts": "e11549036374e51b5a3c28604d8f9b367952da900e7e66408aa4d87b0c863a77"
    },
    "checkout": "/home/jon/git/kingmaker"
  }
}
