    {
      "id": "route:[\"beat\",\"wharf\",\"show-token\",2,\"direct\"]",
      "source": "wharf",
      "target": "floor",
      "type": "smoothstep",
      "label": "Show token",
      "data": {
        "condition": "The player shows a brass heron token (Hobb's, or one like it) at the river door's grille to be let in, with or without a story to go with it. No dice: the token is what the gang show, so whoever's nearest inside draws the bolt, looks them over ('You're not Hobb'), and pushes a sack into their arms, because Hep is short of hands: they're in as one of her hands, and working the floor needs no roll. A story told with the token isn't a bluff to roll for.",
        "phase": "attempt",
        "skill": "",
        "dc": 0,
        "scope": "beat",
        "branch": "direct",
        "outcomeText": "",
        "sourceRoute": {
          "id": "show-token",
          "on": "attempt",
          "when": "The player shows a brass heron token (Hobb's, or one like it) at the river door's grille to be let in, with or without a story to go with it. No dice: the token is what the gang show, so whoever's nearest inside draws the bolt, looks them over ('You're not Hobb'), and pushes a sack into their arms, because Hep is short of hands: they're in as one of her hands, and working the floor needs no roll. A story told with the token isn't a bluff to roll for.",
          "to": "floor",
          "establishes": [
            "The player is in at the Heron as one of Hep's hands, taken on at the river door with a sack in their arms: to the gang they're crew, and working the floor with their head down (carrying, slitting, sewing, fetching) needs no roll. Only going where a hand wouldn't (up the counting-box stair, a hand on the book, the Master's elbow) gets them looked at."
          ]
        },
        "establishes": [
          "The player is in at the Heron as one of Hep's hands, taken on at the river door with a sack in their arms: to the gang they're crew, and working the floor with their head down (carrying, slitting, sewing, fetching) needs no roll. Only going where a hand wouldn't (up the counting-box stair, a hand on the book, the Master's elbow) gets them looked at."
        ]
      }
    },
    {
      "id": "route:[\"beat\",\"wharf\",\"taken-on\",3,\"direct\"]",
      "source": "wharf",
      "target": "floor",
      "type": "smoothstep",
      "label": "Taken on",
      "data": {
        "condition": "The player goes in to work, token or none: shoulders a sack (one waiting on the plank walk, a split one off the hoist) and walks in at the river door with the gang as if they belong, or answers Hep's shout for hands at the river door, or asks there to be taken on for the night, or knocks at the grille for Hobb if he agreed at the Rat to let them in. No dice: Hep is short-handed on the Assembly eve (half the river's drunk) and anyone with a sack on their shoulder is crew until proven otherwise, so she puts them to work and asks who they are afterwards, if ever: they're in as one of her hands, and working the floor needs no roll. A story told with it isn't a bluff to roll for.",
        "phase": "attempt",
        "skill": "",
        "dc": 0,
        "scope": "beat",
        "branch": "direct",
        "outcomeText": "",
        "sourceRoute": {
          "id": "taken-on",
          "on": "attempt",
          "when": "The player goes in to work, token or none: shoulders a sack (one waiting on the plank walk, a split one off the hoist) and walks in at the river door with the gang as if they belong, or answers Hep's shout for hands at the river door, or asks there to be taken on for the night, or knocks at the grille for Hobb if he agreed at the Rat to let them in. No dice: Hep is short-handed on the Assembly eve (half the river's drunk) and anyone with a sack on their shoulder is crew until proven otherwise, so she puts them to work and asks who they are afterwards, if ever: they're in as one of her hands, and working the floor needs no roll. A story told with it isn't a bluff to roll for.",
          "to": "floor",
          "establishes": [
            "The player is in at the Heron as one of Hep's hands, taken on at the river door with a sack in their arms: to the gang they're crew, and working the floor with their head down (carrying, slitting, sewing, fetching) needs no roll. Only going where a hand wouldn't (up the counting-box stair, a hand on the book, the Master's elbow) gets them looked at."
          ]
        },
        "establishes": [
