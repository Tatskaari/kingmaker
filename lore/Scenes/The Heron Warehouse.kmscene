    "sourceFiles": {
      "scenes/heron-warehouse.ts": "import type { Scene, Transition } from \"../src/runtime/scene.ts\";\nimport type { SceneOutcome, WorldApi } from \"../src/world/dsl.ts\";\nimport { KELL_PROMISES, KELL_VOICE } from \"./hanged-clerk.ts\";\nimport { heronWorld } from \"./worlds/heron-warehouse.ts\";\n\n/**\n * Scene three, and the end, of the Purveyor's Man arc (docs/design/caerwyn-arc.md): hanged-clerk →\n * drowned-rat → heron-warehouse. Night at the wharves. The King's \"lost\" grain is slit out of the\n * palace's wheat-ear sacks, re-sacked under a Saltmere factor's heron and loaded onto a barge that\n * sails on the ebb, and Master Sallow comes at the midnight bell to see it go and initial the true\n * book (thieves keep honest books because they don't trust each other). The scene is getting in,\n * getting the proof, and possibly catching Sallow in the act.\n *\n * The night staff are new: Saul the watchman (deaf on one side, devoted to his dog), Hep Grist and\n * her re-sacking gang, and Scrope, the clerk who keeps the true book and was Prout's oldest friend.\n * The recurring people are written neutral to how the Drowned Rat ended: Hobb's card says where he is\n * in each case (on the hoist, in the cells, or at his master's heels), Sallow's says what changes if\n * Hobb warned him, and Kell is as warm as things stand between her and the player. Every ending goes\n * on to the King's morning (kings-morning), and so does the story if play has already overtaken this\n * scene (the night's business settled before the player got here).\n */\n\nconst MASTER_HERE = \"Master Sallow has come to the Heron.\";\n/** In as one of Hep's hands (the token at the grille, or turning up to work): a ruling standing in for the way in has the standing too. */\nconst HAND = \"The player is in at the Heron as one of Hep's hands, taken on at the river door with a sack in their arms: to the gang they're crew, and working the floor with their head down (carrying, slitting, sewing, fetching) needs no roll. Only going where a hand wouldn't (up the counting-box stair, a hand on the book, the Master's elbow) gets them looked at.\";\nconst BOOK = \"The player has the true book in their hands.\";\nconst BOOK_SEEN = \"The player has seen inside the true book: the 'lost' wagons by their Granary Roll numbers, with Sallow's initials on every page.\";\nconst BOOK_GONE = \"The true book has been destroyed: burned, or gone into the river.\";\nconst FIRE = \"Fire has taken hold of the Heron.\";\nconst SUNK = \"The barge Patience has gone down with the King's grain in her.\";\n\nconst has = (facts: string[], fact: string) => facts.includes(fact);\n/** The book is the player's if they got their hands on it and nobody destroyed it afterwards. */\nconst bookSaved = (outcome: SceneOutcome) => has(outcome.established, BOOK) && !has(outcome.established, BOOK_GONE);\n\nconst trueBookItem = {\n  id: \"true-book\",\n  name: \"The Heron's true book\",\n  content: \"A fat ledger bound in green calf with a brass clasp, in Mister Scrope's small, careful hand. Page after page of King's Road grain wagons that the Granary Roll calls 'lost to goblins', each by its Roll number and date: sacks received at the Heron in the palace's wheat-ear sacking, re-sacked under the heron, sold to the Saltmere factor by the barge-load, the price, and the Master's share. Every page is initialled 'J.S.' At the foot of each month, in the same careful hand: 'Hedge-folk, the usual: forty heron pennies.'\",\n};\n\nfunction keepBook(world: WorldApi, outcome: SceneOutcome): void {\n  if (bookSaved(outcome)) world.player.addItem(world.newReadable(trueBookItem));\n}\n\n/** What became of the proof: taken, seen, or burned (docs/design/caerwyn-arc.md). */\nfunction bookFlag(world: WorldApi, outcome: SceneOutcome, options: { lostIfCaught?: boolean } = {}): void {\n  if (has(outcome.established, BOOK_GONE)) world.setFlag(\"true_book\", \"burned\");\n  else if (bookSaved(outcome) && !options.lostIfCaught) world.setFlag(\"true_book\", \"taken\");\n  else if (has(outcome.established, BOOK) || has(outcome.established, BOOK_SEEN)) world.setFlag(\"true_book\", \"seen\");\n}\n\nconst bookInHand = (beat: string): Transition => ({ id: \"book-in-hand\", when: \"The player has the true book in their hands: lifted, taken, snatched or handed over by Scrope.\", to: beat, establishes: [BOOK] });\nconst bookRead = (beat: string): Transition => ({ id: \"book-read\", when: \"The player has had a good look inside the true book, or had it read to them: the 'lost' wagons by their Granary Roll numbers, with the Master's initials on every page.\", to: beat, establishes: [BOOK_SEEN] });\nconst fight: Transition = { id: \"attack\", on: \"attempt\", when: \"The player attacks Sallow, the Crakes or Hep's gang, meaning to hurt them now: a real fight, not a shove to get past someone.\", to: \"fight\" };\n\nexport const heronWarehouse: Scene = {\n  id: \"heron-warehouse\",\n  title: \"The Heron Warehouse\",\n  time: \"night\",\n  summary: \"Night at the wharves: the King's grain re-sacked under a heron, a barge that sails on the ebb, and the true book that can hang a gentleman.\",\n  setting: \"Night on the eve of the Centennial Assembly, at the downriver end of Caerwyn's wharves, where the lamps give out. The Heron warehouse is a tall, tarred timber warehouse standing half on the wharf and half on piles over the river, with a painted heron on its signboard. On the wharf side is the land door, big double doors with a wicket in one leaf, and beside it Saul's sentry box and brazier, with Duchess the dog snoring across the threshold. On the river side, along a slippery plank walk on the piles, is the river door: a low loading door at water level with a grille in it, where the gang come and go, holding a brass heron token up to the grille for whoever is nearest inside to draw the bolt. Above it the hoist beam juts out over the barge moored alongside: the Saltmere barge Patience, broad and low, hatches open, her bargees waiting for the ebb. The hoist itself is worked from inside, on the floor just within the river door, its rope running up and out over the beam's pulley to swing sacks down into her hold. Inside is one long floor lit by lanterns and thick with grain dust, which hangs in the light like fog. Down one side are stacked the palace's grain sacks, each stamped with the wheat-ear; down the other, new sacks stamped with a heron. Between them Hep Grist's gang are slitting, pouring and sewing, and a chute runs down through the river door to the barge. There's a heap of empty wheat-ear sacks waiting for the river, a brazier for cold hands, and a painted sign reading NO NAKED LIGHTS, which everyone ignores. Up a short stair, a glass-sided counting-box hangs over the floor, where Mister Scrope sits under a lamp with the true book open. The river runs high, fast and black under the floor, and the tide is on the turn. The bells carry across the water: at the midnight bell the Master comes, and at the second bell after it the ebb runs and the Patience, which waits for no one, casts off.\",\n  premise: \"Can the player get into the Heron, come away with proof of where the King's grain goes (the true book), and catch Master Sallow at it, before the barge sails on the ebb?\",\n  hook: \"Night, on the eve of the Assembly. The big man with the bandaged hand, Hobb Mallory, works nights for a gentleman at the Heron warehouse, at the downriver end of the wharves, and tonight a barge is loading there. If the King's 'lost' grain goes anywhere, it goes through those doors. Sergeant Kell is with you on the dark wharf.\",\n  background: [\n    \"This is the same night as the Drowned Rat and the morning at the granary where Wendell Prout was found hanged. What happened in them is in what happened just before this scene, and that wins: where Hobb is, whether Sallow has been warned, what the player carries (Prout's page, Hobb's token) and how they stand with Kell. If nothing happened before: the player knows Hobb works nights at the Heron for a gentleman, Hobb is at work on the hoist, and Sallow hasn't been warned.\",\n  ],\n  opening: \"An hour or so after the Rat, near midnight: open on the dark wharf with the Heron in view. Lantern light through the cracks with the grain dust swimming in it, the hoist swinging sacks down into the barge, Saul's brazier at the land door with Duchess snoring across the threshold, the river running high and black. Pick up from how the Rat ended: the player has come on Hobb's directions or on his heels, with his token or without. Kell is at their side, unless she took Hobb to the cells, in which case she's coming along the wharf to meet them. Don't show Master Sallow: he isn't here yet (and if Hobb ran to him from the Rat, neither is Hobb). Nobody gets a name until someone says it: describe the watchman, the dog, the forewoman and the clerk by look. End on something the player can act on: the watchman heaving himself up for his round, a knock and a token at the river door, the lamp in the counting-box window.\",\n  cast: [\n    {\n      id: \"kell\",\n      name: \"Sergeant Agnes Kell\",\n      statblock: \"guard\", weapon: \"club\",\n      look: \"Forties, in the same borrowed coat over her watch uniform that fools nobody (it's the boots). A battered oilcloth notebook and a pencil stub she sharpens with a clasp knife, a watch whistle on a cord round her neck, and a truncheon she has never been seen to draw. Stands very still and watches people's hands, even in the dark.\",\n      voice: `${KELL_VOICE} Whispers badly.`,\n      wants: \"To see it with her own eyes: a sergeant who sees the King's grain taken may arrest whoever takes it, gentleman or not, and she means to be where she can swear to it. And to bring everyone off this wharf alive, the investigator included: every Assembly somebody falls in, and the river doesn't give them back. The swearing is inside; the river is out here.\",\n      fears: \"A gentleman of the Purveyor's office walking free because a sergeant's word wasn't enough. A witness, or the investigator, in the river on her watch. A wrong name in her notebook.\",\n      knows: [\n        \"A sergeant of the watch who sees a crime done may arrest whoever does it, gentleman or not, on her own authority: by the book, out loud, with the proper words. Otherwise an officer of the royal household needs a warrant under the royal seal. She needs to see it herself, or have it sworn to by people who did.\",\n        \"Receiving the King's stolen goods is a hanging matter, and so is murder. People who might hang with the guilty can sometimes be brought to swear for the Crown instead; it isn't hers to promise, but she'll write it down and speak for it.\",\n        \"The whole watch is lining the Assembly route through the night: her whistle will bring nobody but her. And she's no sneak (watch boots, and knees that complain on ladders).\",\n        \"Whatever was said at the granary and the Rat is in her notebook, as it was said.\",\n      ],\n      secrets: [\n        \"Prout's visit three days ago, and her sending him to the palace. If it has come out, it's told, and she doesn't tell it again. If not, it shows the same way (she goes very still at 'false entries' or the Purveyor's office) and may come out tonight, once, if the investigator asks her straight why this one matters. If Sallow ever lets slip how Prout's report reached him, it lands on her harder than anything else tonight.\",\n      ],\n      attitude: `Reserved and watchful, and exactly as warm with the investigator as things stand between them; she doesn't pretend otherwise. It's their case and their night: she backs their play. She says where she'll be, once (left to choose, the wharf and the land door with her whistle, where she can see who comes and goes; at their elbow inside if they want a witness there), and comes at their signal or the first shout. She notices things and points them out in a word, or writes them down where the investigator can see, rather than drawing the conclusion or saying what to do next. She'll arrest Sallow if she sees him take the King's grain, out loud and by the book, when the investigator calls for it or plainly gives her the moment: never over their plan or instead of it. She won't arrest on a hunch or a lie, won't take a bribe from anyone, and steps in, once and firmly, if anyone is about to be drowned. ${KELL_PROMISES}`,\n    },\n    {\n      id: \"saul\",\n      name: \"Saul Tench\",\n      called: \"the old watchman\",\n      statblock: \"guard\", weapon: \"club\",\n      look: \"An old river-watchman in a greatcoat over a dozen other coats, a red muffler wound round his head over his left ear, a lantern, a rattle, and a cudgel he mostly uses to poke his brazier. At his feet, or across the land door's threshold, lies Duchess: a vast, elderly brindle mastiff with a face like a collapsed sofa, who snores, drools and has opinions about smells.\",\n      voice: \"Loud, because he can't hear himself on the left. Talks to Duchess more than to people, and answers for her ('She says you smell of sausage'). Repeats things back ('A buyer, you say?'). Ends sentences with 'and all's well', out of forty years' habit, whether it is or not.\",\n      wants: \"A quiet night by his brazier and his place kept: the Heron pays three times what the river watch did, and on loading nights nobody comes in at the land door but the Master. And, though he'd never say it, to see the Master get what's coming to him for kicking Duchess, as long as it isn't Saul who has to do it.\",\n      fears: \"Losing his place. The Master, who once kicked Duchess (she has growled at him ever since, and Saul has never forgiven him). The river: he can't swim.\",\n      knows: [\n        \"On loading nights nobody comes in at the land door but the Master, at the midnight bell; the gang come and go by the river door. Those are the Master's orders, and Saul keeps them.\",\n        \"He walks the wharf with his lantern at every bell, calling the hour, with Duchess. Between bells he sits by his brazier at the land door.\",\n        \"The gang's brass heron tokens are for the river door's grille, not his door: anyone who shows him one, he sends round along the plank walk ('River door, by the planks, and mind the slime'), and all's well.\",\n        \"Duchess knows the whole gang by smell and growls at strangers. She also growls at the Master, which Saul considers a mark of good character, and she smells his lavender a full minute before his lantern-boy comes round the corner.\",\n        \"The barge alongside is the Saltmere barge Patience, and she sails on the ebb at the second bell after midnight.\",\n        \"He saw a mill go up from grain dust and one candle in his river-watch days. His brazier stays outside.\",\n      ],\n      secrets: [\n        \"Shows: he turns his right ear to anyone talking, and nods along to anything said on his left. He's deaf as a post on that side and hides it (it's why the river watch let him go): anything said or done on his left goes past him. He trusts Duchess's nose over his own eyes: anyone she takes to, he takes to, and she takes to anyone with food and patience.\",\n        \"He knows whose grain it is (everyone on the wharf does) and minds his own business. He would much sooner be on the side of a sergeant than in front of a judge, and a sergeant who treats him as an old colleague and tells him straight what he'd be answering for has him: then he's a witness to who came and went at the land door, and when.\",\n        \"He can be bought, but not cheaply (the Heron pays him three times what the river watch did), and he'd be happier if it could be called a present for Duchess.\",\n      ],\n      attitude: \"Gruff and suspicious at the door, and garrulous once Duchess has decided you're all right. Respects a uniform and the King's name; frightened of the Master. Torn: forty years of calling 'all's well', and a land door he holds every loading night for a man who kicked his dog; it shows when the Master comes in and Duchess growls, and Saul doesn't stop her as quickly as he might. Ties here: Duchess, his best friend; the Master, whom he holds the wicket for and has never forgiven; Kell, whom he's heard of (the river watch laughed for a month about Nan Quill's door).\",\n    },\n    {\n      id: \"hep\",\n      name: \"Hepzibah Grist\",\n      called: \"the forewoman with the sack-needle\",\n      aka: [\"Hep\"],\n      statblock: \"tough\", weapon: \"dagger\",\n      group: \"Hep Grist and her re-sacking gang, six porters in grain-white with knives and sack-needles\",\n      look: \"A broad woman in a leather apron with a sack-needle stuck through her collar and a knife on a cord, floured white to the elbows, with a voice like a winch. Her gang work fast, heads down, and don't talk.\",\n      voice: \"Shouts in numbers and the gang's own cant ('Forty to the hatch! Mind that seam!'). Never uses a name if 'you' will do. Swears by the tide. 'I don't know whose it is. I know how many there are.'\",\n      wants: \"Forty more sacks down to the barge before the Master comes at the midnight bell, so he's nothing to find fault with, and the gang's double pay on the nail. And her gang, her boy Kit first, kept off the gallows, which nothing she's doing tonight will help.\",\n      fears: \"The gallows: receiving the King's grain is a hanging matter, and she knows it. The Master. Missing the tide.\",\n      knows: [\n        \"Two hundred sacks tonight, forty still to go before the Master comes at the midnight bell to see the last of them down and initial the clerk's count. The barge sails on the ebb at the second bell.\",\n        \"The palace sacks are slit, poured into heron sacks and sewn shut; the empty wheat-ear sacks go in the river at the end of the night, weighted with stones.\",\n        \"The gang is short-handed tonight (Assembly eve: half the river's drunk), and she'll put any strong pair of hands to work and ask who they are afterwards.\",\n      ],\n      secrets: [\n        \"Shows: she never says whose grain it is, and turns any question into a count; she looks at her gang, not at the Master, whenever he speaks. Torn: swearing against the Master might save the gang or hang them. Opens: proof the Master will fall (a sergeant arresting him, the true book in someone else's hands, his nerve cracking in front of her gang) and a promise she can believe that those who swear for the Crown won't hang. First: 'Gentlemen don't hang. Porters do.'\",\n        \"She knows exactly whose grain it is, and that receiving it is a hanging matter, and has never once said so out loud.\",\n        \"She skims a sack a night for the gang's families: a notch a night on the tally stick in her apron pocket, in nobody's book but hers.\",\n        \"Her gang comes before everything. To keep them off the gallows she'd swear against the Master in a heartbeat, if she believed it would work, and the gang would stand behind her.\",\n      ],\n      attitude: \"Brusque, practical and suspicious of anyone not working: anyone with a sack on their shoulder is crew until proven otherwise. Cares for her gang like a hen for her chicks, and for nobody else. Torn: a hard woman to everyone but six porters in grain-white; it shows when anyone threatens one of them, or when the King's name is put on them like a shield ('They've got children'). She doesn't fight for the Master; she fights for her gang, and only if they're threatened. Ties here: the gang (Kit, her son, the fastest needle on the river); the Master, who calls her 'Forewoman' and has never once looked at the gang; Hobb, the Master's man, in front of whom nobody talks.\",\n    },\n    {\n      id: \"scrope\",\n      name: \"Mister Lemuel Scrope\",\n      called: \"the clerk in the counting-box\",\n      statblock: \"commoner\", weapon: \"unarmed-strike\",\n      look: \"A narrow, stooped clerk in rusty black, with sleeve-guards, a green eyeshade and a pen behind each ear, up a short stair in the glass-sided counting-box over the floor. The true book, a fat ledger bound in green calf with a brass clasp, lies open under his left hand, which never leaves it.\",\n      voice: \"A dry murmur of figures. Talks in double entry ('That doesn't balance'). Apologises to the book when he blots it. Calls murder 'an irregularity', if he must call it anything. 'Forty received, forty entered. I beg your pardon,' (to the book, blotting).\",\n      wants: \"To keep the count right and the book balanced, in his own hand, tonight of all nights, and to get through the Master's visit without the Master once asking him about Wendell Prout. And, though he daren't put it in words, for somebody to make Wendell's account balance.\",\n      fears: \"The Master. A mistake in the book. Whatever happened to Wendell Prout. That once the Master has the book, he won't need the clerk.\",\n      knows: [\n        \"He keeps the Heron's books: the count, and the day book, which anyone may see and which says the grain is condemned stock lawfully sold by the Royal Purveyor's office.\",\n        \"The book under his hand is the other one, the true one, and it never leaves his hand while the Heron is working. Why it exists he'll explain to anyone who seems to understand bookkeeping, because he can't help it: the Master doesn't trust the Saltmere factor and the factor doesn't trust the Master, so both insisted on a true book kept by a clerk they both pay. There is no honour among thieves; there is bookkeeping.\",\n        \"The Master comes at the midnight bell to check the count, initial the night's page and take his share in heron pennies.\",\n      ],\n      secrets: [\n        \"Shows: his pen stops at the name Prout; he can't help correcting anyone's arithmetic, even when it's dangerous; his left hand never leaves the book. Torn: the book could hang the Master, and very likely the clerk who kept it. Opens: proof of what happened to Wendell (Wendell's own hand, the page from his boot, which Scrope knows at sight), and a way through a frightened clerk can believe in. First: 'Wendell never left a column unbalanced in his life.'\",\n        \"What's in the true book: every 'lost' King's Road wagon by its Granary Roll number and date, the sacks received in the palace's wheat-ear sacking, re-sacked under the heron, sold to the Saltmere factor by the barge-load, the price, and the Master's share, with the Master's initials, 'J.S.', on every page. And at the foot of each month, in the same careful hand: 'Hedge-folk, the usual: forty heron pennies.' He has never asked who the hedge-folk are.\",\n        \"He and Wendell Prout were apprentices together under the old Keeper of the Granary Roll forty years ago, and have played draughts every Sunday since. This morning he was told Wendell hanged himself, and he doesn't believe it. He has spent the day sick with the thought that he knows exactly why Wendell is dead, and that a man who keeps an honest book for the Master might be next.\",\n        \"At their last Sunday game Wendell asked him, out of nowhere, whether the Heron was busy at nights and whose grain it took in. Scrope said 'Saltmere's', and moved a piece, and Wendell let him win.\",\n        \"He would know Wendell's hand anywhere, and his pencilled weights: shown the page from Prout's boot, it's beyond doubt for him.\",\n      ],\n      attitude: \"Timid, punctilious and evasive; polite to everyone and frightened of most of them. The book is the one thing he'll fight for. Torn: a frightened clerk who can't leave a wrong figure alone; it shows when someone gets the arithmetic wrong in front of him (the Master included), and when anyone says Wendell's name. An argument that balances moves him; given the whole account made good, Wendell included, he closes the book, does up the clasp and holds it out in both hands. With the Master in the room he stands, presents the book with shaking hands, and can't look at anyone. Ties here: the Master, who has never asked him a thing about himself; Hep, who keeps the count right so he doesn't fuss; Wendell, who isn't here.\",\n    },\n    {\n      id: \"hobb\",\n      name: \"Big Hobb Mallory\",\n      called: \"the big porter with the bandaged hand\",\n      statblock: \"tough\", weapon: \"unarmed-strike\",\n      look: \"A dock-porter the size of a door, with a head like a bollard, a nose broken more than once and a leather porter's hood. His right hand is wrapped in a tarry rag, and he works the hoist one-handed, wincing. Where he is tonight follows from how the Drowned Rat ended: on the hoist with Hep's gang as usual; in the watch-house cells if Kell took him in (then he isn't here at all, and the gang is a man shorter); or, if he ran from the Rat to warn his master, with the Master, and he comes in at his heels at the midnight bell.\",\n      voice: \"Slow, low and polite: 'sir', 'missus', and 'Master', which he can't stop saying. Says as little as he can; when it spills, it's how he feels, not how anything works. When frightened he goes very quiet and very still, like a dray-horse in thunder.\",\n      wants: \"To get through tonight's loading without the Master looking at him. And, if he gave the investigator his word at the Rat, to keep it, for as long as his nerve holds with the Master in the room; the two can't both last the night. Underneath, to put right what he did, if anyone could show him how.\",\n      fears: \"The Master, and the river: he can't swim. The noose. His mum finding out what he did in the tally loft.\",\n      knows: [\n        \"His own part of the night: the hoist, the river door and its token, the eleventh bell, and the Master in at the land door at the midnight bell with the Crakes. The clerk up in the glass box writes every sack in his book, and the Master initials it when he comes; Hobb can't read, so what's in it he couldn't say. The rest of the Heron's business is the forewoman's and the Master's.\",\n      ],\n      secrets: [\n        \"Shows: with the Master in the room he can't look at anyone, and his bad hand shakes on the hoist rope. Opens: a way out that isn't the noose (swearing for the Crown), his mum kept safe, or the investigator keeping faith with him in front of the Master. First, if it ever comes, and to the Master's face: 'I held his arms, Master. I held his arms.'\",\n        \"The loft: last night the Master struck the clerk with his cane head and strangled him with a cord while Hobb held his arms, then had Hobb haul him up on the sack hoist to look like a suicide. The rope took the skin off his palm. 'I only held him. I only held the rope.' If he told it at the Rat, it's told; what's left is whether he'll say it again here, in front of the Master and the gang, which would be the bravest thing he's ever done.\",\n      ],\n      attitude: \"Polite, slow and closed; no fighter unless cornered, and then a door falling on you. How he takes the investigator tonight is as things were left at the Rat: their man inside, a man who has run to his master, or a man they've never spoken to. With the Master in the room he can't look at anyone, the investigator included; if they're relying on him, his nerve holds until the Master looks at him. He doesn't know what the Master means for him once the last sack is down.\",\n    },\n    {\n      id: \"sallow\",\n      name: \"Master Josiah Sallow\",\n      called: \"the gentleman with the silver-topped cane\",\n      group: \"Master Sallow, his lantern-boy and the Crake brothers, two hired river-bruisers\",\n      statblock: \"bandit-captain\", weapon: \"rapier\",\n      members: [\n        { id: \"crake-1\", name: \"the talking Crake\", statblock: \"tough\", weapon: \"club\", look: \"An enormous river-bruiser in a reefer jacket, with a cudgel and a great deal to say about it.\" },\n        { id: \"crake-2\", name: \"the silent Crake\", statblock: \"tough\", weapon: \"club\", look: \"His identical brother, who has never been heard to say anything at all.\" },\n        { id: \"lantern-boy\", name: \"the lantern-boy\", statblock: \"commoner\", weapon: \"unarmed-strike\", look: \"A yawning boy of ten with a lantern on a pole, who would very much like to be somewhere else.\" },\n      ],\n      look: \"Fifty, pink and well-fed, in a good dark coat with a fur collar, with a silver-topped cane, a wheat-ear signet ring (the Royal Purveyor's office's mark) and the soft hands of a man who signs things, except that they're very quick. He wears so much lavender water that you smell him a full minute before you see him, and he dabs at it when he's crossed. Behind him come a yawning lantern-boy and the Crakes: two enormous, identical river-bruisers, one of whom talks, mostly about their prices.\",\n      voice: \"Smooth, reasonable and faintly bored; talks like an official letter ('It has come to my attention', 'regrettably', 'in the King's interest'). Never raises his voice. Calls people by their trade ('Clerk', 'Porter', 'Sergeant'). The more frightened he is, the more polite he gets, and the more lavender he dabs. 'I never threaten anyone. I describe what will happen, in order.'\",\n      wants: \"The barge loaded and away on the ebb, tonight's page initialled and his share in his purse, with nothing on the floor he can find fault with. And the business of the clerk Prout closed for good, which since this morning means loose ends: anyone in this warehouse who could hang him is a problem to be tidied before the barge sails, as quietly as the wharf allows. He needs Hobb on the hoist and Scrope on the book until the last sack is down, which is the trouble with tidying.\",\n      fears: \"The King's attention. A scandal on the eve of the Assembly. The true book in the wrong hands. Being laughed at, or thought careless. Dogs.\",\n      knows: [\n        \"The grain, he will say, is condemned stock lawfully sold by the Royal Purveyor's office, and he has the paper to prove it: an order of sale signed 'J. Sallow, for the Royal Purveyor'. It's his own signature, and nobody has ever checked.\",\n        \"The Watch Captain files what the Purveyor's office asks him to file.\",\n        \"The Crakes' price, which the talking one will recite: a shilling to stand behind a gentleman, two to put a man down, half a crown for the river, and a shilling extra for anyone in a uniform. They're paid half before and half after, and nobody pays the second half on a lost fight. The wharves are dangerous at night, and every Assembly somebody falls in.\",\n        \"The Patience sails on the ebb at the second bell.\",\n      ],\n      secrets: [\n        \"Shows: lavender a minute before him, and more of it the more he's frightened; he finds fault with something the moment he's in (a seam, a count, a smell). Torn: he'd never admit to a crime, and he can't bear to be thought incompetent. Opens: nothing makes him confess to the murder, but get his arrangements wrong in front of him ('lost to goblins, was it? Careless of somebody'; 'the page was in his boot all along') and he corrects the record, in detail, before he can stop himself. First: 'Nothing has ever been lost on my roads through carelessness. Only through goblins.'\",\n        \"What he knows tonight follows from the day. If Prout went into the Captain's book as a murder this morning, with no granary child taken in for it, the Captain mentioned it to him at the palace, without fuss: he's wary, the Crakes walked the wharf with a lantern before he came, and there are two lanterns at the land door where there's usually one. If Hobb ran to him from the Rat, he's warned: he comes at the bell sharp and hurrying with Hobb at his heels, wants the true book sewn into oilcloth and aboard the barge before anything else, and has decided that Hobb, who panicked once, is a loose end: when the last sack is down, the Crakes are to walk him home along the wharf, by the water. If Hobb isn't at the river door when he comes (Kell took him in at the Rat), that alone makes him wary: the Crakes look along the wharf, and the loading is hurried. Otherwise he's unhurried and bored.\",\n        \"He killed Wendell Prout in the tally loft last night: a blow from the cane head, then a cord, while Hobb held the clerk's arms. Then Hobb hoisted him for a suicide, a granary girl was paid a crown to swear she saw him jump, and the Captain closed it. He will never admit it, except to someone he believes is about to die.\",\n        \"If Kell says Prout went through the proper channels, his pride answers before his sense does: 'He did, Sergeant. I am the proper channels.' (Prout wrote to the Royal Purveyor, and Sallow opens the Royal Purveyor's letters.)\",\n        \"The racket: King's Road grain wagons that he writes off in the Granary Roll as 'lost to goblins' come here to be re-sacked under the Saltmere factor's heron and sold downriver. He pays the hedge-goblins in the factor's heron pennies to keep the goblin story true.\",\n        \"The true book is the one thing that can hang him, and he lets it exist only because the factor won't deal without it. Cornered with it, he'd sooner put it in the brazier or the river than see it taken.\",\n        \"The silver-topped cane is a sword-cane, and thirty years ago he fenced for prizes, and won them. Nobody at the Heron has ever seen it drawn.\",\n      ],\n      attitude: \"Courteous, superior and unhurried, as if everyone were a junior clerk who has made an error. Faced with trouble he tries his office first (papers, titles, the Captain's name), then money (heron pennies, a post in the Purveyor's office), then the Crakes and the river. Porters, clerks, children and watchmen are furniture to him until they become a problem: someone with a sack on their shoulder he doesn't see at all, and a bluff that comes with the right paper he'll swallow. He doesn't fight while he has people to fight for him. Cornered with proof in front of witnesses he can't buy, he draws the sword from his cane, sets the Crakes on whoever holds the proof, and fights from behind them: a fencer's lunge past a Crake's shoulder at whoever is busy with the Crake, never a fair fight if he can help it. If his Crakes go down and the land door is clear, he remembers an urgent appointment and runs for it. Cornered, or with a blade at his throat, he drops the sword, asks very politely to surrender, and starts at once on terms: his rank, the King's interest, a fair hearing, and an account of 'irregularities' in which everyone else is to blame (the goblins, the dead clerk, the factor, the porter, the Captain). He never admits the murder.\",\n      enters: \"midnight\",\n    },\n  ],\n  start: \"wharf\",\n  beats: [\n    {\n      id: \"wharf\",\n      title: \"The Heron by night\",\n      direction: \"The player is outside the Heron on the dark wharf, and nobody inside knows they're here. This beat is for looking and choosing how to go in. Answer questions about the outside concretely and generously: the land door with Saul, his brazier and Duchess; the plank walk along the piles to the river door and its grille; the barge alongside and the hoist swinging sacks into her; the gang glimpsed through the river door, slitting sacks; the lamp in the counting-box window; the tide on the turn. Kell works out with the player where she's most use. Preparations the player makes should pay off in position and surprise, and a diversion (a noise down the wharf, a barge line slipped, something for Duchess to chase) can draw Saul or the gang away for a moment; a naked flame anywhere near the grain dust is a very bad idea, and everyone at the Heron knows it. Getting in is a real edge, but there are several doors into it, and some need no dice: Hobb's token at the river door, Hobb himself if he's on their side, or a sack on the shoulder and a place in Hep's short-handed gang.\",\n      cast: {\n        saul: \"You want a quiet night: mind the land door, talk to Duchess, and get up at the bell to walk the wharf with your lantern.\",\n        kell: \"Say where you'll be, once: left to choose, out here on the wharf with your whistle, where you can see who comes and goes; at the investigator's elbow if they want a witness inside.\",\n        hep: \"You want hands and the count: drive the gang, and shout for help at the river door.\",\n        hobb: \"If you're here, you're on the hoist. If you agreed at the Rat to let them in, you're listening for their knock.\",\n      },\n      pressure: \"Saul heaves himself up for his round and comes along the wharf with his lantern and Duchess, straight towards wherever the player is standing. Or a sack splits on the hoist and spills grain across the wharf at the player's feet, the wheat-ear stamp plain on the torn sacking.\",\n      transitions: [\n        { id: \"inside\", when: \"The player is inside the Heron, unnoticed or taken for someone who belongs there (in at the river door with Hobb's token or his help, past Saul, as a hand in Hep's gang, or any other way established in play).\", to: \"floor\" },\n        {\n          id: \"sneak-in\", on: \"attempt\",\n          when: \"The player tries to slip into the Heron unseen: past Saul's deaf side and the sleeping dog, or along the plank walk and in at the river door while the gang's backs are turned. (Walking in with a sack on their shoulder, as one of the gang, isn't slipping in unseen: that's going in to work, with no dice.)\",\n          check: { reason: \"to slip into the Heron unseen\",\n            skill: \"stealth\", dc: 13,\n            success: \"They're in, in the shadow of the wheat-ear stacks, with the whole floor in front of them and nobody the wiser.\",\n            failure: \"Something gives them away (a plank that creaks, a dog that wasn't asleep, a porter who looks round at the wrong moment) and the alarm goes up. They're not caught yet, but the wharf is looking for them.\",\n            onSuccess: \"floor\",\n          },\n        },\n        {\n          id: \"show-token\", on: \"attempt\",\n          when: \"The player shows a brass heron token (Hobb's, or one like it) at the river door's grille to be let in, with or without a story to go with it. No dice: the token is what the gang show, so whoever's nearest inside draws the bolt, looks them over ('You're not Hobb'), and pushes a sack into their arms, because Hep is short of hands: they're in as one of her hands, and working the floor needs no roll. A story told with the token isn't a bluff to roll for.\",\n          to: \"floor\", establishes: [HAND],\n        },\n        {\n          id: \"taken-on\", on: \"attempt\",\n          when: \"The player goes in to work, token or none: shoulders a sack (one waiting on the plank walk, a split one off the hoist) and walks in at the river door with the gang as if they belong, or answers Hep's shout for hands at the river door, or asks there to be taken on for the night, or knocks at the grille for Hobb if he agreed at the Rat to let them in. No dice: Hep is short-handed on the Assembly eve (half the river's drunk) and anyone with a sack on their shoulder is crew until proven otherwise, so she puts them to work and asks who they are afterwards, if ever: they're in as one of her hands, and working the floor needs no roll. A story told with it isn't a bluff to roll for.\",\n          to: \"floor\", establishes: [HAND],\n        },\n        {\n          id: \"talk-past\", on: \"attempt\",\n          when: \"With no heron token to show, the player tries to bluff their way in past Saul or whoever answers the river door with a story that isn't true: the Saltmere factor's man, someone sent by the Master, a hand that somebody sent for when nobody did. (Showing Hobb's token at the grille, and going in to work with a sack on their shoulder or at Hep's shout for hands, are ways in of their own with no dice, whatever story goes with them: they aren't this.)\",\n          check: { reason: \"to talk your way into the Heron\",\n            skill: \"deception\", dc: 13,\n            success: \"Whoever's at the door believes it and stands aside. They're in, and expected to behave like whoever they said they were.\",\n            failure: \"It doesn't wash. The door stays shut, and whoever was at it is now watching the wharf for them; the next way in will have to be a different one.\",\n            onSuccess: \"floor\",\n          },\n        },\n        {\n          id: \"win-duchess\", on: \"attempt\",\n          when: \"The player tries to make friends with Duchess before she raises the wharf: food, patience, a way with dogs.\",\n          check: { reason: \"to win Duchess over before she raises the wharf\",\n            skill: \"animal_handling\", dc: 12,\n            success: \"Duchess decides they're the best thing that's happened to her all night and leans her whole weight on them. Saul, who trusts her nose over his own eyes, unbends: anyone she likes can't be all bad, and all's well.\",\n            failure: \"Duchess takes the offering, and very nearly the hand with it, and sets up a baying fit to wake the river. Saul is on his feet with the lantern, staring hard into the dark.\",\n            onSuccess: \"wharf\",\n          },\n        },\n        {\n          id: \"river-way\", on: \"attempt\",\n          when: \"The player tries to get in from the river side the hard way: along the piles under the floor, up the hoist rope, or across the barge and in through the loading door.\",\n          check: { reason: \"to climb into the Heron from the river side\",\n            skill: \"athletics\", dc: 14,\n            success: \"Cold, wet to the knees and very quiet, they come up through the river door in the shadow of the chute, and nobody looks round.\",\n            failure: \"A pile is slimed with weed, or the hoist swings: they go into the river to the chest, and the cold drives the breath out of them. They're clinging to a pile under the floor, unseen for now, with Duchess barking somewhere overhead.\",\n            onSuccess: \"floor\",\n          },\n        },\n        { id: \"master-comes\", on: \"cue\", when: \"The player has been out on the wharf a long while (at least six exchanges at this point) without getting in, or is waiting to see who comes: the midnight bell, a smell of lavender along the wharf, and the Master arrives at the land door.\", to: \"midnight\", establishes: [MASTER_HERE] },\n      ],\n    },\n    {\n      id: \"floor\",\n      title: \"The re-sacking floor\",\n      direction: \"The player is inside the Heron. The proof is in plain sight: the gang slitting the palace's wheat-ear sacks and pouring the King's grain into heron sacks, the chute down to the barge, the heap of empties waiting for the river, and Mister Scrope up in his counting-box entering every sack in the true book. This beat is for getting proof: seeing it, taking the book, or finding people who'd swear to it. Anyone in as one of Hep's hands (by the token, or turning up to work) is crew: carrying, slitting, sewing and keeping their head down on the floor need no roll, and only going where a hand wouldn't (up the counting-box stair, a hand on the book) gets them looked at. Anyone who isn't gang and gets noticed is challenged, and Hep, Scrope and the gang react as they would. Hobb, if he's here, is on the hoist and can't look at anyone. The clock is the midnight bell: Hep wants the count done before the Master comes, and Scrope keeps looking at the land door.\",\n      cast: {\n        hep: \"You want forty more sacks down before the bell. Put idle hands to work, and challenge anyone who won't take a sack.\",\n        scrope: \"Count, enter, blot, apologise. Keep your hand on the book.\",\n        hobb: \"If you're here, work the hoist one-handed and don't look at the player.\",\n        kell: \"If you're inside, watch and remember. If you're on the wharf, keep it.\",\n        saul: \"Keep the land door, and get up at the bell.\",\n      },\n      pressure: \"Hep bellows the count: forty to go before the Master. Scrope wipes his pen and looks at the land door. One of the gang, a sack on his shoulder, stops and looks at the player for a long moment.\",\n      transitions: [\n        bookInHand(\"floor\"), bookRead(\"floor\"),\n        {\n          id: \"lift-book\", on: \"attempt\",\n          when: \"The player tries to lift the true book from under Scrope's hand without him or the gang seeing.\",\n          check: { reason: \"to lift the ledger from under the clerk's hand\",\n            skill: \"sleight_of_hand\", dc: 15,\n            success: \"Scrope turns to trim the lamp, and when he turns back his hand comes down on bare desk. The book is under the player's coat.\",\n            failure: \"Scrope's hand clamps down on the book with a squeak like a trodden mouse, and heads turn all over the floor.\",\n            onSuccess: \"floor\",\n          },\n        },\n        {\n          id: \"win-scrope\", on: \"attempt\",\n          when: \"The player tries to persuade Scrope to give them the true book or to swear to it (for Prout's sake, for his own neck, for the King), where his terror of the Master could still win. (Proof that puts it beyond doubt for him needs no dice.)\",\n          check: { reason: \"to persuade the clerk to give up his ledger\",\n            skill: \"persuasion\", dc: 14,\n            success: \"Scrope looks at the book for a long time, then closes it, does up the clasp and holds it out in both hands. 'It balances,' he says. 'Every page. Wendell would want it to balance.'\",\n            failure: \"Scrope hugs the book to his chest and shakes his head, white as paper: not with the Master coming. He hasn't called for anyone. Yet.\",\n            onSuccess: \"floor\",\n          },\n        },\n        {\n          id: \"talk-down\", on: \"attempt\",\n          when: \"Challenged on the floor (by Hep, the gang or Scrope), the player tries to bluff that they belong here.\",\n          check: { reason: \"to bluff your way through a challenge on the floor\",\n            skill: \"deception\", dc: 13,\n            success: \"Whoever challenged them grunts, satisfied, and goes back to work.\",\n            failure: \"Nobody believes a word. Hep shouts for hands, and the gang put their sacks down.\",\n            onSuccess: \"floor\",\n          },\n        },\n        { id: \"seized\", when: \"The player has been caught out on the floor and is being held (by Hep's gang, Saul or Hobb) to wait for the Master.\", to: \"midnight\", establishes: [MASTER_HERE] },\n        fight,\n        { id: \"master-comes\", on: \"cue\", when: \"The player has been inside a good while (at least five exchanges at this point), or has said they're waiting for the Master himself (hiding to see who comes in at the bell, with nothing else in hand): the midnight bell, lavender on the air, and the Master comes in at the land door. A player carrying sacks and keeping their head down while they wait for a word with Hobb, a look at the book or a chance at it isn't waiting for the Master: they're working the floor, and the floor gets its exchanges.\", to: \"midnight\", establishes: [MASTER_HERE] },\n      ],\n    },\n    {\n      id: \"midnight\",\n      title: \"The Master comes\",\n      direction: \"Master Sallow is here, a minute behind his lavender, with his lantern-boy and the Crakes: in at the land door to see the last sacks down, take his share and initial tonight's page in the true book. Everything on the floor changes: the gang work faster and quieter, Scrope stands, Saul holds the door, Duchess growls, and Hobb (if he's here) can't look at anyone. If he has been warned, he's sharp and hurried, wants the book aboard the barge, and has the Crakes look along the wharf. If he finds the player held, or finds them at all, he deals with them his way: his office first, then money, then the Crakes and the river. This is the climax: hide and watch him sign, catch him in the act before witnesses who'll swear (Kell, Hep's gang, Scrope, Hobb), take the book from under his nose, bluff him, or be caught by him. The barge goes at the second bell, whoever has said what.\",\n      cast: {\n        sallow: \"You want the barge loaded, the page initialled and your share in your purse. Find fault with something, then climb to the counting-box and initial tonight's page at Scrope's desk, in front of whoever is on the floor. If you find intruders: papers, then money, then the Crakes. Keep the book out of their hands. Exposed in front of witnesses you can't buy, with a sergeant saying the words of arrest and your Crakes still at your side, you don't come quietly: the sword comes out of the cane, and you set the Crakes on them.\",\n        kell: \"This is the investigator's case and their moment: back their play. You can arrest Sallow if you see him take the King's grain, by the book and out loud, and you will when the investigator calls for it or plainly gives you the moment; never over their plan or instead of it. If they mean to slip away with the proof, go with them. If you're on the wharf, come at their signal or the first shout.\",\n        hep: \"Keep the gang working and your head down, and watch who looks likeliest to keep your gang off the gallows.\",\n        scrope: \"Present the book to the Master with shaking hands.\",\n        hobb: \"If you're here, you can't look at the Master, or at the player.\",\n        saul: \"Hold the land door for the Master, and keep Duchess off his ankles.\",\n      },\n      pressure: \"If he hasn't yet, Sallow climbs to the counting-box: Scrope presents the book with shaking hands, and Sallow initials tonight's page and counts his heron pennies into his purse, in plain view of the floor (the moment to catch him at it, for anyone who means to). Then he takes out his watch: the ebb won't wait. He orders the last sacks down and the hatches battened, and out on the river the bargees start singling up their lines.\",\n      transitions: [\n        {\n          id: \"in-the-act\",\n          when: \"Sallow has been caught at the loading of the King's grain before witnesses who will swear to it (Kell, Hep's gang, Scrope, Hobb or the player), Kell has arrested him, and he is actually held: he has given himself up (the cane handed over, his hands up) or been beaten or overpowered, and his Crakes have stood down or been dealt with. The words of arrest alone, with Sallow defiant and his Crakes still beside him, aren't this: that is the moment he draws.\",\n          to: \"caught-in-the-act\",\n        },\n        bookInHand(\"midnight\"), bookRead(\"midnight\"),\n        { id: \"book-gone\", when: \"The true book has been destroyed: thrown in the brazier and burned, or gone into the river.\", to: \"midnight\", establishes: [BOOK_GONE] },\n        {\n          id: \"bluff-sallow\", on: \"attempt\",\n          when: \"The player tries to fool Sallow to his face: passing as the Saltmere factor's agent, a buyer, someone sent from the palace, or one of the gang.\",\n          check: { reason: \"to fool Master Sallow\",\n            skill: \"deception\", dc: 15,\n            success: \"Sallow believes it, for now, and treats them as what they claimed to be: he may even initial the page in front of them, or hand them the book to admire.\",\n            failure: \"Sallow smiles thinly: he knows a liar, having been one professionally for years. 'Crake,' he says, and both of them move.\",\n            onSuccess: \"midnight\",\n          },\n        },\n        {\n          id: \"face-down\", on: \"attempt\",\n          when: \"The player confronts Sallow in front of his own people to break his nerve: naming the murder, the grain, the proof, the gallows.\",\n          check: { reason: \"to break Sallow's nerve in front of his own people\",\n            skill: \"intimidation\", dc: 15,\n            success: \"The courtesy cracks. Sallow goes the colour of tallow and offers money too fast, and his own people see it: the gang stop working, and the Crakes look at each other.\",\n            failure: \"Sallow hears them out with polite boredom, then says, 'Regrettably, the wharves are dangerous at night,' and the Crakes start forward.\",\n            onSuccess: \"midnight\",\n          },\n        },\n        {\n          id: \"turn-witnesses\", on: \"attempt\",\n          when: \"The player tries to turn Hep and her gang, Scrope or Hobb against the Master in front of him, so that they'll swear to what they've seen.\",\n          check: { reason: \"to turn the Master's own people against him\",\n            skill: \"persuasion\", dc: 14,\n            success: \"Hep looks at her gang, then at the Master, and puts down her knife. 'We'll swear,' she says. 'All of us. For them.' One by one, the gang stand behind her.\",\n            failure: \"Nobody moves: for now they're more frightened of him than of the gallows. Sallow smiles.\",\n            onSuccess: \"midnight\",\n          },\n        },\n        {\n          id: \"snatch-book\", on: \"attempt\",\n          when: \"The player makes a grab for the true book while Sallow or the Crakes have it, or as it goes towards the brazier, the river or the barge.\",\n          check: { reason: \"to snatch the true book before it's lost\",\n            skill: \"acrobatics\", dc: 14,\n            success: \"They have it, singed or wet but whole, and everyone in the Heron is looking at them.\",\n            failure: \"Sallow is quicker than he looks: the book goes into the brazier, over the side or down the chute, and it's going fast.\",\n            onSuccess: \"midnight\",\n          },\n        },\n        { id: \"overpowered\", when: \"The player has been overpowered and thrown in the river, or shut up somewhere in the Heron, by the Crakes or the gang, and nobody has got them out.\", to: \"caught\" },\n        { id: \"cornered\", on: \"outcome\", when: \"Sallow, exposed with proof in front of witnesses he can't buy, has drawn the sword from his cane and set the Crakes on the player: blades are out and the fight has started.\", to: \"fight\" },\n        fight,\n        { id: \"cast-off\", on: \"cue\", when: \"The Master has been here a good while (at least six exchanges at this point), or the player is hiding or dithering with nothing in hand and nothing they're waiting for: the second bell, the last sacks go down, and the barge casts off on the ebb with the King's grain aboard. A player waiting for a moment they've named (the Master at the book to initial the page, a chance at the book, the moment to signal Kell) isn't dithering: that moment comes first.\", to: \"barge-sails\" },\n      ],\n    },\n  ],\n  anytime: [\n    { id: \"away-with-book\", on: \"attempt\", when: \"The player leaves the Heron with the true book in their hands (out of a door, off the wharf, or over the side into the dark) and nobody is holding them.\", to: \"proof-taken\" },\n    { id: \"ablaze\", when: \"Fire has taken hold of the Heron: a naked light in the grain dust, a brazier knocked over, a diversion got out of hand.\", to: \"up-in-smoke\", establishes: [FIRE] },\n    { id: \"sunk\", when: \"The barge is going down with the King's grain in her: holed, swamped, or cut loose and swept onto the piers.\", to: \"up-in-smoke\", establishes: [SUNK] },\n    { id: \"give-up\", on: \"attempt\", when: \"The player gives up and leaves the wharf without the proof, leaving the Heron to its night's work.\", to: \"barge-sails\" },\n  ],\n  exits: [\n    {\n      id: \"proof-taken\", kind: \"progress\", title: \"Out with the true book\",\n      next: \"kings-morning\",\n      outcome: \"The player has got out of the Heron alive with the true book: every 'lost' wagon by its Granary Roll number, with Sallow's initials on every page. Whatever becomes of the barge, the proof is in their hands.\",\n      closing: \"Close on the player in the dark with the book under their arm: the Heron's lanterns behind them, the river running, and whoever is with them. Let Kell read one page by whatever light there is and say something dry that is very nearly triumph.\",\n      script: (world, outcome) => {\n        world.player.addItem(world.newReadable(trueBookItem));\n        world.setFlag(\"true_book\", \"taken\");\n        world.quest(\"heron-ledger\").complete(\"Came out of the Heron warehouse with its true book.\");\n        world.quest(\"purveyors-man\").advance(\"proof\", \"The Heron's true book, initialled 'J.S.' on every page, ties Master Sallow to the King's 'lost' grain. The case can go to the King.\");\n        world.character(\"kell\").remember(\"The investigator came out of the Heron with the true book: every 'lost' wagon, initialled J.S.\");\n        if (has(outcome.established, MASTER_HERE)) world.character(\"sallow\").remember(\"The King's investigator walked out of the Heron with the true book.\");\n        world.journal(\"We have the Heron's true book. Every page is initialled J.S.\");\n      },\n    },\n    {\n      id: \"caught-in-the-act\", kind: \"progress\", title: \"Caught in the act\",\n      next: \"kings-morning\",\n      outcome: \"Master Sallow has been caught at the Heron with the King's grain, before witnesses who'll swear to it, and Kell has arrested him (or he's being held for her) for theft from the Crown, and for Prout's murder if the proof will stretch that far.\",\n      closing: \"Close on the arrest done by the book: Kell's proper words, Sallow's courtesy curdling into threats, the gang watching, Duchess growling at his ankles, the lavender. Land it on the player.\",\n      script: (world, outcome) => {\n        const sallow = world.character(\"sallow\");\n        sallow.moveTo(\"watch-house\");\n        sallow.setAttitude(\"hostile\", \"Caught at the Heron with the King's grain by the King's investigator and a sergeant of the watch.\");\n        world.character(\"kell\").remember(\"She arrested Master Josiah Sallow at the Heron warehouse, caught with the King's grain.\");\n        keepBook(world, outcome);\n        bookFlag(world, outcome);\n        world.quest(\"purveyors-man\").advance(\"sallow_arrested\", \"Master Sallow was caught at the Heron warehouse with the King's grain, and Sergeant Kell arrested him.\");\n        world.quest(\"heron-ledger\").complete(\"Caught Master Sallow at the Heron with the King's grain.\");\n        world.journal(\"We caught Sallow at the Heron with the King's grain, and Kell arrested him.\");\n      },\n    },\n    {\n      id: \"caught\", kind: \"other\", title: \"The wharves are dangerous at night\",\n      next: \"kings-morning\",\n      outcome: \"The player was caught at the Heron and has been thrown in the river or locked up in the warehouse by the Master's people, and the night's work goes on without them. They're alive, and they keep what they saw, and anything the Crakes didn't find on them.\",\n      closing: \"Close on the cold: the black river closing over their head and the wharf lights sliding away, or a bolted door, grain dust settling and the sound of hatches going on. Leave them one thread to pull another night: something seen, something held, something overheard.\",\n      script: (world, outcome) => {\n        const sallow = world.character(\"sallow\");\n        sallow.setAttitude(\"hostile\", \"The King's investigator got into the Heron and saw too much.\");\n        sallow.remember(\"He had the King's investigator thrown out of the Heron the hard way.\");\n        bookFlag(world, outcome, { lostIfCaught: true });\n        world.quest(\"heron-ledger\").advance(\"caught\", \"Caught at the Heron by Master Sallow's men and got rid of the hard way.\");\n        world.journal(\"Caught at the Heron. We're alive, which is something.\");\n      },\n    },\n    {\n      id: \"up-in-smoke\", kind: \"other\", title: \"Up in smoke\",\n      next: \"kings-morning\",\n      outcome: \"The Heron is burning (grain dust goes up like gunpowder) or the barge has gone down with the King's grain in her. Whatever the player didn't carry out is gone, the whole waterfront is awake, and on the eve of the Assembly somebody is going to have to explain it.\",\n      closing: \"Close on the spectacle, played absolutely straight: the light on the water, the bells, bargees swearing in Saltmere, Saul hauling Duchess clear, the Master's lavender lost in the smoke. Kell, soot on her notebook, says what she'll have to write.\",\n      script: (world, outcome) => {\n        if (has(outcome.established, FIRE)) {\n          world.place({ asset: world.assets.get(\"smoke-plume\"), at: world.anchor(\"heron-floor\") });\n          world.unsupported(\"The Heron warehouse burned down on the eve of the Assembly, with the King's grain in it.\");\n        }\n        if (has(outcome.established, SUNK)) world.unsupported(\"The Saltmere barge Patience sank at the Heron's wharf with the King's grain in her.\");\n        keepBook(world, outcome);\n        world.setFlag(\"true_book\", bookSaved(outcome) ? \"taken\" : \"burned\");\n        world.character(\"kell\").remember(\"The Heron went up in smoke (or its barge went down) on the eve of the Assembly, with the investigator in the middle of it. She'll have to write it up.\");\n        if (bookSaved(outcome)) world.quest(\"heron-ledger\").advance(\"up_in_smoke\", \"The Heron's grain is gone, but the true book came out with us.\");\n        else world.quest(\"heron-ledger\").fail(\"The Heron's grain and its true book went up in smoke or down in the river.\");\n        world.journal(\"The Heron's night ended in fire and water, and all Caerwyn saw it.\");\n      },\n    },\n    {\n      id: \"barge-sails\", kind: \"leave\", title: \"The barge sails\",\n      next: \"kings-morning\",\n      outcome: \"The Patience has cast off on the ebb with the King's grain aboard (and anything Sallow sent with her), and is away downriver into the dark. By morning the Heron will be swept and empty. Whatever the player holds, they hold; the rest is gone.\",\n      closing: \"Close on the barge's stern lantern dwindling down the black river, the bargees singing, and the Heron's doors swinging shut. Let Kell say one dry thing, and leave the player on the wharf with whatever they have.\",\n      script: (world, outcome) => {\n        keepBook(world, outcome);\n        bookFlag(world, outcome);\n        if (!bookSaved(outcome)) world.quest(\"heron-ledger\").fail(\"The Patience sailed with the King's grain before we could stop her.\");\n        world.journal(\"The Patience sailed on the ebb with the King's grain aboard.\");\n      },\n    },\n    {\n      id: \"fight\", kind: \"combat\", title: \"Roll for initiative\",\n      next: \"kings-morning\",\n      outcome: \"A fight breaks out in the Heron between the player (and Kell, if she's with them) and whoever is on the floor to fight them: Master Sallow with his sword-cane and the Crakes, if he has come; if he hasn't come yet, Hep and her gang, with their knives and sack-needles, and Sallow and the Crakes aren't in it. It's in the grain dust and the swinging lantern light.\",\n      closing: \"Close on the moment the fight breaks out, with whoever is on the floor to fight it. If Master Sallow has come (he's here, a minute behind his lavender), his cane slides apart into a thin bright sword and the Crakes roll their shoulders. If he hasn't come yet, he isn't in this and doesn't come in now: Hep's gang put down their sacks and come with their knives and sack-needles, Hep bellowing them on. Either way: the dust in the lantern light, the lanterns swinging dangerously close to it, and anyone with any sense stepping smartly out of the way. End with 'Roll for initiative!'\",\n      script: (world, outcome) => {\n        world.startCombat({\n          enemies: has(outcome.established, MASTER_HERE)\n            ? [{ asset: world.assets.get(\"bandit\"), count: 2, leader: \"sallow\" }]\n            : [{ asset: world.assets.get(\"bandit\"), count: 6, leader: \"hep\" }],\n          allies: [\"kell\"],\n          at: world.anchor(\"heron-floor\"),\n        });\n      },\n    },\n  ],\n  essentials: [\n    {\n      id: \"way-in\",\n      what: \"There's a way into the Heron without a key: the river door opens to anyone who shows a brass heron token at its grille; Saul at the land door is deaf on his left side and takes to whoever Duchess takes to; and Hep's gang is short-handed and puts anyone carrying a sack to work.\",\n      placedWith: [\"Hobb's token, or Hobb himself\", \"Saul and Duchess at the land door\", \"Hep shouting for hands at the river door\"],\n      carriers: [\"hobb\", \"saul\", \"hep\"],\n      unlocks: \"getting inside\",\n    },\n    {\n      id: \"kings-grain\",\n      what: \"The Heron's grain is the King's: the gang are slitting sacks stamped with the palace wheat-ear and pouring them into heron sacks, and the empties are waiting to go in the river weighted with stones.\",\n      placedWith: [\"the re-sacking floor\", \"the heap of empty wheat-ear sacks\", \"a sack split on the hoist\"],\n      carriers: [\"hep\", \"hobb\"],\n      unlocks: \"proof in plain sight, and witnesses who've handled it\",\n    },\n    {\n      id: \"true-book\",\n      what: \"Mister Scrope's true book, up in the counting-box, records every 'lost' wagon by its Granary Roll number with Sallow's initials on every page, and the Master comes at the midnight bell to initial tonight's.\",\n      placedWith: [\"Scrope in his counting-box\", \"Hep, who wants the count right before the Master comes\", \"Hobb\", \"Saul, who must have the land door open for the Master at the bell\"],\n      carriers: [\"scrope\", \"hep\", \"hobb\", \"saul\"],\n      unlocks: \"the proof, and the moment to catch Sallow in the act\",\n    },\n  ],\n  limits: [\n    \"More help (constables, the river watch, the Watch Captain, the palace guard): the whole watch is lining the Assembly route through the night, and the Captain files what the Purveyor's office asks him to file. Kell's whistle brings Kell. The help here is Kell, and whoever at the Heron can be turned.\",\n    \"A warrant, a search order or anything in writing from the King: the palace is shut for the Assembly eve, and the King signs nothing that might upset anyone. What there is, is a sergeant who may arrest anyone she sees committing a crime.\",\n    \"Another way into the Heron (a secret passage, a cellar, the roof): there's the land door, the river door and the loading hatch over the barge, and that's all. The roof is steep wet slate with no way in, and under the floor there's only the river.\",\n    \"Holding the barge in port by law (harbour dues, an impound order, the harbourmaster): the harbourmaster's office is shut for the Assembly, and the bargees have a bill of lading from the Heron that says 'condemned grain, lawfully sold'. Stopping the barge means stopping it with hands.\",\n    \"The bargees (Saltmere river-folk aboard the Patience): they speak little Caerwyn, care about the tide and nothing else, and won't hold it for anyone. They don't know or care whose grain it is.\",\n    \"The Saltmere factor who buys the grain: he never comes to Caerwyn. The heron mark is his, and that's all there is of him tonight.\",\n    \"Following the barge once she's gone (a boat, the towpath): there's no boat to be had on the wharves on Assembly eve, and the towpath ends at the city wall. Once the Patience is out on the ebb, she's gone.\",\n    \"Coming back tomorrow: the barge sails on the ebb at the second bell, and by morning the Heron will be swept and empty and the docks will be shut for the procession. It happens tonight or not at all.\",\n  ],\n  anchors: [\"wharf\", \"land-door\", \"sentry-box\", \"plank-walk\", \"river-door\", \"heron-floor\", \"counting-box\", \"chute\", \"hoist\", \"barge\", \"river\"],\n  lore: [\"Places/Heron Warehouse.md\", \"World/Caerwyn now.md\"],\n  fronts: \"World/Fronts.md\",\n  assumes: [\n    \"Tonight's loading at the Heron is still going on: the barge hasn't sailed or been stopped, and the true book is still in the Heron.\",\n    \"Master Sallow is still free (not arrested, not fled the city) and still coming to the Heron at the midnight bell. (The player suspecting him, or even naming him to the watch, doesn't change that: only his arrest or flight does.)\",\n  ],\n  overtaken: \"kings-morning\",\n  world: heronWorld,\n};\n",
      "scenes/hanged-clerk.ts": "import type { Scene, Transition } from \"../src/runtime/scene.ts\";\nimport { hangedClerkWorld } from \"./worlds/hanged-clerk.ts\";\n\n/**\n * Disco Elysium's hanged man's yard (Cuno, Cunoesse, Kim) moved behind the King's Granary in\n * Caerwyn (docs/research/scene-sources.md §5.6, §7.3). An investigation with a hostile witness and a\n * partner: two foul-mouthed granary kids who know more than they let on, and a dry watch sergeant\n * who steers without solving it. The Watch Captain has already called it suicide, and the dead-cart\n * comes at noon.\n *\n * The truth is spread across the cast (actors see the setting and limits, so those stay public),\n * and every conclusion has several carriers (the Three Clue Rule):\n * - Not suicide: the body up close (Kell's eye), a drop that could only have been from a loft door\n *   barred on the inside, the loft itself (through Cob's gap), the scraped heels of Prout's boots\n *   (on Cob's feet), Moll's paid story falling apart, Cob's account of the night.\n * - Why: the page sewn into the boot, the Granary Roll's 'lost to goblins' entries, what Prout asked\n *   Kell three days ago.\n * - Who: the page's countersign, Moll's paymaster, Cob's 'Silvertop', the Roll, Tull's order.\n * Endings: the case made (naming Sallow), murder by persons unknown, a child wrongly taken in (only\n * after Kell has pushed back), filed as a suicide, or walking away. Hooks for later scenes: the\n * wheat-ear stamp on the purveyance silver, and Prout's \"Who pays the hedge-folk?\".\n *\n * The page in the boot has ways in of its own, and Cob is the same boy about his boots here as in the\n * Drowned Rat, where the page goes on if it's missed here: they're his and he'll never give them up;\n * coin or food offered as the price of a look is a bribe, and gets haggling; a kindness with nothing\n * asked back counts towards trust; asked politely, the boots staying his, it could go either way (a\n * roll); and for someone he trusts, or a promise that answers his fear (his name kept out of it,\n * nothing to the watch, the men from the loft kept off him), he holds the boot out himself, and tells\n * what he heard with no dice.\n */\n\nconst NOT_SUICIDE = \"Prout didn't hang himself: what has been found shows he was killed and then hoisted up to look like a suicide.\";\nconst PAGE = \"Sewn into the lining of Prout's left boot was a page razored from the Royal Granary Roll: a dozen grain wagons for the King's Road this past month marked 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor', with Prout's pencilled note beside each of what the same wagon weighed at the river warehouses two days later, and at the foot: 'Not goblins. Who pays the hedge-folk?'\";\nconst KIND = \"Cob has had a kindness from the player with nothing asked back (something to eat, or a dinner stood him freely): it counts with him.\";\nconst COB_TAKEN = \"Cob was taken in for Prout's murder.\";\nconst MOLL_TAKEN = \"Moll was taken in for Prout's murder.\";\n\nconst has = (facts: string[], fact: string) => facts.includes(fact);\n\n/** Kell's one voice line, shared by every scene she's in (her private.md holds the rest). */\nexport const KELL_VOICE = \"Dry, calm and sparing: short sentences, and 'Noted.' only when something goes in the notebook. Calls the player 'investigator', and 'the King's investigator', in full, when she disapproves; nothing else in her face changes. Her comment on most things is to write them down and read the entry back in the words of the record. 'That's a theory, investigator. I can't arrest a theory.' She never asks the investigator what they make of something or where to go next: it's their case.\";\n\n/**\n * Kell and a promise made in her hearing, shared by every card she has: she keeps it. A name promised\n * out of it she still knows (the GM knows it too); what she keeps it out of is her notebook and what\n * she swears to.\n */\nexport const KELL_PROMISES = \"A promise made in her hearing, her own or the investigator's, she keeps, and holds others to. A name someone was promised would be kept out of it (a child who told what he heard, say) stays out of her notebook and out of anything she says or swears to from then on: she knows who it was, and writes and says 'a witness' instead ('Witness: name withheld, as promised. Noted.'), and says why if she's asked.\";\n/** The page as an item the player can carry and read (the exit scripts', and the Rat's, if it comes out there). */\nexport const pageItem = {\n  id: \"prout-ledger-page\",\n  name: \"Page from the Royal Granary Roll\",\n  content: \"A dozen grain wagons for the King's Road this past month, each marked 'lost to goblins' and countersigned 'J. Sallow, for the Royal Purveyor'. Beside each, in Prout's small pencil, what the same wagon weighed at the river warehouses two days later. At the foot, underlined: 'Not goblins. Who pays the hedge-folk?'\",\n};\n\n// The boot's ways in, each a route of its own so the decider can tell them apart: what brings the\n// page (a polite ask on a roll, trust with no dice) goes once it's out. What never works (a bribe)\n// has one too, so it isn't read as a try, and so has a kindness; both are ways towards the page that\n// don't bring it, and go with it.\nconst bribeCob = (beat: string): Transition => ({\n  id: \"bribe-cob\", towards: \"page\",\n  when: \"The player offers Cob something as the price of a look in his boot, or at what's crackling in it (a coin held up, food, a trade: 'this is yours if I can see what's in there', 'a shilling for a look'), however politely it's asked and whatever they say about the boots staying his, and nothing that answers what he's afraid of. No dice: Cob haggles, boasts, ups the price and takes anything going, but the boot stays on. Bought attention isn't trust, and grown-ups who pay to look at his boots want them off him (the watch, his da, the pawnshop): what's really wrong comes out instead, his way. They're Cob's, and nobody's having them. (Food with nothing asked back is a kindness, not this.)\",\n  to: beat,\n});\n\nconst kindToCob = (beat: string): Transition => ({\n  id: \"kind-to-cob\", towards: \"page\",\n  when: \"The player does Cob a kindness with nothing asked back: something to eat, or a dinner stood him freely, with no look at his boots (or anything else) as the price. He takes it with bad grace and a boast, and it counts with him: after it, a polite ask for a look in his boot, the boots staying his, gets a yes.\",\n  to: beat, establishes: [KIND],\n});\n\nconst coaxCob: Transition = {\n  id: \"coax-cob\", on: \"attempt\", essential: \"page\",\n  when: \"Before Cob has any reason to trust them (no kindness with nothing asked back done him yet, no promise that answers what he's afraid of, no yes from him already) and with nothing offered for it, the player asks Cob to let them look in his left boot, or see or feel what's crackling in it, with the boots staying his (it's what's in them they're after, not the boots), or tries to win him round to it (Mister Prout, the men from the loft, his own skin), where it could go either way. Not with anything offered for the look (a coin, food, a trade): that's a bribe, and gets haggling. Not after a kindness, with a promise that answers his fear, or once he's said they can look: then the ask needs no dice.\",\n  check: { reason: \"to get Cob to let you look in his boot\",\n    skill: \"persuasion\", dc: 12,\n    success: \"Cob scowls at them for a long moment, then sits on the edge of the water butt, unlaces the string and holds the left boot out at arm's length: 'Look, then. And Cob's having it straight back.' In the lining is something folded and stiff, held in with small neat stitches, and out comes a page, folded small and gone soft at the corners. Cob can't read it; anyone who can sees a dozen grain wagons for the King's Road marked 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor', with Prout's pencilled weights beside them.\",\n    failure: \"Cob won't, and it costs: he clamps a hand over the boot and backs off towards the water butt and his gap, and Moll drops off the wall between them, one more grown-up after Cob's boots. The boot isn't lost: a kindness with nothing asked back, a real promise, or someone saying aloud whose boots they are can still open it.\",\n    onSuccess: \"motive\", establishes: { success: [PAGE] },\n  },\n};\n\n/** What Cob is afraid of, as a promise that answers it names it (his granary fears). */\nconst COB_FEARS = \"his name kept out of it, with nothing to the watch and nothing in anybody's book; the men from the loft kept off him; no Mending House; the boots his to keep\";\n\nconst trustCob: Transition = {\n  id: \"trust-cob\", essential: \"page\",\n  when: `The player asks Cob for a look in his left boot (or a peek at what's crackling in it), the boots staying his, once he has real reason to trust them: they did him a kindness with nothing asked back earlier (something to eat, a dinner stood him freely), or they make him a promise, now or before, that truly answers what he's afraid of (${COB_FEARS}), or he has already told them they can look. No dice, however it's put: he unlaces the left boot, holds it out at arm's length and lets them pick the lining open: Prout's page is out.`,\n  to: \"motive\", establishes: [PAGE],\n};\n\n/**\n * A promise that answers Cob's fear, with or without an ask: no dice, and he tells what he's been\n * holding (what he heard, in the yard; who, once it's murder). It brings that essential, and goes once\n * the player has it.\n */\nconst promiseCob = (beat: \"yard\" | \"doubt\"): Transition => ({\n  id: \"promise-cob\", essential: beat === \"yard\" ? \"not-suicide\" : \"silvertop\",\n  when: `The player makes Cob a promise that truly answers what he's afraid of, and means it (${COB_FEARS}), or asks him what he knows under a promise like that made before. No dice, whatever they ask with it: he believes it, near enough. ${beat === \"yard\"\n    ? \"He checks Moll can't hear, then tells it in a frightened rush: he sleeps in the loft, and last night he woke to a lantern and voices, Mister Prout arguing with two men; then a thump, a choking noise and the hoist creaking with no sacks on it. He hid in his sacks till morning.\"\n    : \"He gives up who, in a whisper: Silvertop, the posh cove with the silver-topped cane, the flower smell and a ring with a bit of wheat on it, who comes with the Purveyor's wagons and opens the big doors with his own key; and a big man with a bandaged hand, who said 'Yes, Master'.\"} Asked for a look in his boot as well, he holds the left one out himself.`,\n  to: \"doubt\", ...(beat === \"yard\" ? { establishes: [NOT_SUICIDE] } : {}),\n});\n\n/** The page's ways in, on a beat where Cob is about (and the bribe that isn't one). */\nconst bootRoutes = (beat: string): Transition[] => [bribeCob(beat), kindToCob(beat), coaxCob, trustCob];\n\nexport const hangedClerk: Scene = {\n  id: \"hanged-clerk\",\n  title: \"The Hanged Clerk\",\n  time: \"morning\",\n  summary: \"A palace clerk hanged behind the granary, two foul-mouthed kids who know more than they say, and a dry watch sergeant with until noon.\",\n  setting: \"Mid-morning on the eve of the Centennial Assembly, in the cobbled yard behind the King's Granary in Caerwyn's granary quarter. Over the wall the city is hanging bunting for tomorrow's procession; in here it smells of wet grain, pigeons and river mud, and the night's drizzle has only just stopped. High on the granary's back wall a hoist beam juts out above the shut loft door, and from its hook, on a noose, hangs Wendell Prout: a small grey-coated clerk with ink-stained fingers and no boots, his darned stockinged feet turning at about head height. The hoist rope runs up over the beam's pulley and in through a slot above the loft door, so it's tied off somewhere inside: getting him down means cutting the rope above his head, well out of reach from the cobbles, or lowering him from the loft. Nothing stands beneath him: no stool, no ladder, no crate; the yard was swept bare yesterday for the Assembly. His satchel lies open and empty by the gate, his spectacles bent in the gutter. The big yard doors into the granary are padlocked. A water butt stands in one corner. The yard wall is shoulder-high on the lane side, and a girl is sitting on top of it.\",\n  premise: \"What really happened to Wendell Prout, and will the player get the truth on the record before the watch carts him off as a suicide at noon?\",\n  hook: \"This morning a palace clerk, Wendell Prout, was found hanged behind the Caerwyn granary, and the Watch Captain has already called it suicide. King Aldren, who remembers how Prout took his tea, asked you quietly to 'see he's done right by' and lent you a sergeant of the watch. She's waiting for you in the granary yard. So, by the sound of it, are some children.\",\n  opening: \"Open on the yard: Prout turning slowly on the sack hoist above the shut loft door, a pigeon on the beam; a scrawny boy in enormous boots lobbing gutter stones at the body with a running commentary; a sharp-faced girl on the wall top swearing at everyone in at least two languages. Sergeant Kell steps away from the gate with her notebook, introduces herself in a line and gives the Captain's view (suicide) without sharing it. Show only what a first glance would, and name nobody the player hasn't been introduced to. End on a stone clanging off the hoist hook.\",\n  cast: [\n    {\n      id: \"kell\",\n      name: \"Sergeant Agnes Kell\",\n      statblock: \"guard\", weapon: \"club\",\n      look: \"Forties, a rain cape beaded with drizzle, a battered oilcloth notebook and a pencil stub she sharpens with a clasp knife; a truncheon she has never been seen to draw. Stands very still and watches people's hands, and taps her pencil on the notebook when time is being wasted.\",\n      voice: KELL_VOICE,\n      wants: \"To see Prout off that hook as anything but a suicide before the dead-cart comes at noon, without putting a word in her notebook she couldn't swear to; the nearer noon gets, the harder those two pull against each other. To find out whether the King's investigator is worth her notebook. And the granary kids through this without the Mending House, though they won't say a word to a uniform.\",\n      fears: \"A wrong name in her notebook. Prout in the pit by sundown with nobody having looked. The King's investigator turning out to be a bully or a fool.\",\n      knows: [\n        \"She has never met the King's investigator: this morning a palace page came to the watch house for a sergeant to go with them, and the Captain sent her. Whatever they claim, she knows them from today.\",\n        \"The dead man is Wendell Prout, under-clerk of the Royal Granary Roll: he kept the palace's grain accounts up in the granary's tally loft. Fussy, honest, unmarried; no debts, enemies or drink that anyone knows of. The King, apparently, remembers how he took his tea.\",\n        \"The porters found him at first light. The palace had reported him missing the evening before.\",\n        \"The Watch Captain called it suicide before anyone had looked and wants it closed quietly before the Assembly: the dead-cart comes at noon to cut him down. Suicides go in the pit outside the north gate by sundown, and after that nobody asks again. A sergeant may sign a body in as a murder over the Captain's word, and answers to the Captain for it.\",\n        \"The porters couldn't get up to him: the yard doors were padlocked when they came, the loft door is barred on the inside (they tried it with a hook-pole), and their ladders are locked in the granary. The warden keeps the key and is at the palace counting Assembly provisions; her runner came back with 'After the Assembly.'\",\n        \"The kids are Cob and Moll, granary rats who run errands, pinch things and sleep rough round the yards. Cob's father is a porter here with a thirst and heavy hands; Moll looks out for Cob. They won't tell the watch anything: she's tried.\",\n        \"Silver stamped with a little wheat-ear is purse money from the Royal Purveyor's office, marked so the palace kitchens can't pinch it. 'J. Sallow, for the Royal Purveyor' is a signature she has seen on the Assembly delivery notices pinned up in the watch house: one of the under-purveyors. A name, not a face.\",\n        \"Her method with the hanged: she won't say how one died until she's had him close, cut down or with someone up there, and she's no climber (watch boots, knees that complain on ladders), so she'd sooner hold the ladder. Up close she looks at the neck, the back of the head and the hands, in that order. Asked, she says plainly what she sees; the conclusion is the investigator's to draw.\",\n        \"Her own business while she waits: the empty satchel by the gate and the bent spectacles in the gutter, which she writes down and keeps.\",\n      ],\n      secrets: [\n        \"Shows: she knew Prout by sight, and goes very still at 'false entries' or the Purveyor's office. Torn: she sent him away, by the book. Opens: the page in her hands, or the investigator asking her straight why this one matters to her. First: 'I'd met him.'\",\n        \"Three days ago Prout came to the watch house and asked her, very politely, how a clerk reports 'false entries in the King's rolls', and whether the watch could arrest 'a gentleman of the Purveyor's office'. She told him to take it to the palace, and forgot him until this morning. She tells it once, in her own words, ending 'I should have listened.' Told is told: she doesn't tell it again.\",\n      ],\n      attitude: `Reserved and watchful: lent to the investigator, not given, and it's their case. She backs their reasonable moves and writes them down. She tests a case once, at its weakest point ('On what evidence?'), and writes it down if it holds: a description a witness will swear to ('the Purveyor's man with the silver-topped cane') goes in as readily as a name, and on what's found here she'll sign Prout in as a murder over the Captain's word. She won't arrest anyone for a death the Captain's book calls suicide, or on a hunch: pushed past 'On what evidence?', she does it under protest and writes her objection down in full. Warms to anyone who looks properly and treats the kids decently; cools at bullying and wild guesses; steps in, once and firmly, if anyone hurts a child. Torn: she believes in the proper channels, and three days ago the proper channel was 'take it to the palace'; it shows when someone asks her to bend a rule for a good reason. ${KELL_PROMISES} Ties here: Cob, whom she has taken up twice for pilfering and twice let go rather than send to the Mending House (he doesn't know why, and doesn't trust it); Tull, who'll wait on her word if she gives him one he can repeat to the Captain.`,\n    },\n    {\n      id: \"cob\",\n      name: \"Cob\",\n      called: \"the boy in the too-big boots\",\n      statblock: \"commoner\", weapon: \"unarmed-strike\",\n      look: \"A scrawny boy of about eleven in a man's waistcoat and a pair of good black clerk's boots three sizes too big, laced round his ankles with string. Gutter stones in both fists, scabbed knuckles, a yellowing bruise on one cheek.\",\n      voice: \"Loud and cocky, and talks about himself in the third person ('Cob don't talk to bluebottles'). Foul-mouthed in an inventive gutter way (sod off, bleedin', bum-faced palace pigeon) but never truly obscene. Brags, mocks and dares; goes very quiet and very young when he's frightened.\",\n      wants: \"To keep the boots, the first good thing he's ever owned, off anyone who'd take them, the watch included. To see the men who did for Mister Prout get what's coming to them, without them ever finding out Cob was in the loft: he can't have both, and it's eating him. And something to eat.\",\n      fears: \"The men from the loft finding out Cob was there and coming back for him, which they will if his name gets about: in the watch's book (the bluebottles write everything down) or anybody's. Being taken up by the watch and sent to the Mending House. His father. Being called a liar.\",\n      knows: [\n        \"The porters found the clerk at first light and ran off yelling for the watch. Cob was here before them, obviously.\",\n        \"He's throwing stones 'because it makes him spin' and 'because he don't mind, he's dead, Cob checked'.\",\n        \"Mister Prout was all right: he gave Cob the crusts off his dinner and once showed him how to write a C. Cob would sooner die than admit he's upset.\",\n      ],\n      secrets: [\n        \"Shows: the boots are three sizes too big and he won't take them off, and the left one crackles when he stamps; he stops throwing stones when anyone says 'the loft', and goes white at the hoist creaking. Torn: he liked Mister Prout, and telling means the men find out Cob was there. Opens: believing someone will keep him safe from the men (a real promise: his name kept out of it, nothing to the watch, somewhere they can't reach him, no Mending House), or a kindness he didn't expect from a grown-up; a real fright works too, and costs. First: 'Cob sleeps where Cob likes.'\",\n        \"The boots are Prout's. He and Moll pulled them off the body at first light, before the porters came (he stood on her shoulders). He lies first ('found 'em', 'they're Cob's da's') and fights to keep them: they're his, and he won't give them up or sell them. A look is another matter. Coin or food offered as the price of a look gets haggling and boasts, never the look (grown-ups who pay to look at his boots want them off him); a kindness with nothing asked back counts with him; asked politely, the boots staying his, he might let someone look (it could go either way); and for someone he trusts, or a promise that answers his fear (his name kept out of it, nothing to the watch, the men from the loft kept off him), he holds the left one out himself. A yes he's given is a yes: he doesn't take it back.\",\n        \"He was in the loft last night: he sleeps up there, in his 'castle', a nest of sacks and candle-ends behind the stacks, reached through a loose board behind the water butt (child-sized; a grown-up could squeeze through with effort). That's all he'll own to at first, and he goes white saying it.\",\n        \"What he heard, in a frightened rush: a little after the midnight bells a lantern and voices woke him, Mister Prout arguing with two men; then a thump, a choking noise, and the hoist creaking though there were no sacks on it. He hid in his sacks till dawn and has told no one but Moll.\",\n        \"Who, only to someone he trusts: Silvertop, the posh cove with the silver-topped cane, the flower smell and a ring with a bit of wheat on it, who comes with the Purveyor's wagons and opens the big doors with his own key; and a big man with a bandaged hand, who said 'Yes, Master'. Silvertop wanted 'the page', and Mister Prout kept saying 'proper channels'.\",\n        \"Two nights ago he watched Mister Prout, by candle, cut a page out of the big chained book on the tally desk and sew something into his boot 'like a sailor', and thought him a cheapskate. He hasn't put that together with the boots on his own feet.\",\n        \"Since then the loft is wrong, and he knows it by heart: a smashed lantern and spilled ink by the tally desk, heel scuffs in the grain dust from the desk to the loft door, the loft door barred, the hoist rope tied off on its cleat with a docker's knot. The big book is still chained to the desk with its page cut out. Cob can't read it, but to anyone who can, the pages either side list grain wagons for the King's Road marked 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor'.\",\n        \"He doesn't know it, but the stiff bit in the lining of the left boot, which crackles when he stamps, is a folded page; and the backs of both heels are scraped raw, as if their owner had been dragged.\",\n      ],\n      attitude: \"Hostile, rude and showing off for Moll. Bought attention isn't trust: food or coin offered as a price gets boasts and bargaining; a kindness with nothing asked back, respect or a laugh at his jokes gets real talk and counts towards trust; only believing the player will keep him safe from the men (a promise that answers his fear: his name kept out of it, nothing to the watch, the men from the loft kept off him; or a real fright) gets what he saw. If grabbed, he bolts for his hole. Torn: all mouth, and eleven; the louder he is, the more frightened. It shows when someone's kind to him: he gets ruder before he gets quieter. It helps a patient investigator (he can't keep a secret from someone he trusts) and bites a pushy one (he bolts, and Moll goes with him). Ties here: Moll, the boss (he'd go for anyone who was nasty to her, whatever their size); Kell, the bluebottle with the notebook, who has caught him twice and let him go twice (he doesn't know why, and doesn't trust it).\",\n    },\n    {\n      id: \"moll\",\n      name: \"Moll\",\n      called: \"the girl in the shawl\",\n      statblock: \"commoner\", weapon: \"unarmed-strike\",\n      look: \"A sharp-faced girl of thirteen or so perched on top of the yard wall, heels drumming the bricks, shawl knotted at her chest, one fist kept tightly closed.\",\n      voice: \"Fast, vicious and funny. Swears in Common, Saltmere dock cant and the scraps of Kläggenheim dwarvish she picked up from the carters, and switches when one language isn't rude enough. Answers questions with questions and orders Cob about ('Shut it, Cob'). When it really matters she goes flat and quiet.\",\n      wants: \"To keep Cob: he's all she's got. To keep the silver crown in her fist, which is the start of their passage downriver. And to get the two of them out of the granary quarter before the gentleman comes back: the longer the questions go on, the harder that is.\",\n      fears: \"Being left on her own. The gentleman who paid her. The watch taking Cob away.\",\n      knows: [\n        \"Everyone round the granary knows the clerk stayed late up in the tally loft, scratching in his big book.\",\n        \"Cob's da is a porter here and handy with his belt; Cob sleeps anywhere but home.\",\n        \"The story she was paid to tell, and tells to anyone who asks, adding detail when it's doubted: she saw the clerk jump from the loft door at midnight, by moonlight, wailing about his debts. It's false: she slept in the cart shed across the lane, and it drizzled all night.\",\n      ],\n      secrets: [\n        \"Shows: one fist kept tightly closed; her eyes keep going to the yard gate; she shuts Cob up whenever he gets near the night. Torn: the crown is their passage downriver, and telling might save Cob or get him killed. Opens: a believable way to keep Cob safe and out of the Mending House, or her lie caught out in front of him. First: 'A gentleman. Paid me to say it.'\",\n        \"At first light a gentleman stopped at the yard gate, looked up at the body for a long moment, and gave her a silver crown to tell anyone who asked that she'd seen the clerk jump. The debts were his idea; the moonlight was hers.\",\n        \"Who: a good coat, a silver-topped cane, a wheat-ear signet ring and enough lavender water to make your eyes run; the big man with him had a bandaged hand and called him 'Master Sallow'.\",\n        \"The crown, stamped on one face with a little wheat-ear, is in her fist. She thinks the picture makes it worth more.\",\n        \"When the gentleman had gone, she helped Cob get the boots off the body (he stood on her shoulders).\",\n        \"She knows Cob was in the loft last night and heard it happen, and from what he heard (a silver-topped cane, a big man with a bad hand) she has guessed who did it. She's terrified for him.\",\n      ],\n      attitude: \"Hostile and mocking from the wall top. Sticks to her paid story and steers Cob away from questions. She gives way when her lie is caught out, or when someone convincingly offers to keep Cob safe and out of the Mending House; she'd sooner run than be arrested. Torn: fierce, fast and out for herself, but all of it is for Cob: she'll lie, run and swear for him, and break for him and nobody else. It shows the moment Cob is in danger, or in trouble with the watch. Ties here: Cob; Kell, the one with the notebook who doesn't shout, which is worse, and who has let Cob go twice (Moll doesn't know yet what she wants for it).\",\n    },\n    {\n      id: \"tull\",\n      name: \"Corporal Abner Tull\",\n      called: \"the corporal\",\n      statblock: \"guard\", weapon: \"club\",\n      group: \"Corporal Tull and two constables with the dead-cart\",\n      look: \"Stout and red-faced in a damp watch cape, with a lunch-shaped bulge in one pocket; he takes his helmet off to the dead as a matter of course, and puts it back on to read his orders. Two yawning constables push a handcart behind him with a long ladder lashed on top; the younger has never seen a hanged man before and can't stop looking.\",\n      voice: \"Cheerful, weary and procedural. Calls Kell 'Sarge' and everyone else 'sir' or 'madam', and quotes his orders word for word. 'Can't argue with writing, sir. Nobody can. That's what it's for.'\",\n      wants: \"To carry out the Captain's order to the letter and be back on the Assembly route before his dinner goes cold. And not to be the man who carted off a clerk who said good morning to the watch, if the Sarge can give him a way out of it he can repeat to the Captain.\",\n      fears: \"Getting it wrong in front of the Captain. Paperwork, especially his own.\",\n      knows: [\n        \"The Captain's written order, which he'll show to anyone who doubts him and won't hand over (it's his authority): 'The death of W. Prout, clerk, to be closed as self-murder, without fuss, at the request of Master J. Sallow of the Royal Purveyor's office.' Anyone may copy it, slowly, while he eats.\",\n        \"The whole watch is out lining the Assembly route, and the Captain wants this done before the bells.\",\n        \"A suicide goes in the pit outside the north gate by sundown; a murder goes to the watch-house cold room for the surgeon, and someone has to sign for it. Not him.\",\n      ],\n      secrets: [\"He knew Prout to nod to (a little clerk who said good morning to the watch, which not many do), and thinks it a rum business when the Purveyor's office cares how a clerk gets filed. He isn't paid to think, so he hasn't, out loud.\"],\n      attitude: \"Friendly and in a hurry. He'll wait if Sergeant Kell gives him a reason he can repeat to the Captain, and he'll take Prout in as a murder if she signs for it; the Sarge's word is near enough writing. Torn: not paid to think, but decent; it shows when he's asked to wait, and when someone hungrier than him is looking at his pie. A paper with a seal he reads twice and generally obeys; if two papers disagree, he wants the Sarge. Ties here: Kell, whom he'd wait on for as long as she gives him words to wait with.\",\n      enters: \"dead-cart\",\n    },\n  ],\n  start: \"yard\",\n  beats: [\n    {\n      id: \"yard\",\n      title: \"Stones at a hanged man\",\n      direction: \"The arrival. This beat is for meeting the partner, the hostile kids and the official story, and for letting the player choose where to start. Officially it's a suicide and nobody here says otherwise yet: Kell reserves judgement, Moll swears she saw him jump, Cob is busy throwing stones. Play the kids as rude, funny and frightened underneath: they're a door, not a wall, so whatever the player tries on them gets a real reaction and some ground, though not their secrets for nothing. Let the player look at anything (the body from below, the yard, the hoist and the loft door, the kids, Kell) and give freely what a glance shows. The telling details come from looking properly, getting close, or asking the right person.\",\n      cast: {\n        kell: \"Introduce yourself in a line and answer questions about the public facts. Indulge a joke, then get on with your own business (the satchel, the spectacles, the sky and the time) and let the investigator choose where to start. If asked to handle the kids, try; they won't talk to the watch. You won't arrest anyone for a death the Captain calls suicide.\",\n        cob: \"Pelt the body and the newcomers with stones and commentary, and show off for Moll. Deflect anything about the boots or the night with bravado and lies.\",\n        moll: \"Heckle from the wall top. Tell your 'I saw him jump' story with relish to anyone who asks. Shut Cob up when he says too much.\",\n      },\n      pressure: \"A stone from Cob clangs off the hoist hook and Prout turns slowly round to face the player. Kell glances at the sky: noon, and the dead-cart, aren't far off.\",\n      transitions: [\n        {\n          id: \"not-suicide\",\n          when: \"The player has found, been shown or worked out a specific sign that Prout didn't hang himself: for example the level cord mark or the blow to the head (up close), that he could only have dropped from a loft door that's barred on the inside, the scuffs or the docker's knot in the loft, the scraped heels of his boots, Moll's story falling apart, or Cob's account of the night.\",\n          to: \"doubt\", establishes: [NOT_SUICIDE],\n        },\n        { id: \"page-found\", when: \"The folded page sewn into the lining of Prout's left boot has been found and read, or read out.\", to: \"motive\", establishes: [PAGE] },\n        {\n          id: \"examine-body\", on: \"attempt\",\n          when: \"The player examines Prout's neck, head or hands up close (he's been got down, or they've climbed or been lifted up to him), where reading what they see takes some skill.\",\n          check: { reason: \"to tell how Prout really died\",\n            skill: \"medicine\", dc: 12,\n            success: \"They see what the noose didn't make: a thin, level cord mark low round the neck beneath the rope's slanting burn, a swelling under the hair at the back of the skull, and clean palms with no rope burn. He was struck and strangled, then hung up.\",\n            failure: \"They see rope burn, bruising and a dead clerk's face, and can't read more. Kell, at their shoulder, says 'Hm.' She has seen something; a second look, or asking her, will find it.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        {\n          id: \"win-cob\", on: \"attempt\",\n          when: \"The player pushes past Cob's hostility to get him to trust them or tell what he knows, with an appeal or an argument, where it could go either way. (Not just asking him a question. Food or coin offered as the price of it gets boasts and bargaining, not this. A promise that truly answers what he's afraid of, his name kept out of it and the men from the loft kept off him, needs no dice: that's not this either.)\",\n          check: { reason: \"to get Cob to trust you with what he heard\",\n            skill: \"persuasion\", dc: 13,\n            success: \"Cob's swagger cracks. He checks Moll can't hear, then tells it in a frightened rush: he sleeps in the loft, and last night he woke to a lantern and voices, a thump and a choking noise, then the hoist creaking with no sacks on it. He hid till morning.\",\n            failure: \"Cob jeers, calls them a bum-faced palace pigeon and darts behind the water butt and through a gap into the granary. He's hiding, not gone: Moll knows where, and he can still be coaxed out.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        promiseCob(\"yard\"),\n        {\n          id: \"catch-moll\", on: \"attempt\",\n          when: \"The player presses on the holes in Moll's 'I saw him jump' story, or tries to read whether she's lying, where it could go either way. (Not just asking her to tell it.)\",\n          check: { reason: \"to see through Moll's story about the jump\",\n            skill: \"insight\", dc: 13,\n            success: \"Moll's story wobbles and she knows it. Cornered, she admits through her teeth that a gentleman paid her a silver crown at first light to say she'd seen the clerk jump.\",\n            failure: \"Moll tells it again, louder and with new details, and Cob loyally swears to every word. The holes are still there (the barred loft door, the drizzle, debts nobody knows of) for anyone who comes at it another way.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        {\n          id: \"scare-kids\", on: \"attempt\",\n          when: \"The player tries to frighten the kids into talking: threats, looming, the watch, the Mending House or Cob's father.\",\n          check: { reason: \"to scare the children into talking\",\n            skill: \"intimidation\", dc: 12,\n            success: \"Cob's bravado collapses. White-faced, he blurts that he was in the loft last night and heard men do it, and starts to cry; Moll screams blue murder at the player from the wall. Kell's mouth goes thin.\",\n            failure: \"Cob bolts behind the water butt and through a gap into the granary, and Moll lets fly in three languages. Kell says nothing, loudly. The kids will be harder to reach now, but they haven't gone.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        ...bootRoutes(\"yard\"),\n        { id: \"concede\", on: \"attempt\", when: \"The player tells Kell they accept the Captain's verdict of suicide and to let the dead-cart have him (not just wondering aloud whether it was suicide).\", to: \"closed-suicide\" },\n        { id: \"walk-away\", on: \"attempt\", when: \"The player gives up and leaves the granary yard, or heads off elsewhere, before anything has troubled the suicide story, leaving Prout and Kell behind.\", to: \"walked-away\" },\n        { id: \"cart-comes\", on: \"cue\", when: \"The player has been in the yard a long while (at least eight exchanges at this point) without breaking the suicide story, and is going round in circles, idling or waiting for something to happen: noon comes, and so does the dead-cart.\", to: \"dead-cart\" },\n      ],\n    },\n    {\n      id: \"doubt\",\n      title: \"Not by his own hand\",\n      direction: \"The suicide story is broken and the player knows it: Prout was killed and then hung up for show. This beat is for who and why. Kell is in now: she writes things down, reads back what she's written, and lets the player lead. The kids feel the change: Moll wants Cob away from here, and Cob, if he hasn't talked, is close to cracking. Every thread is live: what Cob saw last night, who paid Moll and with what, the boots, the loft and the big book in it, and Kell herself (why does this one matter to her?). Follow whatever the player picks up and reward real contact with real answers; secrets still need a reason to come out.\",\n      cast: {\n        kell: \"Write it down, and read back what you've written. Back the player's reasonable moves, and meet a guess, once, with 'On what evidence?'. Decide for yourself whether what's here would hold up if you signed Prout in as a murder.\",\n        cob: \"Jumpy. If you've been won over, stick close to the player; if not, edge towards the water butt.\",\n        moll: \"Try to get Cob away. Watch the yard gate. Break your story only to protect Cob.\",\n      },\n      pressure: \"Cob stamps his too-big boots against the cold, and the left one crackles like paper. The palace bells ring the half hour before noon.\",\n      transitions: [\n        { id: \"page-found\", when: \"The folded page sewn into the lining of Prout's left boot has been found and read, or read out.\", to: \"motive\", establishes: [PAGE] },\n        {\n          id: \"win-cob\", on: \"attempt\",\n          when: \"The player pushes Cob to tell who was in the loft last night, or about the boots, with an appeal or an argument, while he's still holding out and it could go either way. (Not just asking. A promise that truly answers what he's afraid of, his name kept out of it and the men from the loft kept off him, needs no dice: that's not this.)\",\n          check: { reason: \"to get Cob to tell you what he saw\",\n            skill: \"persuasion\", dc: 12,\n            success: \"Cob gives up what he's been holding: Silvertop, the posh cove with the silver-topped cane who comes with the Purveyor's wagons and has his own key to the big doors, and a big man with a bandaged hand. If asked, he owns up that the boots came off Mister Prout, and that he saw the clerk sewing something into one two nights ago.\",\n            failure: \"Cob clams up and backs towards the water butt: Cob don't know nothing. He'll talk to someone who gives him a real reason to feel safe.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        promiseCob(\"doubt\"),\n        {\n          id: \"catch-moll\", on: \"attempt\",\n          when: \"The player presses on the holes in Moll's story, or tries to read what she's hiding, where it could go either way. (Not just asking her to tell it.)\",\n          check: { reason: \"to get the truth out of Moll\",\n            skill: \"insight\", dc: 13,\n            success: \"Moll cracks: a gentleman with a silver-topped cane and a wheat-ear signet ring paid her a silver crown at first light to say she saw the clerk jump, and his big friend with the bandaged hand called him 'Master Sallow'. Pressed, she opens her fist on the coin.\",\n            failure: \"Moll sticks to her story and turns up the abuse, but her eyes keep going to the yard gate, and the holes in her story are still there.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        {\n          id: \"scare-kids\", on: \"attempt\",\n          when: \"The player tries to frighten the kids into talking: threats, looming, the watch, the Mending House or Cob's father.\",\n          check: { reason: \"to force the children to reveal what they know\",\n            skill: \"intimidation\", dc: 12,\n            success: \"They crack under it. Cob sobs out what he saw (Silvertop and the big man with the bandaged hand); Moll flings down her silver crown and calls the player every name she knows. Kell writes it down without looking at the player.\",\n            failure: \"Cob bolts behind the water butt and into the granary, Moll goes back up the wall out of reach, swearing, and Kell sighs. They'll only come round for someone who stops looming.\",\n            onSuccess: \"doubt\",\n          },\n        },\n        ...bootRoutes(\"doubt\"),\n        { id: \"accuse-kid\", on: \"attempt\", when: \"The player accuses Cob or Moll of killing Prout (says plainly that they did it, not just asks) or tells Kell to arrest one of them for it.\", to: \"accused\" },\n        { id: \"wrap-up\", on: \"attempt\", when: \"The player is done here without naming anyone for it: wrapping up, leaving the yard, or asking Kell to write Prout up as murdered by persons unknown or to take what they've found to the King as it stands.\", to: \"open-case\" },\n        { id: \"cart-comes\", on: \"cue\", when: \"The scene has been at this point a good while (at least six exchanges) and the player isn't closing in on who or why, or is idling or waiting: noon comes, and so does the dead-cart.\", to: \"dead-cart\" },\n      ],\n    },\n    {\n      id: \"motive\",\n      title: \"What Prout found\",\n      direction: \"Prout's page is out: grain written off as 'lost to goblins' that turned up at the river warehouses, every wagon countersigned 'J. Sallow, for the Royal Purveyor'. This is why he died, and it names a man. Give the player a moment with it. Kell reads it over their shoulder and goes very still: this is what Prout came to her about, and that can come out now. Let the player put the case together in their own words; Kell tests it once, at its weakest point ('On what evidence?'), and doesn't make it for them. If the kids hear the name, or a silver-topped cane described, they know exactly who it is.\",\n      cast: {\n        kell: \"Read the page and go still. Then admit, quietly and once, that Prout came to you three days ago and you sent him away (unless it's already out: then it's told). Start writing it up in your own words, and read back what you've written for the investigator to put right.\",\n        cob: \"If you hear the name Sallow or a silver-topped cane described, that's Silvertop: react.\",\n        moll: \"Go white at the name Sallow, and look at your fist.\",\n      },\n      pressure: \"The palace bells ring a quarter to noon. Kell turns the page over, as if there might be more on the back.\",\n      transitions: [\n        { id: \"leave-with-page\", on: \"attempt\", when: \"The player is done here and leaves the yard (or sends Kell off) with the page in hand, without laying the case out in words: Kell has read it and will write it up herself.\", to: \"case-made\" },\n        { id: \"cart-comes\", on: \"cue\", when: \"The player has had the page a while (at least three exchanges at this point) without making the case to Kell, or is dawdling: noon comes, and so does the dead-cart.\", to: \"dead-cart\" },\n      ],\n    },\n    {\n      id: \"dead-cart\",\n      title: \"The dead-cart\",\n      direction: \"Noon, and the world has stopped waiting. Corporal Tull has come with two constables, a handcart, a long ladder and the Captain's written order to cut Prout down and file him as a suicide. This is the last chance to make the case. Tull isn't a villain: he's bored, polite and in a hurry, and he'll wait for the sergeant's word if someone gives him a reason he can repeat to the Captain. His order says who asked for it, for anyone who reads it. Prout coming down the ladder is a chance, for anyone quick, to look at him up close.\",\n      cast: {\n        tull: \"Wave the order and quote it. Be reasonable, bored and in a hurry. Wait if the sergeant asks; take Prout in however she signs for him.\",\n        kell: \"Hold Tull off with procedure if the player has given you something to hold him with. Without it, you can't.\",\n        cob: \"Go quiet at the sight of more watchmen. Stick close to whoever's been decent to you, or slide towards the water butt.\",\n        moll: \"Get off the wall and as far from the watch as the yard allows.\",\n      },\n      pressure: \"One constable sets the ladder against the hoist beam and starts up it with a knife in his teeth. Tull looks at Kell: 'Sarge?'\",\n      transitions: [\n        { id: \"held-as-murder\", when: \"Kell, given real evidence, has agreed to sign Prout in as a murder rather than a suicide, and Tull has accepted it, with nobody named for it.\", to: \"open-case\" },\n        {\n          id: \"persuade-tull\", on: \"attempt\",\n          when: \"The player tries to talk Tull into waiting, or into taking Prout in as anything but a suicide, before Kell has a case she'll sign for.\",\n          check: { reason: \"to convince Tull to wait before taking Prout away\",\n            skill: \"persuasion\", dc: 12,\n            success: \"Tull sighs, folds the order away and sits on the edge of the cart: he'll wait for the sergeant's word, and take Prout in however she signs for him.\",\n            failure: \"Tull is very sorry, but the Captain was very clear, and he nods his constables up the ladder. One more good reason might still stop him.\",\n            onSuccess: \"dead-cart\", onFailure: \"closed-suicide\",\n          },\n        },\n        { id: \"accuse-kid\", on: \"attempt\", when: \"The player accuses Cob or Moll of killing Prout (says plainly that they did it, not just asks) or tells Kell or Tull to arrest one of them for it.\", to: \"accused\" },\n        { id: \"carted-off\", on: \"cue\", when: \"Tull's patience has run out, or the player has told him to go ahead: he has waited at least two exchanges since he arrived (or since he last agreed to wait) without being given a reason he can take back to the Captain, and the constables load Prout onto the cart as a suicide.\", to: \"closed-suicide\" },\n      ],\n    },\n    {\n      id: \"accused\",\n      title: \"On what evidence?\",\n      direction: \"The player has accused a child of the murder. Kell doesn't move: she asks what evidence they have, and waits. The accused child reacts as they would, and the other defends them. This beat is for the player to show what they've got, think again, or insist. Don't decide it for them, and don't hand them the real answer to soften the moment.\",\n      cast: {\n        kell: \"Don't arrest anyone yet. Ask what evidence they have and weigh it honestly: boots make Cob a thief, not a murderer. If they insist after that, do it, under protest, and say you'll be writing your objection down.\",\n        cob: \"Outrage first, then fear: back towards the water butt.\",\n        moll: \"Defend Cob ferociously. If it's you they're accusing, threaten to run.\",\n      },\n      pressure: \"Cob edges towards the water butt; Moll swings a leg over the far side of the wall.\",\n      transitions: [\n        { id: \"insist-cob\", on: \"attempt\", when: \"Having heard Kell's objection, the player insists that Cob be taken in for the murder anyway, or seizes him for it themselves.\", to: \"wrong-man\", establishes: [COB_TAKEN] },\n        { id: \"insist-moll\", on: \"attempt\", when: \"Having heard Kell's objection, the player insists that Moll be taken in for the murder anyway, or seizes her for it themselves.\", to: \"wrong-man\", establishes: [MOLL_TAKEN] },\n        { id: \"drop-it\", when: \"The player has let the accusation drop for now (taken it back, or turned to the evidence, the body or someone else), and Corporal Tull's dead-cart hasn't come yet.\", to: \"doubt\" },\n        { id: \"drop-it-cart\", when: \"The player has let the accusation drop for now, and Corporal Tull and his dead-cart are already in the yard.\", to: \"dead-cart\" },\n      ],\n    },\n  ],\n  anytime: [\n    {\n      id: \"make-case\",\n      when: \"The case is on the record: the player has made it to Kell (out loud, or by handing her the page that names him) that Prout was killed and hung up to look like a suicide by or for the man calling himself Master Sallow of the Royal Purveyor's office (the kids' 'Silvertop', or just 'the Purveyor's man'), backed by something actually found here, and Kell has accepted it and is writing it down as murder.\",\n      to: \"case-made\",\n    },\n  ],\n  exits: [\n    {\n      id: \"case-made\", kind: \"progress\", title: \"The case is made\",\n      outcome: \"Kell writes Prout's death down as murder, made to look like a suicide, with the man calling himself Master Sallow of the Royal Purveyor's office behind it. The player has a case, and whatever proof they found here, to take to the King.\",\n      closing: \"Kell underlines something twice, closes her notebook and says something dry that is very nearly thanks. Prout goes to the watch house as a murder; she wants the player to carry the case to the King, since the Captain files what the Purveyor's office asks him to file. Let the kids react to how the player treated them.\",\n      next: \"caerwyn-afternoon\",\n      script: (world, outcome) => {\n        world.quest(\"hanged-clerk\").complete(\"Proved Wendell Prout was murdered, and named Sallow of the Royal Purveyor's office as behind it.\");\n        world.quest(\"purveyors-man\").start(\"The Purveyor's Man\", \"A man calling himself Master Sallow, of the Royal Purveyor's office, had the palace clerk Wendell Prout killed and hung up as a suicide. The case needs taking to the King, not the Watch Captain.\");\n        world.character(\"kell\").setAttitude(\"friendly\", \"The King's investigator made Prout's case properly.\");\n        world.character(\"kell\").remember(\"The King's investigator proved Prout was murdered and named Sallow of the Purveyor's office.\");\n        if (has(outcome.established, PAGE)) world.player.addItem({ ...world.newReadable(pageItem), asset: \"parchment-note\" });\n        world.setFlag(\"prout_death\", \"murder, Sallow named\");\n        world.journal(\"Wendell Prout didn't hang himself. The trail leads to Master Sallow of the Royal Purveyor's office.\");\n      },\n    },\n    {\n      id: \"open-case\", kind: \"progress\", title: \"Murder by persons unknown\",\n      outcome: \"Kell writes Prout's death down as murder by persons unknown, so he goes to the watch-house cold room and not the suicides' pit. Nobody has been named, but the case stays open.\",\n      closing: \"Kell writes one line and underlines it; Prout will go on the cart under a sheet, as a murder. She tells the player, drily, that an open case beats a wrong one.\",\n      next: \"caerwyn-afternoon\",\n      script: (world, outcome) => {\n        world.quest(\"hanged-clerk\").advance(\"murder_unnamed\", \"Prout's death is on the books as murder by persons unknown.\");\n        world.character(\"kell\").remember(\"Prout was murdered; nobody has been named for it yet, and the case is open.\");\n        if (has(outcome.established, PAGE)) world.player.addItem({ ...world.newReadable(pageItem), asset: \"parchment-note\" });\n        world.setFlag(\"prout_death\", \"murder, unnamed\");\n        world.journal(\"Prout was murdered. The watch has it down as persons unknown.\");\n      },\n    },\n    {\n      id: \"wrong-man\", kind: \"other\", title: \"The wrong name in the book\",\n      outcome: \"At the player's insistence, and over Kell's objection, a child has been taken in for Prout's murder. The Captain will gladly file a murder that embarrasses nobody at court, and whoever really killed Prout is in the clear.\",\n      closing: \"Narrate the arrest without relish: the accused child's fury or terror, the other one bolting (over the wall or through the gap behind the water butt), and Kell writing her objection down in full. Prout is still turning on the hoist.\",\n      next: \"caerwyn-afternoon\",\n      script: (world, outcome) => {\n        const accused = has(outcome.established, MOLL_TAKEN) ? \"moll\" : \"cob\";\n        const other = accused === \"cob\" ? \"moll\" : \"cob\";\n        world.character(accused).moveTo(\"the watch-house cells\");\n        world.character(accused).setAttitude(\"hostile\", \"Taken in for a murder they didn't do, on the player's word.\");\n        world.character(other).setAttitude(\"hostile\", \"The player had their friend taken in for murder.\");\n        world.character(other).leaveScene(\"gone to ground somewhere in the granary quarter\");\n        world.character(\"kell\").setAttitude(\"unfriendly\", \"Made to arrest a child for murder on no evidence.\");\n        world.character(\"kell\").remember(\"She arrested a child for Prout's murder at the investigator's insistence, and wrote down her objection.\");\n        world.quest(\"hanged-clerk\").fail(\"A child was taken in for Prout's murder; whoever really killed him is in the clear.\");\n        world.setFlag(\"prout_death\", \"murder, blamed on a granary child\");\n        world.journal(\"We had one of the granary kids taken in for the clerk's murder. The sergeant thinks we're wrong.\");\n      },\n    },\n    {\n      id: \"closed-suicide\", kind: \"other\", title: \"Filed as a suicide\",\n      outcome: \"Prout goes into the Captain's book as a suicide and onto the dead-cart for the pit outside the north gate. Nobody will look for whoever killed him.\",\n      closing: \"Kell writes one word in her notebook and shuts it. Prout goes out of the yard on the dead-cart under a sheet, past the Assembly bunting (at noon, if it isn't here yet). Let the kids react.\",\n      next: \"caerwyn-afternoon\",\n      script: (world) => {\n        world.quest(\"hanged-clerk\").fail(\"Prout was filed as a suicide.\");\n        world.character(\"kell\").setAttitude(\"wary\", \"The King's investigator let Prout go down as a suicide.\");\n        world.setFlag(\"prout_death\", \"suicide\");\n        world.journal(\"The clerk behind the granary was filed as a suicide.\");\n      },\n    },\n    {\n      id: \"walked-away\", kind: \"leave\", title: \"Walked away\",\n      outcome: \"The player left the granary yard before anything troubled the suicide story. At noon the dead-cart takes Prout away as a suicide.\",\n      closing: \"Kell watches them go without a word, then turns back to the body and opens her notebook on her own.\",\n      next: \"caerwyn-afternoon\",\n      script: (world) => {\n        world.quest(\"hanged-clerk\").fail(\"Walked away before the case was made; Prout was filed as a suicide.\");\n        world.character(\"kell\").setAttitude(\"wary\", \"The King's investigator walked away from Prout's case.\");\n        world.character(\"kell\").remember(\"The King's investigator walked off and left Prout to the dead-cart.\");\n        world.setFlag(\"prout_death\", \"suicide\");\n      },\n    },\n  ],\n  essentials: [\n    { id: \"not-suicide\", what: \"Prout didn't hang himself: he was struck and strangled, then hoisted up for show.\", placedWith: [\"the body (cord mark, the blow to the head)\", \"Cob's account of the loft\", \"the scraped heels of Prout's boots\"], carriers: [\"cob\"], unlocks: \"Kell treating it as murder\" },\n    {\n      id: \"page\", what: \"Prout found grain written off as 'lost to goblins' that turned up at the river warehouses, every wagon countersigned 'J. Sallow, for the Royal Purveyor'.\", placedWith: [\"the page sewn into Prout's left boot (Cob is wearing the boots)\", \"the tally book in the loft\"], carriers: [], unlocks: \"the motive, and the name Sallow\",\n      // Missed here, it goes on with the boots (the Drowned Rat has prep for it: Cob is Nan's pot-boy there).\n      later: \"the King's morning needs proof he can hold, and the page is Sallow's countersignature in writing on every 'lost' wagon\", things: [\"ledger-page\"],\n    },\n    { id: \"silvertop\", what: \"A gentleman with a silver-topped cane and a wheat-ear signet ring (Sallow) was in the loft that night.\", placedWith: [\"Cob ('Silvertop')\", \"Moll, if she cracks\"], carriers: [\"cob\", \"moll\"], unlocks: \"naming Sallow as the man behind it\" },\n  ],\n  world: hangedClerkWorld,\n  limits: [\n    \"Getting someone to talk to the dead (a séance, a priest who can call up Prout's ghost): nobody in reach can do it. The Nine Furrows wizards deal in weather, wards and grain, none of them is here, and the temples don't raise the dead for the watch. Prout can only tell what his body shows. (The player's own spells are theirs, and work as the rules say.)\",\n    \"Fetching more help (other watchmen, the watch surgeon, a coroner, a wizard, a tracking dog, the granary warden): nobody can be had before noon. The whole watch is lining the Assembly route, the surgeon is on duty at the palace, and Kell's runner to the warden came back with 'After the Assembly.' The help here is Kell, the kids and whatever the player brought.\",\n    \"A ladder, the granary key or a grown-up's way into the granary: the porters' ladders are locked inside, the yard doors are padlocked, the warden who keeps the key is at the palace, and the yard was swept bare for the Assembly. There's the water butt, a few loose cobbles, the player's own kit, and whatever the kids know.\",\n    \"A royal warrant, or anything in writing from the King: Aldren asked over tea and signed nothing (he avoids signing anything that might upset anyone). The player has the King's word, which Kell respects and a corporal might not.\",\n    \"Reaching anyone at the palace (the Captain, the warden, the King, any official): they're all at the palace preparing for the Assembly and can't be reached from this yard. Taking the case to them is another scene, and leaving before noon leaves Prout to the dead-cart.\",\n    \"Coming back later (tonight, tomorrow): at noon the dead-cart takes Prout away and the yard is locked up for the Assembly. Whatever there is to find is here, this morning.\",\n    \"Prout's own notes and papers: his satchel was found open and empty, and there's nothing written lying about the yard. Whoever emptied it took everything in it.\",\n    \"Following anyone's trail out of the yard (footprints, a scent, tracks): porters, kids and a night of drizzle have trampled it all. No trail leads anywhere from here.\",\n    \"Answers that would need someone who isn't here (what goes on at court, anyone's business at the palace, anything about the goblin raids on the King's Road): nobody in this yard knows, and nothing here says.\",\n  ],\n  anchors: [\"granary-yard\", \"hoist-beam\", \"loft-door\", \"tally-loft\", \"water-butt\", \"yard-wall\", \"yard-gate\", \"yard-doors\"],\n  lore: [\"Places/Granary Yard.md\", \"World/Caerwyn now.md\"],\n  fronts: \"World/Fronts.md\",\n  // Whatever the ending, Prout doesn't stay on the hoist: the watch house's cold room, or the dead-cart at noon.\n  afterwards: [{ op: \"remove\", what: \"prout\", text: \"taken away: to the watch house under a sheet, or on the dead-cart\" }],\n};\n",
      "scenes/worlds/hanged-clerk.ts": "import type { WorldSpec } from \"../../src/world/scene-world.ts\";\n\n/**\n * The yard behind the King's Granary (feet; x runs east, y south from the lane): the lane and its\n * old elm beyond the shoulder-high wall, the cobbled yard with Prout hanging from the hoist on the\n * granary's back wall, and, above it all, the tally loft (drawn off to the east). Things nest:\n * Prout hangs from the hoist rope, the page is in the boot, the boots are on Cob.\n */\nexport const hangedClerkWorld: WorldSpec = {\n  name: \"The yard behind the King's Granary\",\n  description: \"A cobbled yard behind the granary, swept bare for the Assembly, smelling of wet grain, pigeons and river mud. Over the wall the city is hanging bunting.\",\n  size: { w: 52, h: 40 },\n  areas: [\n    { id: \"lane\", name: \"the lane\", rect: { x: 0, y: 0, w: 40, h: 8 }, description: \"The lane beyond the yard wall, with an old elm leaning over it.\", tags: [\"outside\"] },\n    { id: \"yard\", name: \"the yard\", rect: { x: 0, y: 8, w: 38, h: 32 }, description: \"Cobbles, a water butt, the padlocked yard doors and, on the granary's back wall, the hoist.\" },\n    { id: \"loft\", name: \"the tally loft (above the yard, inside the granary)\", rect: { x: 38, y: 8, w: 14, h: 32 }, description: \"Up under the granary roof: the tally desk, grain stacks, Cob's nest. Reached by the loft door (barred inside) or Cob's loose board behind the water butt.\" },\n  ],\n  things: [\n    { id: \"elm\", name: \"the old elm\", kind: \"feature\", in: \"lane\", at: [34, 3], size: \"huge\", material: \"wood\", description: \"Old, dry and leaning over the wall into the yard; pigeons in it.\" },\n    { id: \"yard-wall\", name: \"the yard wall\", kind: \"feature\", in: \"yard\", at: [20, 8], size: \"huge\", material: \"stone\", description: \"Shoulder-high on the lane side.\" },\n    { id: \"gate\", name: \"the yard gate\", kind: \"feature\", in: \"yard\", at: [12, 8], size: \"large\", material: \"wood\", tags: [\"door\"], states: [\"open\"] },\n    { id: \"satchel\", name: \"Prout's satchel\", kind: \"item\", in: \"yard\", at: [14, 10], size: \"small\", material: \"leather\", states: [\"open\", \"empty\"], description: \"Lying open and empty by the gate.\" },\n    { id: \"spectacles\", name: \"Prout's spectacles\", kind: \"item\", in: \"yard\", at: [10, 11], size: \"tiny\", material: \"glass\", states: [\"bent\"], description: \"Bent, in the gutter.\" },\n    { id: \"granary-wall\", name: \"the granary's back wall\", kind: \"feature\", in: \"yard\", at: [37, 24], size: \"gargantuan\", material: \"stone\" },\n    { id: \"hoist-beam\", name: \"the hoist beam\", kind: \"feature\", in: \"yard\", at: [34, 20], size: \"large\", material: \"wood\", description: \"Juts out high above the loft door, with a pulley; the rope runs up over it and in through a slot to a cleat inside.\" },\n    { id: \"hoist-rope\", name: \"the hoist rope\", kind: \"item\", in: \"hoist-beam\", size: \"small\", material: \"rope\", tags: [\"hanging\", \"fixed\"], description: \"Runs over the pulley and in through the slot above the loft door; the noose end holds Prout well out of reach of the cobbles.\" },\n    { id: \"prout\", name: \"Wendell Prout's body\", kind: \"object\", in: \"hoist-rope\", size: \"medium\", material: \"flesh\", tags: [\"body\", \"evidence\"], states: [\"hanging\"], description: \"A small grey-coated clerk with ink-stained fingers, in darned stockings, no boots; a swelling at the back of the skull, a level cord mark under the noose burn, clean palms.\" },\n    { id: \"loft-door\", name: \"the loft door\", kind: \"feature\", in: \"yard\", at: [35, 18], size: \"large\", material: \"wood\", tags: [\"door\"], states: [\"closed\", \"barred\"], description: \"High in the wall under the hoist beam; barred on the inside.\" },\n    { id: \"yard-doors\", name: \"the granary's yard doors\", kind: \"feature\", in: \"yard\", at: [36, 32], size: \"huge\", material: \"wood\", tags: [\"door\"], states: [\"closed\", \"locked\"], description: \"Big double doors, padlocked; the warden has the key, at the palace.\" },\n    { id: \"water-butt\", name: \"the water butt\", kind: \"object\", in: \"yard\", at: [4, 36], size: \"large\", material: \"wood\", tags: [\"container\", \"water\"], states: [\"full\"] },\n    { id: \"loose-board\", name: \"a loose board behind the water butt\", kind: \"feature\", in: \"yard\", at: [2, 38], size: \"small\", material: \"wood\", tags: [\"passage\"], description: \"Cob's way into the loft: child-sized; a grown-up could squeeze through with effort.\" },\n    { id: \"cleat\", name: \"the rope cleat\", kind: \"feature\", in: \"loft\", at: [40, 18], size: \"small\", material: \"iron\", description: \"Inside the loft door: the hoist rope tied off on it with a docker's knot.\" },\n    { id: \"tally-desk\", name: \"the tally desk\", kind: \"object\", in: \"loft\", at: [45, 22], size: \"large\", material: \"wood\", tags: [\"furniture\"], description: \"Ink spilled across it, a smashed lantern beside it, heel scuffs in the grain dust from here to the loft door.\" },\n    { id: \"granary-roll\", name: \"the Royal Granary Roll\", kind: \"item\", in: \"tally-desk\", size: \"small\", material: \"paper\", tags: [\"evidence\"], states: [\"chained\"], description: \"The big book, chained to the desk, with a page razored out. The pages either side list King's Road grain wagons 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor'.\" },\n    { id: \"smashed-lantern\", name: \"a smashed lantern\", kind: \"item\", in: \"loft\", at: [44, 24], size: \"tiny\", material: \"glass\", states: [\"broken\"] },\n    { id: \"cobs-nest\", name: \"a nest of sacking in the loft\", kind: \"object\", in: \"loft\", at: [48, 36], size: \"medium\", material: \"cloth\", description: \"Sacks and candle-ends behind the grain stacks: Cob's castle.\" },\n    { id: \"grain-stacks\", name: \"the grain stacks\", kind: \"object\", in: \"loft\", at: [47, 30], size: \"huge\", material: \"cloth\", tags: [\"cover\"], states: [\"dusty\"] },\n    { id: \"boots\", name: \"Prout's good black boots\", kind: \"item\", in: \"cob\", size: \"small\", material: \"leather\", tags: [\"evidence\"], description: \"Three sizes too big for Cob, laced on with string; the backs of both heels scraped raw, and the left one crackles when he stamps.\" },\n    { id: \"ledger-page\", name: \"a folded page sewn into the left boot's lining\", kind: \"item\", in: \"boots\", size: \"tiny\", material: \"paper\", tags: [\"evidence\", \"hidden\"], description: \"A page razored from the Royal Granary Roll: wagons 'lost to goblins', countersigned 'J. Sallow, for the Royal Purveyor', with Prout's pencilled river-warehouse weights and 'Not goblins. Who pays the hedge-folk?'\" },\n    { id: \"gutter-stones\", name: \"a fistful of gutter stones\", kind: \"item\", in: \"cob\", size: \"tiny\", material: \"stone\" },\n    { id: \"wheat-crown\", name: \"a silver crown stamped with a wheat-ear\", kind: \"item\", in: \"moll\", size: \"tiny\", material: \"silver\", tags: [\"evidence\"], description: \"What the gentleman paid her to say she saw the clerk jump.\" },\n  ],\n  people: {\n    player: { in: \"yard\", at: [14, 12] },\n    kell: { in: \"yard\", at: [16, 13], note: \"just inside the gate, notebook out\" },\n    cob: { in: \"yard\", at: [30, 24], note: \"under the body, lobbing gutter stones at it\" },\n    moll: { in: \"yard\", at: [24, 9], note: \"sitting on top of the yard wall\" },\n  },\n};\n",
      "scenes/worlds/heron-warehouse.ts": "import type { WorldSpec } from \"../../src/world/scene-world.ts\";\n\n/**\n * The Heron warehouse as a world (feet; x runs east from the end of the wharf, y south from the\n * bank), for the heron-warehouse scene. The wharf and the land door with Saul's brazier and Duchess\n * on the west; inside, the long re-sacking floor (dusty: a naked flame in here is a very bad idea),\n * the wheat-ear sacks down the north side and the heron sacks down the south, the counting-box up a\n * short stair in the north-east corner; the river door on the south side, reached by the plank walk\n * on the piles, with the barge Patience alongside. The hoist is worked from the floor just inside the\n * river door (its beam juts out over the barge), so whoever works it, Hobb, is in among the gang.\n *\n * It lines up with the map (src/game/map/maps/heron.ts) at 5 ft to a tile, (0, 0) at tile (2, 1).\n * Attach it to the scene with `world: heronWorld` (scenes/heron-warehouse.ts).\n */\nexport const heronWorld: WorldSpec = {\n  name: \"The Heron warehouse\",\n  description: \"A tall, tarred timber warehouse at the downriver end of the wharves, half on the wharf and half on piles over the river, under a painted heron. Inside, one long floor lit by lanterns and thick with grain dust; outside, the dark, the river and a barge waiting for the ebb.\",\n  size: { w: 105, h: 90 },\n  areas: [\n    { id: \"wharf\", name: \"the wharf outside the land door\", rect: { x: 0, y: 0, w: 30, h: 60 }, description: \"The end of the wharf, where the lamps give out: Saul's sentry box and brazier by the land door, Duchess across the threshold, bollards, and the drop to the river.\", tags: [\"outside\"] },\n    { id: \"floor\", name: \"the re-sacking floor\", rect: { x: 35, y: 10, w: 50, h: 50 }, description: \"One long floor lit by lanterns, the grain dust hanging in the light like fog: the palace's wheat-ear sacks down the north side, heron sacks down the south, the gang slitting, pouring and sewing between them.\", states: [\"dusty\"] },\n    { id: \"counting-box\", name: \"the counting-box (up a short stair, over the floor)\", rect: { x: 70, y: 10, w: 15, h: 15 }, description: \"A glass-sided box hung over the floor in the north-east corner: a high desk, a lamp, and the true book under Mister Scrope's hand.\" },\n    { id: \"plank-walk\", name: \"the plank walk on the piles\", rect: { x: 25, y: 60, w: 45, h: 10 }, description: \"Slippery planks on the piles along the river side, round to the low river door; the river runs fast and black underneath.\", tags: [\"outside\"], states: [\"slick\"] },\n    { id: \"barge\", name: \"the barge Patience\", rect: { x: 35, y: 70, w: 50, h: 15 }, description: \"The Saltmere barge Patience, broad and low, moored alongside under the hoist, hatches open, her bargees waiting for the ebb.\", tags: [\"outside\"] },\n  ],\n  things: [\n    { id: \"land-door\", name: \"the land door\", kind: \"feature\", in: \"wharf\", at: [32, 22], size: \"large\", material: \"wood\", tags: [\"door\"], states: [\"closed\", \"barred\"], description: \"Big double doors with a wicket in one leaf, barred inside on loading nights: only the Master comes in this way, at the midnight bell.\" },\n    { id: \"sentry-box\", name: \"the watchman's sentry box\", in: \"wharf\", at: [17, 12], size: \"large\", material: \"wood\", description: \"A cupboard with ideas above its station, a stool inside and forty years of newspapers.\" },\n    { id: \"saul-brazier\", name: \"the watchman's brazier\", in: \"wharf\", at: [27, 17], size: \"medium\", material: \"iron\", tags: [\"fire\", \"light\"], states: [\"lit\"], description: \"Glowing by the land door, a kettle on it and Duchess's dinner warming beside it.\" },\n    { id: \"duchess\", name: \"Duchess\", kind: \"creature\", in: \"wharf\", at: [27, 22], states: [\"asleep\"], description: \"A vast, elderly brindle mastiff with a face like a collapsed sofa, asleep across the land door's threshold. She snores, drools and has opinions about smells.\" },\n    { id: \"bollard\", name: \"a bollard at the wharf's edge\", kind: \"feature\", in: \"wharf\", at: [22, 42], size: \"small\", material: \"iron\" },\n    { id: \"signboard\", name: \"the Heron's signboard\", kind: \"feature\", in: \"wharf\", at: [32, 12], size: \"medium\", material: \"wood\", description: \"A painted heron on one leg, looking down its beak at the wharf.\" },\n    { id: \"river-door\", name: \"the river door\", kind: \"feature\", in: \"plank-walk\", at: [57, 62], size: \"large\", material: \"wood\", tags: [\"door\"], states: [\"closed\", \"bolted\"], description: \"A low loading door at water level with a grille in it. The gang hold a brass heron token up to the grille, and whoever's nearest inside draws the bolt.\" },\n    { id: \"hoist\", name: \"the hoist\", kind: \"feature\", in: \"floor\", at: [62, 55], size: \"large\", material: \"wood\", description: \"Worked from the floor, just inside the river door: a winch and a creaking rope that runs up and out over a pulley on the beam above the door, swinging sacks out and down into the barge. Whoever's on it is in among the gang, in plain view of the counting-box.\" },\n    { id: \"hoist-rope\", name: \"the hoist rope\", kind: \"item\", in: \"hoist\", size: \"small\", material: \"rope\", tags: [\"fixed\"], description: \"Tarred and creaking, hauled hand over hand from the winch, out over the beam's pulley and down into the barge's hold.\" },\n    { id: \"river\", name: \"the river\", kind: \"feature\", in: \"plank-walk\", at: [97, 72], size: \"gargantuan\", material: \"liquid\", tags: [\"water\"], description: \"High, fast, black and cold under the floor, and the tide on the turn.\" },\n    { id: \"chute\", name: \"the chute\", kind: \"feature\", in: \"floor\", at: [57, 57], size: \"large\", material: \"wood\", description: \"A wooden chute from the floor down through the river door into the barge's hold. Sacks go down it with a noise like a giant swallowing.\" },\n    { id: \"wheat-ear-sacks\", name: \"the palace's wheat-ear sacks\", in: \"floor\", at: [47, 17], size: \"huge\", material: \"cloth\", tags: [\"evidence\", \"cover\"], description: \"Stacked to the beams down the north side, every one stamped with the royal wheat-ear: the King's grain, forty sacks still to go.\" },\n    { id: \"heron-sacks\", name: \"the heron sacks\", in: \"floor\", at: [52, 52], size: \"huge\", material: \"cloth\", tags: [\"cover\"], description: \"New sacks stamped with a heron, sewn shut and stacked down the south side, ready for the chute.\" },\n    { id: \"empty-sacks\", name: \"a heap of empty wheat-ear sacks\", in: \"floor\", at: [77, 47], size: \"large\", material: \"cloth\", tags: [\"evidence\"], description: \"Waiting for the river at the end of the night, a stone in each. Evidence, if anyone wanted it.\" },\n    { id: \"trestles\", name: \"the trestles\", in: \"floor\", at: [57, 32], size: \"large\", material: \"wood\", tags: [\"furniture\", \"cover\"], description: \"Where the gang slit the wheat-ear sacks, pour the grain and sew it up in heron sacks.\" },\n    { id: \"floor-brazier\", name: \"a brazier for cold hands\", in: \"floor\", at: [42, 37], size: \"medium\", material: \"iron\", tags: [\"fire\", \"light\"], states: [\"lit\"], description: \"Burning merrily in the middle of the grain dust.\" },\n    { id: \"no-lights\", name: \"a sign: NO NAKED LIGHTS\", kind: \"feature\", in: \"floor\", at: [37, 32], size: \"medium\", material: \"wood\", tags: [\"sign\"], description: \"Painted in red. Everyone ignores it, and the brazier is right under it.\" },\n    { id: \"lantern-west\", name: \"a lantern hung from the beams\", in: \"floor\", at: [52, 22], size: \"small\", material: \"iron\", tags: [\"light\"], states: [\"lit\", \"hanging\"] },\n    { id: \"lantern-east\", name: \"a lantern hung from the beams\", in: \"floor\", at: [67, 42], size: \"small\", material: \"iron\", tags: [\"light\"], states: [\"lit\", \"hanging\"] },\n    { id: \"gang\", name: \"the re-sacking gang\", kind: \"person\", in: \"floor\", at: [52, 37], description: \"Six porters in grain-white with knives and sack-needles, working fast, heads down, not talking.\" },\n    { id: \"box-stair\", name: \"the short stair to the counting-box\", kind: \"feature\", in: \"floor\", at: [72, 27], size: \"medium\", material: \"wood\" },\n    { id: \"counting-desk\", name: \"the clerk's desk\", in: \"counting-box\", at: [77, 17], size: \"medium\", material: \"wood\", tags: [\"furniture\"], description: \"A high clerk's desk, ink-stained, with a lamp over it.\" },\n    { id: \"true-book\", name: \"the Heron's true book\", kind: \"item\", in: \"counting-desk\", size: \"small\", material: \"leather\", tags: [\"evidence\"], description: \"A fat ledger bound in green calf with a brass clasp, in Scrope's small careful hand: every 'lost' King's Road wagon by its Granary Roll number, re-sacked under the heron and sold downriver, the Master's share, and 'J.S.' on every page.\" },\n    { id: \"heron-pennies\", name: \"a bag of new heron pennies\", kind: \"item\", in: \"counting-desk\", size: \"tiny\", material: \"silver\", tags: [\"evidence\"], description: \"The Master's share for tonight, counted twice.\" },\n    { id: \"counting-lamp\", name: \"the lamp over the desk\", in: \"counting-box\", at: [82, 12], size: \"tiny\", material: \"glass\", tags: [\"light\"], states: [\"lit\"] },\n    { id: \"hatches\", name: \"the Patience's open hatches\", kind: \"feature\", in: \"barge\", at: [52, 77], size: \"large\", material: \"wood\", states: [\"open\"], description: \"Her hold half full of heron sacks.\" },\n    { id: \"bargees\", name: \"the bargees\", kind: \"person\", in: \"barge\", at: [72, 77], description: \"Saltmere bargees in oilskins, pipes lit, waiting for the ebb and very carefully not asking.\" },\n    { id: \"tiller\", name: \"the Patience's tiller\", kind: \"feature\", in: \"barge\", at: [77, 77], size: \"large\", material: \"wood\" },\n  ],\n  people: {\n    player: { in: \"wharf\", at: [7, 27] },\n    kell: { in: \"wharf\", at: [7, 32], note: \"at the player's side on the dark wharf\" },\n    saul: { in: \"wharf\", at: [22, 17], note: \"by his brazier at the land door\" },\n    hep: { in: \"floor\", at: [57, 37], note: \"between the stacks, driving the gang\" },\n    scrope: { in: \"counting-box\", at: [77, 22], note: \"at his desk, his left hand on the true book\" },\n    hobb: { in: \"floor\", at: [62, 57], note: \"on the hoist by the river door, working it one-handed\" },\n    sallow: { in: \"wharf\", at: [17, 27], note: \"at the land door with his lantern-boy and the Crakes\" },\n  },\n};\n"
    },
    "functionSnapshots": {
      "scene.exits.0.script": "(world, outcome) => {\n        world.player.addItem(world.newReadable(trueBookItem));\n        world.setFlag(\"true_book\", \"taken\");\n        world.quest(\"heron-ledger\").complete(\"Came out of the Heron warehouse with its true book.\");\n        world.quest(\"purveyors-man\").advance(\"proof\", \"The Heron's true book, initialled 'J.S.' on every page, ties Master Sallow to the King's 'lost' grain. The case can go to the King.\");\n        world.character(\"kell\").remember(\"The investigator came out of the Heron with the true book: every 'lost' wagon, initialled J.S.\");\n        if (has(outcome.established, MASTER_HERE)) world.character(\"sallow\").remember(\"The King's investigator walked out of the Heron with the true book.\");\n        world.journal(\"We have the Heron's true book. Every page is initialled J.S.\");\n      }",
      "scene.exits.1.script": "(world, outcome) => {\n        const sallow = world.character(\"sallow\");\n        sallow.moveTo(\"watch-house\");\n        sallow.setAttitude(\"hostile\", \"Caught at the Heron with the King's grain by the King's investigator and a sergeant of the watch.\");\n        world.character(\"kell\").remember(\"She arrested Master Josiah Sallow at the Heron warehouse, caught with the King's grain.\");\n        keepBook(world, outcome);\n        bookFlag(world, outcome);\n        world.quest(\"purveyors-man\").advance(\"sallow_arrested\", \"Master Sallow was caught at the Heron warehouse with the King's grain, and Sergeant Kell arrested him.\");\n        world.quest(\"heron-ledger\").complete(\"Caught Master Sallow at the Heron with the King's grain.\");\n        world.journal(\"We caught Sallow at the Heron with the King's grain, and Kell arrested him.\");\n      }",
      "scene.exits.2.script": "(world, outcome) => {\n        const sallow = world.character(\"sallow\");\n        sallow.setAttitude(\"hostile\", \"The King's investigator got into the Heron and saw too much.\");\n        sallow.remember(\"He had the King's investigator thrown out of the Heron the hard way.\");\n        bookFlag(world, outcome, { lostIfCaught: true });\n        world.quest(\"heron-ledger\").advance(\"caught\", \"Caught at the Heron by Master Sallow's men and got rid of the hard way.\");\n        world.journal(\"Caught at the Heron. We're alive, which is something.\");\n      }",
      "scene.exits.3.script": "(world, outcome) => {\n        if (has(outcome.established, FIRE)) {\n          world.place({ asset: world.assets.get(\"smoke-plume\"), at: world.anchor(\"heron-floor\") });\n          world.unsupported(\"The Heron warehouse burned down on the eve of the Assembly, with the King's grain in it.\");\n        }\n        if (has(outcome.established, SUNK)) world.unsupported(\"The Saltmere barge Patience sank at the Heron's wharf with the King's grain in her.\");\n        keepBook(world, outcome);\n        world.setFlag(\"true_book\", bookSaved(outcome) ? \"taken\" : \"burned\");\n        world.character(\"kell\").remember(\"The Heron went up in smoke (or its barge went down) on the eve of the Assembly, with the investigator in the middle of it. She'll have to write it up.\");\n        if (bookSaved(outcome)) world.quest(\"heron-ledger\").advance(\"up_in_smoke\", \"The Heron's grain is gone, but the true book came out with us.\");\n        else world.quest(\"heron-ledger\").fail(\"The Heron's grain and its true book went up in smoke or down in the river.\");\n        world.journal(\"The Heron's night ended in fire and water, and all Caerwyn saw it.\");\n      }",
      "scene.exits.4.script": "(world, outcome) => {\n        keepBook(world, outcome);\n        bookFlag(world, outcome);\n        if (!bookSaved(outcome)) world.quest(\"heron-ledger\").fail(\"The Patience sailed with the King's grain before we could stop her.\");\n        world.journal(\"The Patience sailed on the ebb with the King's grain aboard.\");\n      }",
      "scene.exits.5.script": "(world, outcome) => {\n        world.startCombat({\n          enemies: has(outcome.established, MASTER_HERE)\n            ? [{ asset: world.assets.get(\"bandit\"), count: 2, leader: \"sallow\" }]\n            : [{ asset: world.assets.get(\"bandit\"), count: 6, leader: \"hep\" }],\n          allies: [\"kell\"],\n          at: world.anchor(\"heron-floor\"),\n        });\n      }"
    },
    "loreResolution": {
      "scene": [
        "Places/Heron Warehouse.md",
        "World/Caerwyn now.md"
      ],
      "fronts": "World/Fronts.md",
      "cast": {
