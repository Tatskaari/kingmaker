        "phase": "attempt",
        "skill": "animal_handling",
        "dc": 12,
        "scope": "beat",
        "branch": "success",
        "outcomeText": "Duchess decides they're the best thing that's happened to her all night and leans her whole weight on them. Saul, who trusts her nose over his own eyes, unbends: anyone she likes can't be all bad, and all's well.",
        "sourceRoute": {
          "id": "win-duchess",
