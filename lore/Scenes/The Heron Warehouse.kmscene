        "saul": "Cast/Saul Tench/public.md",
        "hep": "Cast/Hepzibah Grist/public.md",
        "scrope": "Cast/Mister Lemuel Scrope/public.md",
        "hobb": "Cast/Big Hobb Mallory/public.md",
        "sallow": "Cast/Master Josiah Sallow/public.md"
      }
    },
    "unresolvedLore": [],
    "unresolvedDestinations": [],
