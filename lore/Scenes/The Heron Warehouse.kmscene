    {
      "id": "route:[\"beat\",\"wharf\",\"talk-past\",4,\"success\"]",
      "source": "wharf",
      "target": "floor",
      "type": "smoothstep",
      "label": "Talk past · success",
      "data": {
        "condition": "With no heron token to show, the player tries to bluff their way in past Saul or whoever answers the river door with a story that isn't true: the Saltmere factor's man, someone sent by the Master, a hand that somebody sent for when nobody did. (Showing Hobb's token at the grille, and going in to work with a sack on their shoulder or at Hep's shout for hands, are ways in of their own with no dice, whatever story goes with them: they aren't this.)",
        "phase": "attempt",
        "skill": "deception",
        "dc": 13,
        "scope": "beat",
        "branch": "success",
        "outcomeText": "Whoever's at the door believes it and stands aside. They're in, and expected to behave like whoever they said they were.",
        "sourceRoute": {
          "id": "talk-past",
          "on": "attempt",
          "when": "With no heron token to show, the player tries to bluff their way in past Saul or whoever answers the river door with a story that isn't true: the Saltmere factor's man, someone sent by the Master, a hand that somebody sent for when nobody did. (Showing Hobb's token at the grille, and going in to work with a sack on their shoulder or at Hep's shout for hands, are ways in of their own with no dice, whatever story goes with them: they aren't this.)",
          "check": {
            "reason": "to talk your way into the Heron",
            "skill": "deception",
            "dc": 13,
            "success": "Whoever's at the door believes it and stands aside. They're in, and expected to behave like whoever they said they were.",
            "failure": "It doesn't wash. The door stays shut, and whoever was at it is now watching the wharf for them; the next way in will have to be a different one.",
            "onSuccess": "floor"
          }
        },
        "establishes": [],
        "checkReason": "to talk your way into the Heron"
      }
    },
