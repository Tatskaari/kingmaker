    {
      "id": "route:[\"beat\",\"the-rat\",\"nan-vouches\",10,\"success\"]",
      "source": "the-rat",
      "target": "the-rat",
      "type": "smoothstep",
      "label": "Nan vouches · success",
      "data": {
        "condition": "The player asks Nan to tell Cob to show them what's in his boot (or to vouch for them to the boy), giving her a reason, where it could go either way. Paying her for it isn't this. (A reason plainly good for the boy, his name kept out of it and the big man's sort kept off him, needs no dice.)",
        "phase": "attempt",
        "skill": "persuasion",
        "dc": 12,
        "scope": "beat",
        "branch": "success",
        "outcomeText": "Nan looks at the player for a long moment, then wipes her hands and calls through to the scullery: 'Cob. Here, my duck. Show them your boot.' And because it's Nan, he does, sulking: the left one off, the lining picked open, a folded page held out at arm's length. 'That's Mister Prout's.'",
        "sourceRoute": {
          "id": "nan-vouches",
          "on": "attempt",
          "essential": "prouts-page",
          "when": "The player asks Nan to tell Cob to show them what's in his boot (or to vouch for them to the boy), giving her a reason, where it could go either way. Paying her for it isn't this. (A reason plainly good for the boy, his name kept out of it and the big man's sort kept off him, needs no dice.)",
          "check": {
            "reason": "to get Nan to tell Cob to show you his boot",
            "skill": "persuasion",
            "dc": 12,
            "success": "Nan looks at the player for a long moment, then wipes her hands and calls through to the scullery: 'Cob. Here, my duck. Show them your boot.' And because it's Nan, he does, sulking: the left one off, the lining picked open, a folded page held out at arm's length. 'That's Mister Prout's.'",
            "failure": "Nan says the boy's boots are the boy's business, and that's a rule of the house now if it wasn't before. She keeps Cob by her behind the bar the rest of the night, and an eye on the player. The boy himself might still be won, if he's given real reason.",
            "onSuccess": "the-rat"
          }
        },
        "establishes": [],
        "checkReason": "to get Nan to tell Cob to show you his boot",
        "essential": "prouts-page"
      }
    },
