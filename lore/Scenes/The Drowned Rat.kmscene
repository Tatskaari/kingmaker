            {
              "id": "bell",
              "on": "cue",
              "when": "The player has been in the Rat a long while (at least eight exchanges at this point) without getting anywhere with Hobb, or is idling or going round in circles: the eleventh bell rings across the water, and Hobb gets up to go to work.",
              "to": "on-his-feet"
            }
