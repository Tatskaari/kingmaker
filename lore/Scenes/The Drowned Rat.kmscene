    {
      "id": "route:[\"beat\",\"confession\",\"trust-cob\",11,\"direct\"]",
      "source": "confession",
      "target": "confession",
      "type": "smoothstep",
      "label": "Trust cob",
      "data": {
        "condition": "Out of the big cove's sight (in the scullery, or anywhere the fireside can't see), the player asks Cob for a look after giving him real reason to trust them (a kindness with nothing asked back, like his dinner stood him with no strings), or makes him a promise, now or before, that truly answers what he's afraid of (his name kept out of it, the big cove put away where he can't come back for him, the boots his to keep, whatever's in the boot going to the King and not the watch), or he has already told them they can look; or Nan, given a reason plainly good for the boy, tells him to. No dice, however it's put: Cob takes the left boot off and lets them unpick the lining: Prout's page is out.",
        "phase": "outcome",
        "skill": "",
        "dc": 0,
        "scope": "beat",
        "branch": "direct",
        "outcomeText": "",
        "sourceRoute": {
          "id": "trust-cob",
          "essential": "prouts-page",
          "when": "Out of the big cove's sight (in the scullery, or anywhere the fireside can't see), the player asks Cob for a look after giving him real reason to trust them (a kindness with nothing asked back, like his dinner stood him with no strings), or makes him a promise, now or before, that truly answers what he's afraid of (his name kept out of it, the big cove put away where he can't come back for him, the boots his to keep, whatever's in the boot going to the King and not the watch), or he has already told them they can look; or Nan, given a reason plainly good for the boy, tells him to. No dice, however it's put: Cob takes the left boot off and lets them unpick the lining: Prout's page is out.",
          "to": "confession",
          "establishes": [
            "Prout's page is out of the lining of Cob's left boot: razored from the Royal Granary Roll, a dozen King's Road grain wagons marked 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor', with Prout's pencilled river-warehouse weights and, at the foot, 'Not goblins. Who pays the hedge-folk?'"
          ]
        },
        "establishes": [
          "Prout's page is out of the lining of Cob's left boot: razored from the Royal Granary Roll, a dozen King's Road grain wagons marked 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor', with Prout's pencilled river-warehouse weights and, at the foot, 'Not goblins. Who pays the hedge-folk?'"
        ],
        "essential": "prouts-page"
      }
    },
    {
      "id": "route:[\"beat\",\"confession\",\"coax-cob\",12,\"success\"]",
      "source": "confession",
      "target": "confession",
      "type": "smoothstep",
      "label": "Coax cob · success",
      "data": {
        "condition": "Out of the big cove's sight (in the scullery, or anywhere the fireside can't see), before Cob has any reason to trust them (no kindness with nothing asked back done him yet tonight, no promise that answers what he's afraid of, no yes from him already), the player asks Cob to show them what crackles in his left boot (taking it off, or letting them unpick the lining), politely and with the boots staying his, or tries to win him round to it by reaching him (an appeal to what he cares about: Mister Prout, the men from the loft, his own skin; or a tale he might swallow), where it could go either way. Paying for a look isn't this. (After a kindness with nothing asked back, for someone he really trusts, for a promise that truly answers what he's afraid of, or once he's said they can look, it needs no dice. Out in the room, under the big cove's eye, he won't, and says so his way: not out here.)",
        "phase": "attempt",
        "skill": "persuasion",
        "dc": 13,
        "scope": "beat",
        "branch": "success",
        "outcomeText": "Cob looks past them at the scullery door, and the fire beyond it, for a long moment. Then he sits on an upturned pot, unlaces the left boot and picks the lining open with a dirty thumbnail, muttering that if this is a trick Cob'll know. Out comes a page, folded small and gone soft at the corners, and he holds it out like it might bite: 'That's Mister Prout's writing. That's why it crackled.' He can't read it; anyone who can sees a dozen grain wagons 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor'. If he heard the posh cove ask for 'the page' that night, it comes together for him now, and he goes white.",
        "sourceRoute": {
          "id": "coax-cob",
          "on": "attempt",
          "essential": "prouts-page",
          "when": "Out of the big cove's sight (in the scullery, or anywhere the fireside can't see), before Cob has any reason to trust them (no kindness with nothing asked back done him yet tonight, no promise that answers what he's afraid of, no yes from him already), the player asks Cob to show them what crackles in his left boot (taking it off, or letting them unpick the lining), politely and with the boots staying his, or tries to win him round to it by reaching him (an appeal to what he cares about: Mister Prout, the men from the loft, his own skin; or a tale he might swallow), where it could go either way. Paying for a look isn't this. (After a kindness with nothing asked back, for someone he really trusts, for a promise that truly answers what he's afraid of, or once he's said they can look, it needs no dice. Out in the room, under the big cove's eye, he won't, and says so his way: not out here.)",
          "check": {
            "reason": "to get Cob to show you what's in his boot",
            "skill": "persuasion",
            "dc": 13,
            "success": "Cob looks past them at the scullery door, and the fire beyond it, for a long moment. Then he sits on an upturned pot, unlaces the left boot and picks the lining open with a dirty thumbnail, muttering that if this is a trick Cob'll know. Out comes a page, folded small and gone soft at the corners, and he holds it out like it might bite: 'That's Mister Prout's writing. That's why it crackled.' He can't read it; anyone who can sees a dozen grain wagons 'lost to goblins', each countersigned 'J. Sallow, for the Royal Purveyor'. If he heard the posh cove ask for 'the page' that night, it comes together for him now, and he goes white.",
            "failure": "Cob won't, and it costs, whichever fits where and how they tried: in the scullery, he's out through the slop hatch Nan told him never to use and down onto the wet steps under it, and her face says whose fault that is; or he yells for Mrs Q, and Nan comes round the bar to ask what the player wants with her pot-boy's boots; or, out in the room, his yelp turns heads, and in the fireside corner Hobb looks up and sees who's bothering the boy. The boot isn't lost: Cob comes back for his stew, warier, and real trust or Nan's word can still open it.",
            "onSuccess": "confession"
          }
        },
        "establishes": [],
        "checkReason": "to get Cob to show you what's in his boot",
        "essential": "prouts-page"
      }
    },
