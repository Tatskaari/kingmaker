    {
      "id": "route:[\"beat\",\"the-rat\",\"arm-wrestle\",5,\"success\"]",
      "source": "the-rat",
      "target": "the-rat",
      "type": "smoothstep",
      "label": "Arm wrestle · success",
      "data": {
        "condition": "The player arm-wrestles someone in the Rat (Arlo for the champion's chair, a regular for a wager, or Hobb if he can be got to the table), elbows down and Nan refereeing, where it could go either way.",
        "phase": "attempt",
        "skill": "athletics",
        "dc": 14,
        "scope": "beat",
        "branch": "success",
        "outcomeText": "Their opponent's knuckles hit the table. The Rat roars, Nan pays out the wagers, and the regulars stop clamming up around whoever just did that. If it was Hobb, the rag tore loose as his arm went over: his right palm is skinned raw in a stripe straight across, like a rope burn, and he hides it at once.",
        "sourceRoute": {
          "id": "arm-wrestle",
          "on": "attempt",
          "when": "The player arm-wrestles someone in the Rat (Arlo for the champion's chair, a regular for a wager, or Hobb if he can be got to the table), elbows down and Nan refereeing, where it could go either way.",
          "check": {
            "reason": "to win an arm-wrestle in front of the whole Rat",
            "skill": "athletics",
            "dc": 14,
            "success": "Their opponent's knuckles hit the table. The Rat roars, Nan pays out the wagers, and the regulars stop clamming up around whoever just did that. If it was Hobb, the rag tore loose as his arm went over: his right palm is skinned raw in a stripe straight across, like a rope burn, and he hides it at once.",
            "failure": "Their own knuckles hit the table, and the Rat roars anyway. Their arm will ache till morning, whoever beat them is unbearable about it, and the room has a new story about the sergeant's friend. If it was Hobb, he won through his teeth with the bad hand, and the rag came loose: his palm is skinned raw in a stripe straight across, like a rope burn, and he hides it at once.",
            "onSuccess": "the-rat"
          }
        },
        "establishes": [],
        "checkReason": "to win an arm-wrestle in front of the whole Rat"
      }
    },
