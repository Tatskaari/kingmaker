    {
      "id": "route:[\"beat\",\"confession\",\"bribe-cob\",9,\"direct\"]",
      "source": "confession",
      "target": "confession",
      "type": "smoothstep",
      "label": "Bribe cob",
      "data": {
        "condition": "The player offers coin, or more stew, as the price of a look in Cob's boot (to Cob, or to Nan for him), and nothing more (no appeal to what he's afraid of, no promise that answers it): Cob haggles, boasts and takes what's going, but the boot stays on, and Nan won't sell a look in a child's boot either. Bought attention isn't trust. What's really wrong comes out instead, his way: not out here, not with the big cove looking, and what happens to Cob after? (A meal stood him with nothing asked back is a kindness, not this.)",
        "phase": "outcome",
        "skill": "",
        "dc": 0,
        "scope": "beat",
        "branch": "direct",
        "outcomeText": "",
        "sourceRoute": {
          "id": "bribe-cob",
          "towards": "prouts-page",
          "when": "The player offers coin, or more stew, as the price of a look in Cob's boot (to Cob, or to Nan for him), and nothing more (no appeal to what he's afraid of, no promise that answers it): Cob haggles, boasts and takes what's going, but the boot stays on, and Nan won't sell a look in a child's boot either. Bought attention isn't trust. What's really wrong comes out instead, his way: not out here, not with the big cove looking, and what happens to Cob after? (A meal stood him with nothing asked back is a kindness, not this.)",
          "to": "confession"
        },
        "establishes": [],
        "towards": "prouts-page"
      }
    },
