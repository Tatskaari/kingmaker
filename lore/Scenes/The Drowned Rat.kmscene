        "scope": "beat",
        "branch": "failure",
        "outcomeText": "Their own knuckles hit the table, and the Rat roars anyway. Their arm will ache till morning, whoever beat them is unbearable about it, and the room has a new story about the sergeant's friend. If it was Hobb, he won through his teeth with the bad hand, and the rag came loose: his palm is skinned raw in a stripe straight across, like a rope burn, and he hides it at once.",
        "sourceRoute": {
          "id": "arm-wrestle",
          "on": "attempt",
          "when": "The player arm-wrestles someone in the Rat (Arlo for the champion's chair, a regular for a wager, or Hobb if he can be got to the table), elbows down and Nan refereeing, where it could go either way.",
          "check": {
            "reason": "to win an arm-wrestle in front of the whole Rat",
            "skill": "athletics",
            "dc": 14,
            "success": "Their opponent's knuckles hit the table. The Rat roars, Nan pays out the wagers, and the regulars stop clamming up around whoever just did that. If it was Hobb, the rag tore loose as his arm went over: his right palm is skinned raw in a stripe straight across, like a rope burn, and he hides it at once.",
            "failure": "Their own knuckles hit the table, and the Rat roars anyway. Their arm will ache till morning, whoever beat them is unbearable about it, and the room has a new story about the sergeant's friend. If it was Hobb, he won through his teeth with the bad hand, and the rag came loose: his palm is skinned raw in a stripe straight across, like a rope burn, and he hides it at once.",
            "onSuccess": "the-rat"
          }
        },
        "establishes": [],
        "checkReason": "to win an arm-wrestle in front of the whole Rat",
        "staysInCurrentBeat": true
      }
    },
    {
      "id": "route:[\"beat\",\"the-rat\",\"bribe-cob\",6,\"direct\"]",
      "source": "the-rat",
      "target": "the-rat",
      "type": "smoothstep",
      "label": "Bribe cob",
      "data": {
        "condition": "The player offers coin, or more stew, as the price of a look in Cob's boot (to Cob, or to Nan for him), and nothing more (no appeal to what he's afraid of, no promise that answers it): Cob haggles, boasts and takes what's going, but the boot stays on, and Nan won't sell a look in a child's boot either. Bought attention isn't trust. What's really wrong comes out instead, his way: not out here, not with the big cove looking, and what happens to Cob after? (A meal stood him with nothing asked back is a kindness, not this.)",
        "phase": "outcome",
        "skill": "",
        "dc": 0,
        "scope": "beat",
        "branch": "direct",
        "outcomeText": "",
        "sourceRoute": {
          "id": "bribe-cob",
          "towards": "prouts-page",
          "when": "The player offers coin, or more stew, as the price of a look in Cob's boot (to Cob, or to Nan for him), and nothing more (no appeal to what he's afraid of, no promise that answers it): Cob haggles, boasts and takes what's going, but the boot stays on, and Nan won't sell a look in a child's boot either. Bought attention isn't trust. What's really wrong comes out instead, his way: not out here, not with the big cove looking, and what happens to Cob after? (A meal stood him with nothing asked back is a kindness, not this.)",
          "to": "the-rat"
        },
        "establishes": [],
        "towards": "prouts-page"
      }
    },
    {
      "id": "route:[\"beat\",\"the-rat\",\"kind-to-cob\",7,\"direct\"]",
      "source": "the-rat",
      "target": "the-rat",
      "type": "smoothstep",
      "label": "Kind to cob",
      "data": {
        "condition": "The player does Cob a kindness with nothing asked back: stands him his dinner or an extra bowl with no strings, or gives it freely after he's eaten. He takes it with bad grace and a boast, and it counts with him: after it, a polite ask for a look in his boot, out of the big cove's sight, gets a yes.",
        "phase": "outcome",
