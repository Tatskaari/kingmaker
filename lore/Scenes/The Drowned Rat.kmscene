              ]
            },
            {
              "id": "bell",
              "on": "cue",
              "when": "The player has been at Hobb a good while (at least six exchanges at this point) without him breaking, or is going round in circles: the eleventh bell rings across the water, and Hobb gets up to go to work.",
              "to": "on-his-feet"
