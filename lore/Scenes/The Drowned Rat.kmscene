      "fronts": "World/Fronts.md",
      "assumes": [
        "Big Hobb Mallory, the big man with the bandaged hand, is still at large and hasn't told the player what he knows (he hasn't been caught, arrested or questioned yet). The player knowing who his master is doesn't change that."
      ],
      "world": {
        "name": "The Drowned Rat",
        "description": "A dockside dive dug into the bank halfway down the river stairs: one long, low, smoky room under a ceiling hung with eel traps and old oars, a scullery at the back, and a single door onto the stairs.",
        "size": {
          "w": 48,
          "h": 40
        },
        "areas": [
          {
            "id": "stairs",
            "name": "the river stairs outside",
            "rect": {
              "x": 0,
              "y": 0,
              "w": 48,
              "h": 10
            },
            "description": "Wet green steps down to the river, the bunting on the quay above, the river slapping at the bottom.",
            "tags": [
              "outside"
            ]
          },
          {
            "id": "doorway",
            "name": "the doorway",
            "rect": {
              "x": 0,
              "y": 10,
              "w": 12,
              "h": 12
            },
            "description": "Three steps down from the landing; the rules board on the wall."
          },
          {
            "id": "bar",
            "name": "the bar",
            "rect": {
              "x": 12,
              "y": 10,
              "w": 20,
              "h": 10
            },
            "description": "The upturned hull of a skiff, and Nan's shelf behind it."
          },
          {
