/*
 * The module's own: SpacetimeDB requires target/lib/module/isolatedModules as `spacetime init
 * --lang typescript` writes them. It bundles shared/ too, so shared/ must typecheck here (ES2021, no
 * Node: "types" is empty, so Node's globals don't). The tests and the memory host run under Node and
 * are checked by v2/tsconfig.json instead.
 */
{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": [],
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "../shared"],
  "exclude": ["**/*.test.ts", "../shared/**/*.test.ts", "src/host/**"]
}
