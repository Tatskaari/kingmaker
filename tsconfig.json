/*
 * Everything that runs under Node or in the browser: the client, the hosts, the AI service, the
 * shared code, the browser platform (web/) and the simulation's tests (with the memory host they
 * load). Bundler resolution, since the spacetimedb package's types need it (nodenext loses its
 * re-exports). The module itself is checked again by simulation/tsconfig.json, under the module's
 * own lib (ES2021, no Node).
 */
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react"
  },
  "include": ["client", "shared", "ai", "hosts", "web", "simulation/**/*.test.ts"]
}
