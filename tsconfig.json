{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react"
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "evals/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "apps/**/*.tsx"
  ]
}
